---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Accessibility & WCAG Compliance — CC3PO" description="WCAG 2.1/2.2 AA accessibility audits, Section 508 compliance, AB 434 certification support, VPAT preparation. Find barriers before regulators do.">

  <nav class="nav" id="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <img src="/images/cc3po-crypto-enhanced.png" alt="CC3PO" class="nav-logo-img nav-logo-full">
        <img src="/images/cc3po-crypto-56px.png" alt="CC3PO" class="nav-logo-img nav-logo-icon" width="56" height="56" loading="eager">
        <span>CC3PO</span>
      </a>
      <ul class="nav-links">
        <li><a href="/services">Services</a></li>
        <li><a href="/government">Government</a></li>
        <li><a href="/accessibility" class="active">Accessibility</a></li>
        <li><a href="/ai-compliance">AI Compliance</a></li>
        <li><a href="/certifications">Certifications</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <a href="/contact" class="nav-cta">Request Audit</a>
      <button class="mobile-toggle" aria-label="Menu" aria-expanded="false" id="mobile-menu-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero" id="main-content" style="padding-top:140px;padding-bottom:80px;min-height:60vh;">
    <div class="container" style="max-width:900px;">
      <div class="hero-badge reveal"><span class="pulse-dot"></span>WCAG 2.1/2.2 AA</div>
      <h1 class="hero-title reveal" style="font-size:var(--text-5xl);">Find Your Highest-Risk<br><span style="background:linear-gradient(135deg,#e94560,#4fc3f7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Accessibility Barriers</span></h1>
      <p class="hero-sub reveal" style="max-width:600px;margin:0 auto;">Before regulators do. Manual WCAG 2.1/2.2 AA audit with assistive tech testing, prioritized findings, and remediation guidance.</p>
      <div class="hero-buttons reveal" style="margin-top:32px;">
        <a href="/contact" class="btn btn-primary btn-glow"><span class="btn-icon">🔍</span> Request an Audit</a>
        <a href="/accessibility-statement" class="btn btn-secondary"><span class="btn-icon">📄</span> Our Accessibility Statement</a>
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="section" style="padding-top:0;">
    <div class="container" style="max-width:1000px;">
      <div class="section-header reveal">
        <div class="section-label">Who This Is For</div>
        <h2 class="section-title">Four Audiences, One Standard</h2>
      </div>
      <div class="proof-grid reveal" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;">
        <div class="proof-card" style="text-align:center;border-top:3px solid #0f3460;">
          <div style="font-size:32px;margin-bottom:12px;">🏛️</div>
          <h3 style="color:var(--text-primary);font-size:16px;margin-bottom:6px;">Government Agencies</h3>
          <p style="color:var(--text-muted);font-size:13px;">AB 434 certification support. Section 508 compliance. DOJ ADA Title II deadline 2026.</p>
        </div>
        <div class="proof-card" style="text-align:center;border-top:3px solid #e94560;">
          <div style="font-size:32px;margin-bottom:12px;">🏥</div>
          <h3 style="color:var(--text-primary);font-size:16px;margin-bottom:6px;">Healthcare Organizations</h3>
          <p style="color:var(--text-muted);font-size:13px;">Patient portal accessibility. HIPAA-compliant remediation. Unruh Act risk reduction.</p>
        </div>
        <div class="proof-card" style="text-align:center;border-top:3px solid #00e676;">
          <div style="font-size:32px;margin-bottom:12px;">🏪</div>
          <h3 style="color:var(--text-primary);font-size:16px;margin-bottom:6px;">Small Businesses</h3>
          <p style="color:var(--text-muted);font-size:13px;">ADA compliance for public-facing sites. Avoid demand letters and litigation. Affordable entry point.</p>
        </div>
        <div class="proof-card" style="text-align:center;border-top:3px solid #4fc3f7;">
          <div style="font-size:32px;margin-bottom:12px;">💻</div>
          <h3 style="color:var(--text-primary);font-size:16px;margin-bottom:6px;">SaaS Companies</h3>
          <p style="color:var(--text-muted);font-size:13px;">VPAT/ACR preparation. Enterprise customer compliance requirements. Ongoing monitoring.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- RISK FRAMING -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container" style="max-width:800px;">
      <div class="section-header reveal">
        <div class="section-label">The Risk Is Real</div>
        <h2 class="section-title">Regulatory Deadlines Are Here</h2>
      </div>
      <div class="reveal" style="display:grid;gap:16px;">
        <div style="background:var(--bg-card);border-radius:var(--radius);padding:20px;border-left:3px solid #e94560;">
          <h3 style="color:#e94560;font-size:16px;margin-bottom:6px;">DOJ ADA Title II Rule — 2026</h3>
          <p style="color:var(--text-muted);font-size:14px;">State and local government websites must meet WCAG 2.1 AA by 2026. Non-compliance = ADA liability.</p>
        </div>
        <div style="background:var(--bg-card);border-radius:var(--radius);padding:20px;border-left:3px solid #0f3460;">
          <h3 style="color:#4fc3f7;font-size:16px;margin-bottom:6px;">CA AB 434 — Signed Homepage Certification</h3>
          <p style="color:var(--text-muted);font-size:14px;">State agency directors must certify website accessibility. We provide the audit evidence to support that certification.</p>
        </div>
        <div style="background:var(--bg-card);border-radius:var(--radius);padding:20px;border-left:3px solid #ffd700;">
          <h3 style="color:#ffd700;font-size:16px;margin-bottom:6px;">Unruh Civil Rights Act + ADA</h3>
          <p style="color:var(--text-muted);font-size:14px;">Non-compliance triggers Unruh liability for California businesses. $4,000+ per violation. Demand letters are increasing.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- METHODOLOGY -->
  <section class="section">
    <div class="container" style="max-width:900px;">
      <div class="section-header reveal">
        <div class="section-label">Our Methodology</div>
        <h2 class="section-title">4-Step Audit Process</h2>
      </div>
      <div class="workflow-steps">
        <div class="workflow-step reveal">
          <div class="step-connector"></div>
          <div class="step-number">01</div>
          <div class="step-content">
            <div class="step-icon">🔍</div>
            <h3>Discover</h3>
            <p>Automated scanning + manual review. Keyboard testing, screen reader testing, visual inspection across browsers and devices.</p>
          </div>
        </div>
        <div class="workflow-step reveal">
          <div class="step-connector"></div>
          <div class="step-number">02</div>
          <div class="step-content">
            <div class="step-icon">📊</div>
            <h3>Assess</h3>
            <p>Map each finding to specific WCAG 2.1/2.2 AA criteria. ADA, Section 508, and EN 301 549 alignment.</p>
          </div>
        </div>
        <div class="workflow-step reveal">
          <div class="step-connector"></div>
          <div class="step-number">03</div>
          <div class="step-content">
            <div class="step-icon">⚡</div>
            <h3>Prioritize</h3>
            <p>Severity × business impact matrix. Know what to fix first. High-risk items flagged for immediate action.</p>
          </div>
        </div>
        <div class="workflow-step reveal">
          <div class="step-connector"></div>
          <div class="step-number">04</div>
          <div class="step-content">
            <div class="step-icon">🗺️</div>
            <h3>Roadmap</h3>
            <p>Detailed remediation guidance with code examples. Timeline estimates. Optional re-test and validation after fixes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DELIVERABLES -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container" style="max-width:900px;">
      <div class="section-header reveal">
        <div class="section-label">What You Get</div>
        <h2 class="section-title">Audit Deliverables</h2>
      </div>
      <div class="proof-grid reveal" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;">
        <div class="proof-card" style="text-align:center;">
          <div style="font-size:24px;margin-bottom:8px;">📋</div>
          <h3 style="color:var(--text-primary);font-size:15px;">Executive Summary</h3>
          <p style="color:var(--text-muted);font-size:13px;">Plain-language overview for leadership.</p>
        </div>
        <div class="proof-card" style="text-align:center;">
          <div style="font-size:24px;margin-bottom:8px;">📑</div>
          <h3 style="color:var(--text-primary);font-size:15px;">Findings Log</h3>
          <p style="color:var(--text-muted);font-size:13px;">By page, component, and user flow.</p>
        </div>
        <div class="proof-card" style="text-align:center;">
          <div style="font-size:24px;margin-bottom:8px;">🔗</div>
          <h3 style="color:var(--text-primary);font-size:15px;">WCAG Criterion Mapping</h3>
          <p style="color:var(--text-muted);font-size:13px;">Each finding tied to specific success criteria.</p>
        </div>
        <div class="proof-card" style="text-align:center;">
          <div style="font-size:24px;margin-bottom:8px;">🔴</div>
          <h3 style="color:var(--text-primary);font-size:15px;">Severity + Priority</h3>
          <p style="color:var(--text-muted);font-size:13px;">Business impact × technical severity matrix.</p>
        </div>
        <div class="proof-card" style="text-align:center;">
          <div style="font-size:24px;margin-bottom:8px;">📸</div>
          <h3 style="color:var(--text-primary);font-size:15px;">Screenshots & Evidence</h3>
          <p style="color:var(--text-muted);font-size:13px;">Visual proof of every finding.</p>
        </div>
        <div class="proof-card" style="text-align:center;">
          <div style="font-size:24px;margin-bottom:8px;">📄</div>
          <h3 style="color:var(--text-primary);font-size:15px;">VPAT / ACR Support</h3>
          <p style="color:var(--text-muted);font-size:13px;">Add-on: $350–$950 per product.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" id="cta">
    <div class="container" style="max-width:700px;text-align:center;">
      <div class="section-header reveal">
        <h2 class="section-title">Don't Wait for a Demand Letter</h2>
        <p class="section-desc">Find and fix accessibility barriers proactively.</p>
      </div>
      <div class="hero-buttons reveal">
        <a href="/contact" class="btn btn-primary btn-glow"><span class="btn-icon">🔍</span> Request an Accessibility Audit</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div style="font-size:17px;font-weight:800;margin-bottom:8px;">CC3PO</div>
          <p>AI Agents That Work Within Your Rules.</p>
          <div style="margin-top:16px;font-size:0.75rem;color:rgba(255,255,255,0.35);">
            <strong style="color:rgba(255,255,255,0.5);">Certifications:</strong> CA Small Business SB #2052063 · Latino-Owned · SB/DVBE Option
          </div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Services</div>
          <div class="footer-col-links">
            <a href="/services">All Services</a>
            <a href="/accessibility">Accessibility</a>
            <a href="/government">Government</a>
            <a href="/ai-compliance">AI Compliance</a>
          </div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Company</div>
          <div class="footer-col-links">
            <a href="/#founder">About</a>
            <a href="/certifications">Certifications</a>
            <a href="/village">The Village</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Legal</div>
          <div class="footer-col-links">
            <a href="/accessibility-statement">Accessibility Statement</a>
            <a href="/privacy/">Privacy Policy</a>
            <a href="/terms/">Terms of Service</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-copy">© 2026 CC3PO LLC. All rights reserved.</div>
        <div class="footer-legal">
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/accessibility-statement">Accessibility</a>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline>
    const nav = document.getElementById('nav');
    let t=false;
    window.addEventListener('scroll',()=>{if(!t){requestAnimationFrame(()=>{nav.classList.toggle('nav-scrolled',window.scrollY>50);t=false});t=true}});
    const ro=new IntersectionObserver((e)=>{e.forEach(en=>{if(en.isIntersecting){en.target.classList.add('revealed');ro.unobserve(en.target)}})},{threshold:0.15});
    document.querySelectorAll('.reveal').forEach(el=>ro.observe(el));
  // Mobile drawer handled by Layout.astro
  </script>
</Layout>