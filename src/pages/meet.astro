---
// Redirect to Zoom meeting for scheduling
const ZOOM_URL = "https://zoom.us/j/2098045223";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Book a Meeting — CC3PO</title>
  <meta http-equiv="refresh" content="0;url=https://scheduler.zoom.us/carlos-cabrales-iii/compliance-consultation" />
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      background: #0f172a;
      color: #e2e8f0;
    }
    .card {
      text-align: center;
      padding: 3rem;
      max-width: 500px;
    }
    h1 { font-size: 1.5rem; margin-bottom: 1rem; }
    p { color: #94a3b8; margin-bottom: 2rem; }
    .btn {
      display: inline-block;
      background: #3b82f6;
      color: white;
      padding: 0.75rem 2rem;
      border-radius: 0.5rem;
      text-decoration: none;
      font-weight: 600;
    }
    .btn:hover { background: #2563eb; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Book a Meeting with Carlos</h1>
    <p>You're being redirected to Zoom. Click below if you're not redirected automatically.</p>
    <a class="btn" href="https://scheduler.zoom.us/carlos-cabrales-iii/compliance-consultation">Book a Time</a>
  </div>
</body>
</html>
