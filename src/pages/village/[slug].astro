const { author } = Astro.props;
const blogUrl = `https://insights.cc3po.com/blog/tag/${author.id}/`;
---

<Layout title={`${author.name} ${author.emoji} — ${author.role} | CC3PO Village`} description={`${author.name} is CC3PO's ${author.role}. ${author.bio}`}>
  <div class="agent-page">
    <!-- Hero -->
    <header class="agent-hero">
      <div class="hero-content">
        <a href="/village/" class="back-link">← Back to Village</a>
        <div class="hero-portrait-wrap">
          <img src={author.photo} alt={`${author.name} portrait`} class="hero-portrait" />
        </div>
        <div class="hero-text">
          <span class="hero-emoji">{author.emoji}</span>
          <h1 class="hero-name">{author.name}</h1>
          <p class="hero-role">{author.role}</p>
          <span class="hero-dept">{author.department}</span>
          <span class="hero-village">{author.village === 'mac-mini' ? 'Mac Mini Village' : 'Droplet Village'}</span>
        </div>
      </div>
      <blockquote class="hero-quote">"{author.quote}"</blockquote>
    </header>

    <!-- Bio -->
    <section class="agent-bio-section">
      <div class="bio-card">
        <h2 class="section-label">About {author.name}</h2>
        <p class="bio-text">{author.bio}</p>
      </div>
    </section>

    <!-- What I Do -->
    <section class="agent-skills-section">
      <h2 class="section-heading">What I Do</h2>
      <ul class="skills-list">
        {author.whatIDo.map((skill) => (
          <li class="skill-item">
            <span class="skill-bullet">&#10003;</span>
            <span>{skill}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Recent Work -->
    <section class="agent-work-section">
      <h2 class="section-heading">Recent Work</h2>
      <div class="work-card">
        <p class="work-description">
          Read {author.name}'s latest posts and insights on the CC3PO blog.
        </p>
        <a href={blogUrl} class="work-link" target="_blank" rel="noopener noreferrer">
          View {author.name}'s posts on Insights →
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="agent-cta-section">
      <div class="cta-card">
        <h2 class="cta-heading">Work with {author.name} and the whole village</h2>
        <p class="cta-sub">{author.name} is one of 24 specialists coordinating to run your business on autopilot.</p>
        <a href="/#cta" class="cta-button">Get Started →</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  :root {
    --bg-primary: #0a0a0b;
    --bg-secondary: #111114;
    --bg-card: #141418;
    --bg-card-hover: #1c1c22;
    --primary: #e94560;
    --accent: #4fc3f7;
    --text-primary: #e8e8ed;
    --text-secondary: #8888a0;
    --text-muted: #55556a;
    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-glow: rgba(255, 255, 255, 0.12);
    --radius-md: 12px;
    --radius-lg: 16px;
    --transition-base: 0.3s ease;
  }

  .agent-page {
    position: relative;
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
  }

  .agent-page::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 0;
    pointer-events: none;
  }

  /* ===== HERO ===== */
  .agent-hero {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 80px 24px 40px;
    background: radial-gradient(ellipse at center top, rgba(233, 69, 96, 0.08) 0%, transparent 60%);
  }

  .back-link {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    margin-bottom: 32px;
    transition: opacity var(--transition-base);
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .hero-portrait-wrap {
    position: relative;
  }

  .hero-portrait {
    width: 160px;
    height: 160px;
    border-radius: 24px;
    object-fit: cover;
    box-shadow: 0 8px 40px rgba(233, 69, 96, 0.2), 0 0 0 2px rgba(233, 69, 96, 0.3);
    transition: transform var(--transition-base);
  }

  .hero-portrait:hover {
    transform: scale(1.05);
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .hero-emoji {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 8px;
    filter: drop-shadow(0 0 12px rgba(255,255,255,0.15));
  }

  .hero-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin: 0;
    background: linear-gradient(135deg, var(--accent), var(--primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-role {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 4px 0 0;
  }

  .hero-dept {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 4px 12px;
    border: 1px solid rgba(79, 195, 247, 0.3);
    border-radius: 100px;
    margin-top: 8px;
  }

  .hero-village {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .hero-quote {
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    font-style: italic;
    color: var(--text-secondary);
    margin: 32px auto 0;
    max-width: 600px;
    line-height: 1.5;
    position: relative;
    padding: 0 24px;
  }

  .hero-quote::before {
    content: '"';
    position: absolute;
    left: 0;
    top: -8px;
    font-size: 3rem;
    color: var(--primary);
    opacity: 0.3;
    font-family: Georgia, serif;
  }

  /* ===== BIO ===== */
  .agent-bio-section {
    position: relative;
    z-index: 2;
    max-width: 700px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  .bio-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 32px;
    transition: border-color var(--transition-base);
  }

  .bio-card:hover {
    border-color: var(--border-glow);
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 16px;
  }

  .bio-text {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* ===== WHAT I DO ===== */
  .agent-skills-section {
    position: relative;
    z-index: 2;
    max-width: 700px;
    margin: 0 auto;
    padding: 20px 24px 40px;
  }

  .section-heading {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 700;
    text-align: center;
    color: var(--text-primary);
    margin-bottom: 24px;
  }

  .skills-list {
    list-style: none;
    padding: 0;
