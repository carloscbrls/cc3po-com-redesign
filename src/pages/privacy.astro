</Layout>

<style>
  .legal-page h1 {
    font-size: var(--text-5xl);
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }
  .legal-updated {
    font-size: var(--text-caption);
    color: var(--text-muted);
    margin-bottom: var(--space-2xl);
  }
  .legal-page h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-secondary);
    margin: var(--space-xl) 0 var(--space-sm);
  }
  .legal-page p {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.8;
  }
  .legal-page ul {
    list-style: disc;
    padding-left: 24px;
    margin-bottom: var(--space-md);
  }
  .legal-page li {
    color: var(--text-muted);
    font-size: var(--text-base);
    line-height: 1.8;
    margin-bottom: 8px;
  }
  .legal-page a {
    color: var(--accent);
    transition: color var(--duration-fast);
  }
  .legal-page a:hover {
    color: var(--accent-hover);
  }
</style>

<script is:inline>
  // Nav scroll handled by SiteNav component
  const ro=new IntersectionObserver((e)=>{e.forEach(en=>{if(en.isIntersecting){en.target.classList.add('revealed');ro.unobserve(en.target)}})},{threshold:0.15});
  document.querySelectorAll('.reveal').forEach(el=>ro.observe(el));
  // Mobile drawer handled by Layout.astro
</script>