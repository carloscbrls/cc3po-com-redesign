---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Morning Report Demo — See What CC3PO Does While You Sleep" description="See a live demo of the CC3PO Morning Report — your daily business briefing with uptime monitoring, compliance scores, lead tracking, and actionable recommendations.">
  <style>
    :root {
      --bg: #0a0a0b;
      --bg-card: #141418;
      --bg-card-hover: #1a1a1f;
      --text: #fff;
      --text-muted: #71717a;
      --text-secondary: #a1a1aa;
      --primary: var(--accent);
      --accent: #4fc3f7;
      --green: #00e676;
      --gold: #d4a843;
      --purple: #7c3aed;
      --border: rgba(255,255,255,0.06);
      --border-glow: rgba(107,53,255,0.3);
      --font: 'Inter', system-ui, -apple-system, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--font); background: var(--bg); color: var(--text); line-height: 1.6; }

    .demo-page { min-height: 100vh; }

    /* Hero Section */
    .demo-hero {
      text-align: center;
      padding: 120px 24px 60px;
      max-width: 800px;
      margin: 0 auto;
    }
    .demo-hero h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 800;
      line-height: 1.1;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #fff, #e4e4e7);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .demo-hero p {
      font-size: 1.1rem;
      color: var(--text-secondary);
      max-width: 600px;
      margin: 0 auto 40px;
    }

    /* Input Section */
    .input-section {
      max-width: 500px;
      margin: 0 auto 60px;
      padding: 0 24px;
    }
    .input-wrapper {
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .business-input {
      flex: 1;
      padding: 16px 20px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: #fff;
      font-size: 1rem;
      font-family: var(--font);
      outline: 2px solid var(--accent, #e8506b); outline-offset: 2px;
      transition: border-color 0.3s;
    }
    .business-input:focus {
      border-color: var(--accent);
    }
    .business-input::placeholder {
      color: var(--text-muted);
    }
    .generate-btn {
      padding: 16px 32px;
      background: linear-gradient(135deg, var(--primary), #c7384f);
      border: none;
      border-radius: 12px;
      color: #fff;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      white-space: nowrap;
    }
    .generate-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(233,69,96,0.3);
    }
    .generate-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    /* Phone Frame */
    .phone-container {
      max-width: 420px;
      margin: 0 auto 80px;
      padding: 0 24px;
    }
    .phone-frame {
      background: #000;
      border-radius: 40px;
      border: 3px solid #333;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.05);
    }
    .phone-notch {
      width: 120px;
      height: 28px;
      background: #000;
      border-radius: 0 0 16px 16px;
      margin: 0 auto;
      position: relative;
      z-index: 10;
    }
    .phone-status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 24px 4px;
      font-size: 12px;
      color: #fff;
      font-weight: 600;
    }
    .phone-status-bar .time { font-size: 14px; font-weight: 700; }

    /* Morning Report Content */
    .report-content {
      padding: 20px 20px 30px;
      opacity: 0;
      transition: opacity 0.5s;
    }
    .report-content.visible { opacity: 1; }
    .report-content.hidden { opacity: 0; }

    .report-greeting {
      font-size: 14px;
      color: var(--text-muted);
      margin-bottom: 4px;
    }
    .report-date {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 16px;
    }
    .report-title {
      font-size: 20px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 24px;
    }

    .report-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 16px;
      background: rgba(255,255,255,0.03);
      border-radius: 12px;
      margin-bottom: 10px;
      border: 1px solid rgba(255,255,255,0.05);
      animation: slideIn 0.4s ease-out forwards;
      opacity: 0;
    }
    @keyframes slideIn {
      from { opacity: 0; transform: translateX(-10px); }
      to { opacity: 1; transform: translateX(0); }
    }
    .report-item:nth-child(1) { animation-delay: 0.1s; }
    .report-item:nth-child(2) { animation-delay: 0.3s; }
    .report-item:nth-child(3) { animation-delay: 0.5s; }
    .report-item:nth-child(4) { animation-delay: 0.7s; }
    .report-item:nth-child(5) { animation-delay: 0.9s; }

    .report-icon {
      font-size: 20px;
      flex-shrink: 0;
      width: 28px;
      text-align: center;
    }
    .report-details {
      flex: 1;
    }
    .report-label {
      font-size: 13px;
      font-weight: 600;
      color: #fff;
    }
    .report-desc {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    /* Health Score */
    .health-score {
      margin-top: 20px;
      padding: 16px;
      background: linear-gradient(135deg, rgba(0,230,118,0.08), rgba(0,230,118,0.03));
      border: 1px solid rgba(0,230,118,0.2);
      border-radius: 16px;
      text-align: center;
      animation: slideIn 0.4s ease-out 1.1s forwards;
      opacity: 0;
    }
    .health-score-label {
      font-size: 12px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 4px;
    }
    .health-score-value {
      font-size: 48px;
      font-weight: 800;
      color: var(--green);
      line-height: 1;
    }
    .health-score-change {
      font-size: 14px;
      color: var(--green);
      margin-top: 4px;
    }

    /* CTA Section */
    .cta-section {
      text-align: center;
      padding: 60px 24px 100px;
      max-width: 600px;
      margin: 0 auto;
    }
    .cta-section h2 {
      font-size: 1.8rem;
      font-weight: 700;
      margin-bottom: 16px;
      color: #fff;
    }
    .cta-section p {
      color: var(--text-secondary);
      margin-bottom: 32px;
      font-size: 1.05rem;
    }
    .cta-buttons {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 16px 32px;
      background: linear-gradient(135deg, var(--primary), #c7384f);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(233,69,96,0.3);
    }
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 16px 32px;
      background: rgba(255,255,255,0.05);
      color: #fff;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-secondary:hover {
      background: rgba(255,255,255,0.08);
      border-color: rgba(255,255,255,0.2);
    }

    /* Placeholder state */
    .placeholder-state {
      padding: 60px 20px;
      text-align: center;
    }
    .placeholder-state .phone-icon {
      font-size: 48px;
      margin-bottom: 16px;
      opacity: 0.3;
    }
    .placeholder-state p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* Trust badges */
    .trust-badges {
      display: flex;
      justify-content: center;
      gap: 24px;
      padding: 20px;
      margin-top: 40px;
      flex-wrap: wrap;
    }
    .trust-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      color: var(--text-muted);
    }
    .trust-badge span:first-child {
      font-size: 1.1rem;
    }

    /* Share buttons */
    .share-section {
      text-align: center;
      padding: 0 24px 40px;
      max-width: 500px;
      margin: 0 auto;
    }
    .share-section p {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 16px;
    }
    .share-buttons {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .share-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: #fff;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }
    .share-btn:hover {
      transform: translateY(-2px);
      border-color: rgba(107,53,255,0.3);
    }
    .share-btn.twitter { background: #1DA1F2; border-color: #1DA1F2; }
    .share-btn.linkedin { background: #0A66C2; border-color: #0A66C2; }
    .share-btn.copy { background: var(--bg-card); border-color: var(--border); }

    @media (max-width: 640px) {
      .input-wrapper { flex-direction: column; }
      .generate-btn { width: 100%; }
      .phone-container { padding: 0 12px; }
      .demo-hero { padding: 100px 16px 40px; }
    }
  </style>

  <section class="demo-page">
    <section class="demo-hero">
      <h1>See what your morning report looks like.</h1>
      <p>Type your business name and watch. This is what you wake up to every day — a business that ran great overnight.</p>
    </section>

    <div class="input-section">
      <div class="input-wrapper">
        <label for="business-name" class="sr-only">Business name</label>
        <input type="text" class="business-input" id="business-name" placeholder="Your business name..." maxlength="50" aria-label="Business name">
        <button class="generate-btn" id="generate-btn" onclick="generateReport()">See Report</button>
      </div>
    </div>

    <div class="phone-container">
      <div class="phone-frame">
        <div class="phone-notch"></div>
        <div class="phone-status-bar">
          <span class="time" id="phone-time">6:47</span>
          <span>☀️</span>
        </div>
        <div id="report-display">
          <div class="placeholder-state" id="placeholder">
            <div class="phone-icon">📱</div>
            <p>Type your business name above<br>to see your morning report</p>
          </div>
          <div class="report-content hidden" id="report">
            <p class="report-greeting">☀️ Good morning, <span id="report-name"></span>.</p>
            <p class="report-date" id="report-date"></p>
            <h2 class="report-title">Your business ran great overnight.</h2>

            <div class="report-item" style="animation-delay:0.1s">
              <span class="report-icon">✅</span>
              <div class="report-details">
                <div class="report-label">Website</div>
                <div class="report-desc" id="report-website">Plugin conflict fixed at 2:14 AM</div>
              </div>
            </div>

            <div class="report-item" style="animation-delay:0.3s">
              <span class="report-icon">💬</span>
              <div class="report-details">
                <div class="report-label">Reviews</div>
                <div class="report-desc" id="report-reviews">3 responded to professionally</div>
              </div>
            </div>

            <div class="report-item" style="animation-delay:0.5s">
              <span class="report-icon">📱</span>
              <div class="report-details">
                <div class="report-label">Social</div>
                <div class="report-desc" id="report-social">2 posts published on schedule</div>
              </div>
            </div>

            <div class="report-item" style="animation-delay:0.7s">
              <span class="report-icon">🛡️</span>
              <div class="report-details">
                <div class="report-label">Compliance</div>
                <div class="report-desc" id="report-compliance">Up to date — new law already handled</div>
              </div>
            </div>

            <div class="report-item" style="animation-delay:0.9s">
              <span class="report-icon">🔍</span>
              <div class="report-details">
                <div class="report-label">Competitor</div>
                <div class="report-desc" id="report-competitor">Price drop detected — recommendation ready</div>
              </div>
            </div>

            <div class="health-score">
              <div class="health-score-label">Business Health Score</div>
              <div class="health-score-value" id="report-score">87</div>
              <div class="health-score-change">↑ 14 from last month</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="trust-badges">
      <div class="trust-badge"><span>🏛️</span> CA Certified Small Business</div>
      <div class="trust-badge"><span>🌎</span> Latino-Owned Business</div>
      <div class="trust-badge"><span>🛡️</span> SB/DVBE Option Eligible</div>
      <div class="trust-badge"><span>🤝</span> Se habla español</div>
    </div>

    <div class="share-section" id="share-section" style="display:none;">
      <p>Share your morning report preview:</p>
      <div class="share-buttons">
        <a class="share-btn twitter" id="share-twitter" target="_blank" rel="noopener">🐦 Twitter</a>
        <a class="share-btn linkedin" id="share-linkedin" target="_blank" rel="noopener">💼 LinkedIn</a>
        <button class="share-btn copy" id="share-copy">📋 Copy Link</button>
      </div>
    </div>

    <section class="cta-section">
      <h2>This is what every morning looks like.</h2>
      <p>Not a dashboard you have to check. Not a report you have to run. Just open your phone and see what happened.</p>
      <div class="cta-buttons">
        <a href="/#cta" class="btn-primary">🔍 Get Your Free Business Scan</a>
        <a href="/village/" class="btn-secondary">👥 Meet the Village</a>
      </div>
    </section>
  </section>

  <script>
    function generateReport() {
      const input = document.getElementById('business-name');
      const btn = document.getElementById('generate-btn');
      const placeholder = document.getElementById('placeholder');
      const report = document.getElementById('report');
      const name = input.value.trim() || 'Your Business';

      btn.disabled = true;
      btn.textContent = 'Generating...';

      // Set business name
      document.getElementById('report-name').textContent = name;

      // Set date
      const now = new Date();
      const options = { weekday: 'long', month: 'long', day: 'numeric' };
      document.getElementById('report-date').textContent = now.toLocaleDateString('en-US', options);

      // Customize based on business name
      const nameLC = name.toLowerCase();
      const websiteFixes = {
        default: 'Plugin conflict fixed at 2:14 AM',
        dental: 'Appointment page loaded successfully — 3 AM check passed',
        restaurant: 'Menu page updated — prices synced at 1:47 AM',
        salon: 'Booking page verified — 12:30 AM check passed',
        gym: 'Class schedule refreshed — all sessions verified',
        law: 'Contact form tested — 3:22 AM check passed',
        hvac: 'Emergency button verified — 1:15 AM check passed',
        plumber: 'Service area page verified — 2:00 AM check passed',
        real: 'Listing page verified — 4:15 AM check passed',
        auto: 'Inventory page synced — 11:30 PM check passed',
        church: 'Sermon page updated — 11:00 PM check passed',
        school: 'Enrollment form verified — 3:00 AM check passed',
        store: 'Product page inventory synced — 1:00 AM check passed',
      };
      const reviews = {
        default: '3 responded to professionally',
        dental: '2 patient reviews answered',
        restaurant: '4 reviews responded to warmly',
        salon: '2 Google reviews answered same day',
        gym: '1 review responded to — 5-star thank you sent',
        law: '1 client review acknowledged',
        hvac: '2 emergency calls logged',
        plumber: '3 reviews responded to within 30 minutes',
        church: '1 community review acknowledged',
      };

      let websiteFix = websiteFixes.default;
      let reviewText = reviews.default;
      for (const [key, val] of Object.entries(websiteFixes)) {
        if (key !== 'default' && nameLC.includes(key)) { websiteFix = val; break; }
      }
      for (const [key, val] of Object.entries(reviews)) {
        if (key !== 'default' && nameLC.includes(key)) { reviewText = val; break; }
      }
      document.getElementById('report-website').textContent = websiteFix;
      document.getElementById('report-reviews').textContent = reviewText;

      // Randomize score between 82-96
      const score = 82 + Math.floor(Math.random() * 15);
      document.getElementById('report-score').textContent = score;

      // Update phone time to current
      const hours = now.getHours();
      const mins = now.getMinutes();
      document.getElementById('phone-time').textContent = `${hours}:${mins.toString().padStart(2, '0')}`;

      // Show report with animation
      placeholder.style.display = 'none';
      report.classList.remove('hidden');
      report.classList.add('visible');

      // Reset button
      setTimeout(() => {
        btn.disabled = false;
        btn.textContent = 'Try Another Name';
      }, 2000);
    }

    // Allow Enter key
    document.getElementById('business-name').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') generateReport();
    });

    // Share buttons
    function showShare(businessName, score) {
      const section = document.getElementById('share-section');
      section.style.display = 'block';
      const text = encodeURIComponent(`My business "${businessName}" scored ${score}/100 on the CC3PO Business Health Check! See yours:`);
      const url = encodeURIComponent('https://cc3po.com/morning-report/');
      document.getElementById('share-twitter').href = `https://twitter.com/intent/tweet?text=${text}&url=${url}`;
      document.getElementById('share-linkedin').href = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;
      document.getElementById('share-copy').addEventListener('click', () => {
        navigator.clipboard.writeText('https://cc3po.com/morning-report/');
        document.getElementById('share-copy').textContent = '✓ Copied!';
        setTimeout(() => { document.getElementById('share-copy').textContent = '📋 Copy Link'; }, 2000);
      });
    }

    // Override generateReport to also show share buttons
    const origGenerate = generateReport;
    generateReport = function() {
      origGenerate();
      const name = document.getElementById('business-name').value.trim() || 'Your Business';
      const score = document.getElementById('report-score').textContent;
      showShare(name, score);
    };
  </script>
</Layout>