  <style is:inline>
    .nonprofit-hero {
      background: linear-gradient(135deg, #0a0a12 0%, #0a1628 50%, #1a0a14 100%);
    }

    .back-link {
      display: inline-block;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
      margin-bottom: 16px;
      transition: color 0.2s;
    }
    .back-link:hover { color: var(--accent); }

    .hero-stats {
      display: flex;
      gap: 32px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 24px;
    }
    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .stat-number {
      font-size: 2rem;
      font-weight: 800;
      color: var(--accent);
    }
    .stat-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .hero-credentials {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: center;
      margin-top: 24px;
    }
    .credential-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.8rem;
      color: var(--text-secondary);
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 8px;
    }

    .hero-ctas {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 32px;
    }

    /* Services Grid */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      margin-top: 40px;
    }
    .service-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      transition: transform 0.2s, border-color 0.2s;
    }
    .service-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
    }
    .service-icon { font-size: 2rem; margin-bottom: 12px; }
    .service-card h3 { font-size: 1.1rem; font-weight: 700; color: #fff; margin-bottom: 8px; }
    .service-card p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; }

    /* Before/After */
    .before-after-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      max-width: 900px;
      margin: 0 auto;
    }
    @media (max-width: 768px) {
      .before-after-split { grid-template-columns: 1fr; }
    }
    .ba-column { border-radius: 12px; padding: 28px; }
    .ba-without { background: rgba(233, 69, 96, 0.08); border: 1px solid rgba(233, 69, 96, 0.25); }
    .ba-with { background: rgba(0, 230, 118, 0.08); border: 1px solid rgba(0, 230, 118, 0.25); }
    .ba-column-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 18px; }
    .ba-without .ba-column-title { color: var(--accent); }
    .ba-with .ba-column-title { color: #00e676; }
    .ba-column-items { display: flex; flex-direction: column; gap: 14px; }
    .ba-line-item { display: flex; align-items: flex-start; gap: 10px; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }
    .ba-line-icon { flex-shrink: 0; font-size: 1rem; }

    /* Credentials Banner */
    .credentials-banner {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
      margin-top: 40px;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }
    .credential-highlight {
      background: rgba(79, 195, 247, 0.08);
      border: 1px solid rgba(79, 195, 247, 0.25);
      border-radius: 12px;
      padding: 20px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .credential-icon { font-size: 1.5rem; flex-shrink: 0; }
    .credential-highlight strong { font-size: 0.9rem; color: #fff; display: block; margin-bottom: 4px; }
    .credential-highlight p { font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5; margin: 0; }

    /* Compliance Grid */
    .compliance-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 40px;
    }
    .compliance-item {
      background: rgba(233, 69, 96, 0.06);
      border: 1px solid rgba(233, 69, 96, 0.2);
      border-radius: 12px;
      padding: 24px;
      transition: border-color 0.2s;
    }
    .compliance-item:hover { border-color: var(--accent); }
    .compliance-icon { font-size: 1.5rem; margin-bottom: 8px; }
    .compliance-item h3 { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 6px; }
    .compliance-item p { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 12px; }
    .compliance-risk { font-size: 0.8rem; color: var(--accent); font-weight: 600; }

    /* Comparison Table */
    .comparison-table-wrap { max-width: 700px; margin: 0 auto; overflow-x: auto; }
    .comparison-table {
      width: 100%; border-collapse: separate; border-spacing: 0;
      border-radius: 12px; overflow: hidden; border: 1px solid var(--border);
