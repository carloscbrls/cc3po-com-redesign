---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI for Nonprofits — Website, Compliance, Marketing & Grant Writing | CC3PO" description="The AI team that handles your nonprofit's website, 501c3 compliance, ADA accessibility, marketing, and grant writing — for less than a part-time admin. Starting at $497/mo. CA Certified Small Business.">
  <!-- ====== HERO ====== -->
  <section class="hero nonprofit-hero" id="main-content">
    <canvas id="hero-canvas"></canvas>
    <div class="hero-content">
      <a href="/" class="back-link reveal">← Back to Services</a>
      <div class="hero-badge reveal">
        <span class="pulse-dot"></span>
        Built for nonprofits
      </div>

      <h1 class="hero-title reveal">
        The AI Team That Handles Your Nonprofit's Website, Compliance, Marketing & Grant Writing
      </h1>

      <p class="hero-sub reveal">
        Limited budget. <strong>501c3 website legal requirements</strong> you don't have time for. Volunteers burning out. We handle it all — for less than a part-time admin assistant. 24/7.
      </p>

      <div class="hero-stats reveal">
        <div class="stat-item">
          <span class="stat-number">$497</span>
          <span class="stat-label">Less than part-time help</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">501c3</span>
          <span class="stat-label">Compliance covered</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">24/7</span>
          <span class="stat-label">Always running</span>
        </div>
      </div>

      <div class="hero-credentials reveal">
        <div class="credential-item">
          <span>🏛️</span>
          <span>CA Certified Small Business — SB #2052063</span>
        </div>
        <div class="credential-item">
          <span>🌎</span>
          <span>Latino-Owned Business</span>
        </div>
        <div class="credential-item">
          <span>🛡️</span>
          <span>SB/DVBE Option Eligible</span>
        </div>
      </div>

      <div class="hero-ctas reveal">
        <a href="/#cta" class="btn btn-primary btn-glow">Free Nonprofit Website Compliance Audit →</a>
        <a href="https://cc3po.io/strategy-call" class="btn btn-secondary" target="_blank" rel="noopener">📞 Strategy Call</a>
      </div>
    </div>
  </section>

  <!-- ====== TRUST BAR ====== -->
  <section class="trust-bar" style="background: var(--bg-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 16px 0;">
    <div class="container" style="display: flex; align-items: center; justify-content: center; gap: 32px; flex-wrap: wrap; text-align: center;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #ffd700; font-size: 18px;">🏛️</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">CA Certified Small Business</span>
        <span style="color: var(--text-muted); font-size: 12px;">SB #2052063</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: var(--accent); font-size: 18px;">🌎</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">Latino-Owned Business</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #4fc3f7; font-size: 18px;">🛡️</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">SB/DVBE Option Eligible</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #00e676; font-size: 18px;">🌐</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">Se habla español</span>
      </div>
    </div>
  </section>

  <!-- ====== WHAT WE HANDLE ====== -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">What Your Village Handles</div>
        <h2 class="section-title">Everything your nonprofit needs. Running on a nonprofit budget.</h2>
        <p class="section-desc">You're focused on your mission. We're focused on making sure your website, compliance, marketing, and grant writing never fall through the cracks.</p>
      </div>

      <div class="services-grid reveal">
        <div class="service-card">
          <div class="service-icon">📋</div>
          <h3>501c3 Compliance</h3>
          <p>Your website meets every IRS requirement for tax-exempt organizations — proper disclosures, donation statements, EIN display, and annual information return links. Automatically maintained.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">♿</div>
          <h3>ADA Accessibility</h3>
          <p>ADA lawsuits targeting nonprofit websites are skyrocketing. We scan your site for WCAG 2.1 AA compliance, fix violations, and monitor continuously. Protect your mission and your donors.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📝</div>
          <h3>Grant Research Assistance</h3>
          <p>We research grant opportunities aligned with your mission, help you stay ahead of deadlines, and assist with application narratives. More grants, less searching.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">💌</div>
          <h3>Donor Communication</h3>
          <p>Thank-you emails, impact reports, campaign updates, and donor retention sequences — all automated, all personal. Keep your supporters engaged and giving.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📱</div>
          <h3>Social Media Storytelling</h3>
          <p>Your mission deserves to be heard. We create and schedule consistent social content that tells your story, highlights your impact, and attracts new supporters.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🌐</div>
          <h3>Website Management</h3>
          <p>Your website is your digital front door. We keep it fast, secure, accessible, and up-to-date with your programs, events, and impact data. No more "we'll update it next week."</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== BUDGET FRAMING ====== -->
  <section class="section" style="background: var(--bg-secondary);" id="budget">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Nonprofit Budget Reality</div>
        <h2 class="section-title">$497/mo is less than a part-time admin assistant.</h2>
        <p class="section-desc">And we do more than any hire could — 24 hours a day, 7 days a week, 365 days a year.</p>
      </div>

      <div class="before-after-split reveal">
        <div class="ba-column ba-without">
          <div class="ba-column-title">⚠️ What nonprofits typically do</div>
          <div class="ba-column-items">
            <div class="ba-line-item">
              <span class="ba-line-icon">💸</span>
              <span>Hire a part-time admin assistant at $15-20/hr = $2,400+/mo</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">😰</span>
              <span>Still no website compliance, no marketing, no grant research</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">🤷</span>
              <span>Ask a volunteer to "figure out" ADA compliance on the website</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">📅</span>
              <span>Post on social media when someone remembers (usually doesn't)</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">📋</span>
              <span>Skip grant deadlines because no one's tracking them</span>
            </div>
          </div>
        </div>
        <div class="ba-column ba-with">
          <div class="ba-column-title">✅ With CC3PO at $497/mo</div>
          <div class="ba-column-items">
            <div class="ba-line-item">
              <span class="ba-line-icon">🛡️</span>
              <span>Full 501c3 website compliance — always up to date</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">♿</span>
              <span>ADA/WCAG accessibility scanning and remediation</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">📱</span>
              <span>Social media posted on schedule, every week</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">📝</span>
              <span>Grant opportunities researched and delivered to your inbox</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">💌</span>
              <span>Donor communications automated — thank-yous, updates, campaigns</span>
            </div>
          </div>
        </div>
      </div>

      <div class="credentials-banner reveal">
        <div class="credential-highlight">
          <span class="credential-icon">🏛️</span>
          <div>
            <strong>CA Certified Small Business (SB #2052063)</strong>
            <p>Important for grant compliance — working with a certified small business can count toward your supplier diversity goals.</p>
          </div>
        </div>
        <div class="credential-highlight">
          <span class="credential-icon">🌎</span>
          <div>
            <strong>Latino-Owned & SB/DVBE Option Eligible</strong>
            <p>Strengthens your diversity reporting and may qualify your nonprofit for additional funding preferences.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== 501C3 COMPLIANCE ====== -->
  <section class="section" id="compliance">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">501c3 Website Compliance</div>
        <h2 class="section-title">Your nonprofit website has legal requirements. We handle them all.</h2>
      </div>

      <div class="compliance-grid reveal">
        <div class="compliance-item">
          <div class="compliance-icon">📋</div>
          <h3>IRS Disclosure Requirements</h3>
          <p>Form 990 availability, EIN display, tax-exempt status statements, and proper donation acknowledgment language.</p>
          <div class="compliance-risk">Risk: <strong>Loss of tax-exempt status</strong></div>
        </div>
        <div class="compliance-item">
          <div class="compliance-icon">💰</div>
          <h3>Donation & Solicitation Compliance</h3>
          <p>State registration requirements, Quid Pro Quo disclosure rules, written acknowledgment requirements for donations over $250.</p>
          <div class="compliance-risk">Risk: <strong>Penalties up to $10,000</strong></div>
        </div>
        <div class="compliance-item">
          <div class="compliance-icon">♿</div>
          <h3>ADA / WCAG Accessibility</h3>
          <p>Nonprofit websites are places of public accommodation under the ADA. WCAG 2.1 AA compliance is essential to avoid demand letters and lawsuits.</p>
          <div class="compliance-risk">Risk: <strong>$4,000+ per violation</strong></div>
        </div>
        <div class="compliance-item">
          <div class="compliance-icon">🔒</div>
          <h3>Privacy & Data Protection</h3>
          <p>Donor data protection, CCPA compliance for California donors, privacy policy requirements, and secure donation processing.</p>
          <div class="compliance-risk">Risk: <strong>$7,500 per intentional violation</strong></div>
        </div>
        <div class="compliance-item">
          <div class="compliance-icon">⚖️</div>
          <h3>California Nonprofit Law</h3>
          <p>Attorney General Registry requirements, charitable solicitation registration, RRF-1 annual filings, and proper board governance disclosures.</p>
          <div class="compliance-risk">Risk: <strong>Loss of registration & penalties</strong></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== COMPARISON TABLE ====== -->
  <section class="section" style="background: var(--bg-secondary);" id="comparison">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">The Math for Nonprofits</div>
        <h2 class="section-title">What it costs to hire separately vs. CC3PO.</h2>
      </div>

      <div class="comparison-table-wrap reveal">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Hire Separately</th>
              <th>Cost/mo</th>
              <th>CC3PO</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Part-time admin assistant</td>
              <td class="cost-cell">$2,400</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Web developer</td>
              <td class="cost-cell">$3,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Grant writer (part-time)</td>
              <td class="cost-cell">$3,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Social media manager</td>
              <td class="cost-cell">$2,500</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Compliance consultant</td>
              <td class="cost-cell">$2,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Donor management system</td>
              <td class="cost-cell">$500</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr class="total-row">
              <td><strong>Total</strong></td>
              <td class="cost-cell"><strong>$13,400/mo</strong></td>
              <td class="included-cell"><strong>Starting at $497/mo</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ====== TESTIMONIALS ====== -->
  <section class="section" id="proof">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Proof</div>
        <h2 class="section-title">Real businesses. Real results.</h2>
      </div>
      <div class="testimonials-grid reveal">
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"I used to spend 3 hours a day managing reviews and social media. Now I wake up and it's all done. My Business Health Score went from 52 to 87 in two months."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Dr. Alan Lee</div>
            <div class="testimonial-role">Sunrise Dental, Stockton CA</div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"The compliance scanning alone is worth it. We had 14 ADA violations we didn't know about. Sentinel found them, fixed them, and now we're clean. That would've been a $4,000 fine per violation."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Matt Safdari</div>
            <div class="testimonial-role">Top Class Fitness, Modesto CA</div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"I was skeptical about AI running my business. Then I got my first morning report and realized — they actually did everything while I slept. My Google reviews went from 3.2 to 4.7 stars."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Julius Jones</div>
            <div class="testimonial-role">Central Valley Auto, Lathrop CA</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== CTA ====== -->
  <section class="cta-section" id="cta">
    <div class="container cta-content">
      <div class="reveal">
        <h2>Your nonprofit deserves the same tools as the big organizations.</h2>
        <p>Get a free compliance audit of your website, accessibility, and 501c3 requirements — no credit card, no obligation.</p>
        <div class="cta-trust" style="margin-top:24px;">
          <span>✓ No credit card</span>
          <span>✓ 501c3 compliance check</span>
          <span>✓ ADA/WCAG audit</span>
          <span>✓ Real recommendations</span>
        </div>
        <div class="hero-ctas" style="margin-top:32px;">
          <a href="/#cta" class="btn btn-primary btn-glow">Free Nonprofit Website Compliance Audit →</a>
          <a href="https://cc3po.io/strategy-call" class="btn btn-secondary" target="_blank" rel="noopener">📞 Strategy Call</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div style="font-size:17px;font-weight:800;margin-bottom:8px;">CC3PO</div>
          <p>Your whole business team. One price. 24/7.</p>
          <p class="footer-tagline" style="margin-top:12px;font-size:0.75rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,0.4);">Build once. Run forever. Evolve continuously.</p>
          <div style="margin-top:16px;font-size:0.75rem;color:rgba(255,255,255,0.35);line-height:1.5;"><strong style="color:rgba(255,255,255,0.5);">Certifications:</strong> CA Certified Small Business — SB #2052063 · Latino-Owned Business · Se habla español · SB/DVBE Option · <a href="/certifications" style="color:var(--accent);">View All →</a></div>
        </div>
