---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Free Compliance Scan — CC3PO" description="Get a free ADA/WCAG compliance scan of your website. Find violations before lawsuits find you. No signup required.">

  <!-- Hero -->
  <section style="padding:120px 0 80px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(233,69,96,0.12) 0%,transparent 60%);pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <div style="margin:0 auto 24px;width:72px;height:72px;border-radius:18px;background:rgba(233,69,96,0.12);border:1px solid rgba(233,69,96,0.25);display:flex;align-items:center;justify-content:center;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#e94560" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </div>
      <p style="color:#e94560;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:12px;">Free Compliance Scan</p>
      <h1 style="font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;letter-spacing:-0.02em;line-height:1.1;margin-bottom:20px;">Is Your Website Compliant?</h1>
      <p style="font-size:1.15rem;color:var(--text-secondary);max-width:560px;margin:0 auto 36px;line-height:1.6;">Find out in 30 seconds. Our free scanner checks your site against WCAG 2.1 AA standards and shows you exactly what needs fixing.</p>
      <div style="max-width:500px;margin:0 auto;">
        <form id="scan-form" style="display:flex;gap:12px;">
          <input type="url" id="scan-url" placeholder="Enter your website URL" required style="flex:1;padding:14px 18px;border-radius:10px;border:1px solid var(--border);background:var(--bg-card);color:#fff;font-size:1rem;" />
          <button type="submit" style="background:#e94560;color:#fff;padding:14px 28px;border-radius:10px;font-weight:700;font-size:1rem;border:none;cursor:pointer;white-space:nowrap;box-shadow:0 4px 20px rgba(233,69,96,0.3);">Scan Now</button>
        </form>
        <p style="color:var(--text-muted);font-size:0.85rem;margin-top:12px;">No signup required · Results in 30 seconds · 100% free</p>
      </div>

      <!-- Results container (hidden until scan completes) -->
      <div id="scan-results" style="display:none;max-width:700px;margin:40px auto 0;padding:32px;background:var(--bg-card);border-radius:16px;border:1px solid var(--border);"></div>
    </div>
  </section>

  <!-- Stats -->
  <section style="padding:60px 0;">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;text-align:center;">
        <div style="padding:24px;">
          <p style="font-size:2.5rem;font-weight:800;color:#e94560;margin-bottom:4px;">$4K+</p>
          <p style="color:var(--text-secondary);font-size:0.9rem;">Average ADA lawsuit settlement</p>
        </div>
        <div style="padding:24px;">
          <p style="font-size:2.5rem;font-weight:800;color:#e94560;margin-bottom:4px;">96%</p>
          <p style="color:var(--text-secondary);font-size:0.9rem;">Of websites have WCAG violations</p>
        </div>
        <div style="padding:24px;">
          <p style="font-size:2.5rem;font-weight:800;color:#e94560;margin-bottom:4px;">3,000+</p>
          <p style="color:var(--text-secondary);font-size:0.9rem;">ADA demand letters sent this year</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding:80px 0;background:var(--bg-secondary);text-align:center;">
    <div class="container">
      <h2 style="font-size:1.8rem;font-weight:800;margin-bottom:16px;">Don't Wait for a Demand Letter</h2>
      <p style="color:var(--text-secondary);max-width:480px;margin:0 auto 32px;line-height:1.6;">A free scan takes 30 seconds. A lawsuit takes months and costs thousands.</p>
      <a href="/audit/" style="background:#e94560;color:#fff;padding:16px 40px;border-radius:10px;font-weight:700;font-size:1.1rem;text-decoration:none;box-shadow:0 4px 20px rgba(233,69,96,0.3);">Scan Your Website Free</a>
    </div>
  </section>

  <!-- Plausible event tracking -->
  <script is:inline>
  document.getElementById('scan-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    plausible('cta_click', { props: { page: 'audit', type: 'free_scan' } });

    const url = document.getElementById('scan-url').value.trim();
    if (!url) return;

    const resultsDiv = document.getElementById('scan-results');
    const submitBtn = e.target.querySelector('button[type="submit"]');
    const origBtnText = submitBtn.textContent;
    submitBtn.textContent = 'Scanning...';
    submitBtn.disabled = true;
    resultsDiv.style.display = 'block';
    resultsDiv.innerHTML = '<p style="text-align:center;color:var(--text-secondary);">Scanning ' + url + '...</p>';

    try {
      const resp = await fetch('https://scanner.cc3po.com/api/scan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: url })
      });
      const data = await resp.json();

      if (data.error) {
        resultsDiv.innerHTML = '<p style="color:#e94560;text-align:center;">Error: ' + data.error + '</p>';
        return;
      }

      const score = data.overallScore || 0;
      const comp = data.compliance || {};
      const perf = data.performance || {};
      const sec = data.security || {};
      const issues = data.issues || [];
      const criticals = issues.filter(i => i.severity === 'critical').length;
      const warnings = issues.filter(i => i.severity === 'warning').length;

      const scoreColor = score >= 80 ? '#10b981' : score >= 50 ? '#f59e0b' : '#e94560';
      const scoreLabel = score >= 80 ? 'Good' : score >= 50 ? 'Needs Work' : 'At Risk';

      resultsDiv.innerHTML = `
        <div style="text-align:center;margin-bottom:24px;">
          <div style="font-size:3.5rem;font-weight:800;color:${scoreColor};margin-bottom:4px;">${score}<span style="font-size:1.5rem;">/100</span></div>
          <p style="color:${scoreColor};font-weight:600;font-size:1.1rem;">${scoreLabel}</p>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:24px;">
          <div style="text-align:center;padding:12px;border-radius:8px;background:rgba(233,69,96,0.08);border:1px solid rgba(233,69,96,0.15);">
            <p style="font-size:1.5rem;font-weight:800;color:${comp.score >= 80 ? '#10b981' : '#e94560'};">${comp.score || 0}</p>
            <p style="font-size:0.8rem;color:var(--text-secondary);">Compliance</p>
          </div>
          <div style="text-align:center;padding:12px;border-radius:8px;background:rgba(233,69,96,0.08);border:1px solid rgba(233,69,96,0.15);">
            <p style="font-size:1.5rem;font-weight:800;color:${perf.score >= 80 ? '#10b981' : '#f59e0b'};">${perf.score || 0}</p>
            <p style="font-size:0.8rem;color:var(--text-secondary);">Performance</p>
          </div>
          <div style="text-align:center;padding:12px;border-radius:8px;background:rgba(233,69,96,0.08);border:1px solid rgba(233,69,96,0.15);">
            <p style="font-size:1.5rem;font-weight:800;color:${sec.score >= 80 ? '#10b981' : '#f59e0b'};">${sec.score || 0}</p>
            <p style="font-size:0.8rem;color:var(--text-secondary);">Security</p>
          </div>
        </div>
        ${issues.length > 0 ? `
        <div style="margin-bottom:24px;">
          <p style="font-weight:700;margin-bottom:12px;">Top Issues Found</p>
          ${issues.slice(0, 5).map(i => `
            <div style="padding:8px 12px;margin-bottom:6px;border-radius:6px;background:rgba(${i.severity === 'critical' ? '233,69,96' : i.severity === 'warning' ? '245,158,11' : '148,163,184'},0.1);border-left:3px solid ${i.severity === 'critical' ? '#e94560' : i.severity === 'warning' ? '#f59e0b' : '#94a3b8'};">
              <span style="font-size:0.7rem;font-weight:700;color:${i.severity === 'critical' ? '#e94560' : i.severity === 'warning' ? '#f59e0b' : '#94a3b8'};text-transform:uppercase;">${i.severity}</span>
              <span style="margin-left:8px;font-size:0.9rem;">${i.title}</span>
            </div>
          `).join('')}
          ${issues.length > 5 ? '<p style="font-size:0.85rem;color:var(--text-secondary);">+' + (issues.length - 5) + ' more issues found</p>' : ''}
        </div>
        ` : ''}
        <div style="text-align:center;padding-top:16px;border-top:1px solid var(--border);">
          <p style="font-size:0.95rem;color:var(--text-secondary);margin-bottom:16px;">${criticals > 0 ? 'You have <strong>' + criticals + ' critical issue' + (criticals > 1 ? 's' : '') + '</strong> that could result in a lawsuit.' : 'Your site has room for improvement.'} Shield fixes these for <strong>$97/mo</strong>.</p>
          <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
            <a href="/products/shield/" style="background:#e94560;color:#fff;padding:12px 24px;border-radius:10px;font-weight:700;text-decoration:none;box-shadow:0 4px 20px rgba(233,69,96,0.3);">Fix These Issues →</a>
            <a href="/pricing/" style="background:transparent;color:var(--text-secondary);padding:12px 24px;border-radius:10px;font-weight:600;text-decoration:none;border:1px solid var(--border);">See All Plans</a>
          </div>
        </div>
      `;
    } catch (err) {
      resultsDiv.innerHTML = '<p style="color:#e94560;text-align:center;">Scan failed. Please try again or <a href="/contact/" style="color:#e94560;">contact us</a>.</p>';
    } finally {
      submitBtn.textContent = origBtnText;
      submitBtn.disabled = false;
    }
  });
  </script>

</Layout>