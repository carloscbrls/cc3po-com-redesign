---
import Layout from '../layouts/Layout.astro';
import CaptureStrip from '../components/CaptureStrip.astro';
---

<Layout title="Get Started — CC3PO" description="Start your compliance and automation journey with CC3PO. Tell us about your business and we'll match you to the right plan.">

  <!-- Hero -->
  <section class="gs-hero" id="main-content">
    <div class="container">
      <span class="section-label">Get Started</span>
      <h1>Let's Protect &amp; Grow Your Business</h1>
      <p class="gs-hero-sub">Tell us about your business. We'll show you exactly how CC3PO can handle the work you don't have time for — compliance, automation, and IT, all on autopilot.</p>
      <div class="gs-trust-row">
        <div class="gs-trust-badge">
          <span class="gs-trust-icon">🛡️</span>
          <span>Trusted by Dr. Alan Lee, DDS</span>
        </div>
        <div class="gs-trust-badge">
          <span class="gs-trust-icon">✓</span>
          <span>Free compliance scan with every plan</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Intake Form -->
  <section class="gs-form-section" id="intake-form">
    <div class="container">
      <div class="gs-form-card">
        <h2>Tell Us About Your Business</h2>
        <p class="gs-form-sub">Fill out the form below and we'll reach out within 24 hours with a personalized recommendation.</p>

        <form id="gs-form" class="gs-form">
          <div class="gs-form-row">
            <div class="gs-form-group">
              <label for="gs-name">Full Name <span class="gs-required">*</span></label>
              <input type="text" id="gs-name" name="name" required placeholder="Jane Smith" autocomplete="name">
            </div>
            <div class="gs-form-group">
              <label for="gs-email">Email <span class="gs-required">*</span></label>
              <input type="email" id="gs-email" name="email" required placeholder="jane@practice.com" autocomplete="email">
            </div>
          </div>
          <div class="gs-form-row">
            <div class="gs-form-group">
              <label for="gs-phone">Phone</label>
              <input type="tel" id="gs-phone" name="phone" placeholder="(555) 123-4567" autocomplete="tel">
            </div>
            <div class="gs-form-group">
              <label for="gs-company">Company</label>
              <input type="text" id="gs-company" name="company" placeholder="Smith Dental Group" autocomplete="organization">
            </div>
          </div>
          <div class="gs-form-row">
            <div class="gs-form-group">
              <label for="gs-website">Website URL</label>
              <input type="url" id="gs-website" name="website" placeholder="https://smithdental.com" autocomplete="url">
            </div>
            <div class="gs-form-group">
              <label for="gs-service">Service Interest <span class="gs-required">*</span></label>
              <select id="gs-service" name="service_interest" required>
                <option value="">Select a service</option>
                <option value="compliance-monitoring">Compliance Monitoring</option>
                <option value="website-audit">Website Audit</option>
                <option value="hipaa-setup">HIPAA Setup</option>
                <option value="automation">Automation</option>
                <option value="full-service">Full Service</option>
              </select>
            </div>
          </div>
          <input type="hidden" name="source" value="cc3po.com-get-started">
          <input type="hidden" name="lead_type" value="contact">
          <button type="submit" class="gs-submit-btn" id="gs-submit">
            <span class="gs-btn-text">Get My Free Scan</span>
            <span class="gs-btn-loading" style="display:none">Submitting…</span>
          </button>
        </form>

        <div class="gs-form-success" id="gs-success" style="display:none">
          <div class="gs-success-icon">✓</div>
          <h3>You're In!</h3>
          <p>We'll review your info and reach out within 24 hours. In the meantime, pick your plan below to get started immediately.</p>
        </div>
        <div class="gs-form-error" id="gs-error" style="display:none">
          <div class="gs-error-icon">!</div>
          <h3>Something went wrong</h3>
          <p>Please try again or email us at <a href="mailto:hello@cc3po.com">hello@cc3po.com</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing CTA Cards -->
  <section class="gs-plans-section" id="plans">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Plans</span>
        <h2 class="section-title">Choose Your Plan</h2>
        <p class="section-desc">Every plan includes a free compliance scan. No contracts, cancel anytime.</p>
      </div>

      <div class="gs-plans-grid">
        <!-- Shield -->
        <div class="gs-plan-card">
          <div class="gs-plan-badge">Starter</div>
          <h3 class="gs-plan-name">Shield</h3>
          <div class="gs-plan-price">
            <span class="gs-plan-amount">$297</span>
            <span class="gs-plan-period">/month</span>
          </div>
          <p class="gs-plan-tagline">Always-on accessibility monitoring</p>
          <ul class="gs-plan-features">
            <li>✓ Monthly WCAG 2.2 AA scans</li>
            <li>✓ Instant violation alerts</li>
            <li>✓ Monthly PDF reports</li>
            <li>✓ Free compliance scan included</li>
          </ul>
          <a href="https://buy.stripe.com/bJecN53MFfiNfM5brH5os00" class="gs-plan-btn gs-plan-btn-essential" target="_blank" rel="noopener noreferrer">Start Shield</a>
        </div>

        <!-- Fortress -->
        <div class="gs-plan-card gs-plan-featured">
          <div class="gs-plan-badge gs-plan-badge-featured">Most Popular</div>
          <h3 class="gs-plan-name">Fortress</h3>
          <div class="gs-plan-price">
            <span class="gs-plan-amount">$447</span>
            <span class="gs-plan-period">/month</span>
          </div>
          <p class="gs-plan-tagline">Monitoring plus active fixes</p>
          <ul class="gs-plan-features">
            <li>✓ Everything in Shield</li>
            <li>✓ Daily scans + active fixes</li>
            <li>✓ Manual expert audits</li>
            <li>✓ HIPAA &amp; privacy checks</li>
            <li>✓ Priority support</li>
          </ul>
          <a href="https://buy.stripe.com/5kQ7sL5UNeeJ0RbgM15os01" class="gs-plan-btn gs-plan-btn-pro" target="_blank" rel="noopener noreferrer">Start Fortress</a>
        </div>

        <!-- Citadel -->
        <div class="gs-plan-card">
          <div class="gs-plan-badge">Regulated &amp; multi-site</div>
          <h3 class="gs-plan-name">Citadel</h3>
          <div class="gs-plan-price">
            <span class="gs-plan-period">Custom, from&nbsp;</span>
            <span class="gs-plan-amount">$897</span>
            <span class="gs-plan-period">/month</span>
          </div>
          <p class="gs-plan-tagline">Enterprise compliance for regulated businesses</p>
          <ul class="gs-plan-features">
            <li>✓ Everything in Fortress</li>
            <li>✓ Dedicated account manager</li>
            <li>✓ Multi-site management</li>
            <li>✓ Audit-ready documentation</li>
            <li>✓ Free compliance scan included</li>
          </ul>
          <a href="https://scheduler.zoom.us/carlos-cabrales-iii/compliance-consultation" class="gs-plan-btn gs-plan-btn-enterprise" target="_blank" rel="noopener noreferrer">Get a quote</a>
        </div>
      </div>
      <p style="text-align:center;margin-top:24px;color:var(--semantic-muted);font-size:0.95rem;">Need the top issues fixed once? <a href="https://buy.stripe.com/5kQ7sKa2L0wT6ovdBldjO03" style="color:var(--brand-accent);text-decoration:underline;">Fix Sprint — $495 one-time</a> · Not sure yet? <a href="https://scanner.cc3po.com/" style="color:var(--brand-accent);text-decoration:underline;">Get a free scan</a> or <a href="https://buy.stripe.com/14AfZg0sb5Rd14b0OzdjO00" style="color:var(--brand-accent);text-decoration:underline;">book a $100 Tech Strategy Call</a>. <a href="/pricing/" style="color:var(--brand-accent);text-decoration:underline;">See all pricing</a>.</p>

      <div class="gs-plans-trust">
        <div class="gs-trust-badge">
          <span class="gs-trust-icon">🛡️</span>
          <span>Trusted by Dr. Alan Lee, DDS</span>
        </div>
        <div class="gs-trust-badge">
          <span class="gs-trust-icon">✓</span>
          <span>Free compliance scan with every plan</span>
        </div>
        <div class="gs-trust-badge">
          <span class="gs-trust-icon">🔒</span>
          <span>No contracts — cancel anytime</span>
        </div>
      </div>
    </div>
  </section>

  <section style="padding:0 24px 32px;">
    <div class="legal-note" role="note" style="max-width:760px;margin:0 auto 32px;background:color-mix(in srgb, var(--brand-paper) 3%, transparent);border:1px solid var(--border);border-radius:12px;padding:16px 20px;font-size:0.85rem;line-height:1.6;color:var(--text-secondary);">
        <p style="margin:0 0 8px;"><strong>Not legal advice.</strong> CC3PO is not a law firm and does not provide legal advice. Our monitoring, fixes, and reports help reduce accessibility and privacy risk, but no service can guarantee compliance or prevent a claim. If you've received a demand letter, talk to a licensed attorney.</p>
        <p lang="es" style="margin:0;"><strong>No es asesoría legal.</strong> CC3PO no es un bufete de abogados y no ofrece asesoría legal. Nuestro monitoreo, correcciones e informes ayudan a reducir riesgos, pero ningún servicio puede garantizar el cumplimiento ni evitar un reclamo. Si recibió una carta de demanda, consulte a un abogado.</p>
      </div>
  </section>

  <!-- FAQ -->
  <CaptureStrip source="get-started" />

  <section class="gs-faq-section">
    <div class="container">
      <h2>Common Questions</h2>
      <div class="gs-faq-grid">
        <div class="gs-faq-item">
          <h3>What happens after I submit the form?</h3>
          <p>We review your info and reach out within 24 hours with a personalized recommendation. You can also start a plan immediately using the links above.</p>
        </div>
        <div class="gs-faq-item">
          <h3>Is the compliance scan really free?</h3>
          <p>Yes. Every plan — even before you commit — includes a free scan of your website for security, speed, and accessibility issues — plus HIPAA-related technical checks (like unencrypted patient forms) for healthcare sites.</p>
        </div>
        <div class="gs-faq-item">
          <h3>Can I cancel anytime?</h3>
          <p>Absolutely. All plans are month-to-month with no contracts and no cancellation fees. We earn your business every month.</p>
        </div>
        <div class="gs-faq-item">
          <h3>Do you work with dental and medical offices?</h3>
          <p>Yes — healthcare is our specialty. We build and manage websites for HIPAA-covered practices, alongside AI phone answering, automated reviews, and billing automation.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ===== Hero ===== */
  .gs-hero {
    background: linear-gradient(135deg, var(--brand-night) 0%, var(--brand-surface-dark) 50%, var(--brand-night) 100%);
    text-align: center;
    padding: 140px 24px 60px;
  }
  .gs-hero h1 {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    background: linear-gradient(135deg, var(--brand-paper), var(--brand-accent), var(--semantic-info));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 16px;
    letter-spacing: -1px;
  }
  .gs-hero-sub {
    font-size: 18px;
    color: var(--semantic-muted);
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .gs-trust-row {
    display: flex;
    gap: 20px;
    justify-content: center;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .gs-trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--brand-paper) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand-paper) 8%, transparent);
    border-radius: 100px;
    padding: 10px 20px;
    font-size: 14px;
    color: var(--semantic-muted);
    font-weight: 500;
  }
  .gs-trust-icon {
    font-size: 16px;
    color: var(--semantic-success);
  }

  /* ===== Form Section ===== */
  .gs-form-section {
    padding: 60px 0;
    background: var(--brand-night);
  }
  .gs-form-card {
    max-width: 640px;
    margin: 0 auto;
    background: var(--brand-surface-dark);
    border: 1px solid var(--brand-surface-dark);
    border-radius: 16px;
    padding: 40px;
  }
  .gs-form-card h2 {
    color: var(--brand-paper);
    font-size: 28px;
    font-weight: 800;
    margin-bottom: 8px;
  }
  .gs-form-sub {
    color: var(--semantic-muted);
    font-size: 15px;
    margin-bottom: 28px;
    line-height: 1.5;
  }
  .gs-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .gs-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 600px) {
    .gs-form-row { grid-template-columns: 1fr; }
    .gs-form-card { padding: 24px; }
  }
  .gs-form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .gs-form-group label {
    font-size: 14px;
    color: var(--semantic-muted);
    font-weight: 500;
  }
  .gs-required { color: var(--accent); }
  .gs-form-group input,
  .gs-form-group select {
    background: var(--brand-night);
    border: 1px solid var(--brand-surface-dark);
    border-radius: 8px;
    padding: 12px 16px;
    color: var(--brand-paper);
    font-size: 15px;
    transition: border-color 0.2s;
  }
  .gs-form-group input:focus,
  .gs-form-group select:focus {
    outline: 2px solid var(--brand-accent); outline-offset: 2px;
    border-color: var(--brand-accent);
  }
  .gs-form-group input::placeholder {
    color: var(--brand-silver);
  }
  .gs-submit-btn {
    background: linear-gradient(135deg, var(--brand-accent), var(--semantic-info));
    color: var(--brand-paper);
    padding: 14px 32px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    margin-top: 8px;
  }
  .gs-submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 20px color-mix(in srgb, var(--brand-accent) 40%, transparent);
  }
  .gs-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  /* Success / Error */
  .gs-form-success, .gs-form-error {
    text-align: center;
    padding: 32px;
  }
  .gs-success-icon, .gs-error-icon {
    width: 48px; height: 48px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; margin: 0 auto 16px;
    font-weight: 700;
  }
  .gs-success-icon { background: var(--semantic-success); color: var(--brand-paper); }
  .gs-error-icon { background: var(--semantic-danger); color: var(--brand-paper); }
  .gs-form-success h3, .gs-form-error h3 {
    color: var(--brand-paper); font-size: 22px; margin-bottom: 8px;
  }
  .gs-form-success p, .gs-form-error p {
    color: var(--semantic-muted); line-height: 1.6;
  }
  .gs-form-error a { color: var(--semantic-info); }

  /* ===== Plans Section ===== */
  .gs-plans-section {
    padding: 80px 0;
    background: var(--brand-night);
  }
  .gs-plans-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  @media (max-width: 900px) {
    .gs-plans-grid { grid-template-columns: 1fr; max-width: 440px; margin-left: auto; margin-right: auto; }
  }

  .gs-plan-card {
    background: var(--brand-surface-dark);
    border: 1px solid var(--brand-surface-dark);
    border-radius: 16px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .gs-plan-card:hover {
    border-color: color-mix(in srgb, var(--brand-accent) 30%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--brand-night) 40%, transparent);
  }
  .gs-plan-featured {
    border-color: var(--brand-accent);
    box-shadow: 0 0 40px color-mix(in srgb, var(--brand-accent) 15%, transparent);
  }
  .gs-plan-featured:hover {
    border-color: var(--brand-accent);
  }
  .gs-plan-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--semantic-muted);
    background: color-mix(in srgb, var(--brand-paper) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand-paper) 10%, transparent);
    border-radius: 100px;
    padding: 4px 14px;
    margin-bottom: 16px;
    width: fit-content;
  }
  .gs-plan-badge-featured {
    color: var(--brand-accent);
    background: color-mix(in srgb, var(--brand-accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--brand-accent) 30%, transparent);
  }
  .gs-plan-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--brand-paper);
    margin-bottom: 8px;
  }
  .gs-plan-price {
    margin-bottom: 12px;
  }
  .gs-plan-amount {
    font-size: 40px;
    font-weight: 800;
    color: var(--brand-paper);
  }
  .gs-plan-period {
    font-size: 16px;
    color: var(--semantic-muted);
  }
  .gs-plan-tagline {
    color: var(--semantic-muted);
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .gs-plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .gs-plan-features li {
    font-size: 14px;
    color: var(--brand-paper);
    line-height: 1.5;
  }
  .gs-plan-btn {
    display: block;
    text-align: center;
    padding: 14px 24px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    margin-top: auto;
  }
  .gs-plan-btn:hover {
    transform: translateY(-1px);
  }
  .gs-plan-btn-essential {
    background: linear-gradient(135deg, var(--brand-navy), var(--brand-navy));
    color: var(--brand-paper);
    border: 1px solid color-mix(in srgb, var(--brand-navy) 50%, transparent);
  }
  .gs-plan-btn-essential:hover {
    box-shadow: 0 4px 20px color-mix(in srgb, var(--brand-navy) 50%, transparent);
  }
  .gs-plan-btn-pro {
    background: linear-gradient(135deg, var(--brand-accent), var(--semantic-info));
    color: var(--brand-paper);
  }
  .gs-plan-btn-pro:hover {
    box-shadow: 0 4px 20px color-mix(in srgb, var(--brand-accent) 40%, transparent);
  }
  .gs-plan-btn-enterprise {
    background: linear-gradient(135deg, var(--brand-gold), var(--brand-gold));
    color: var(--brand-night);
  }
  .gs-plan-btn-enterprise:hover {
    box-shadow: 0 4px 20px color-mix(in srgb, var(--brand-gold) 40%, transparent);
  }

  /* Plans trust row */
  .gs-plans-trust {
    display: flex;
    gap: 20px;
    justify-content: center;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  /* ===== FAQ ===== */
  .gs-faq-section {
    padding: 60px 0;
    background: var(--brand-night);
  }
  .gs-faq-section h2 {
    color: var(--brand-paper);
    font-size: 32px;
    text-align: center;
    margin-bottom: 40px;
    font-weight: 800;
  }
  .gs-faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 768px) {
    .gs-faq-grid { grid-template-columns: 1fr; }
  }
  .gs-faq-item {
    background: var(--brand-surface-dark);
    border: 1px solid var(--brand-surface-dark);
    border-radius: 12px;
    padding: 24px;
  }
  .gs-faq-item h3 {
    color: var(--brand-paper);
    font-size: 17px;
    margin-bottom: 8px;
    font-weight: 700;
  }
  .gs-faq-item p {
    color: var(--semantic-muted);
    font-size: 15px;
    line-height: 1.6;
  }
  /* Mobile QA (2026-11-24): form fields at 16px stop iOS zoom-on-focus */
  @media (max-width: 768px) {
    .gs-form input, .gs-form select, .gs-form textarea { font-size: 16px !important; }
  }
</style>

<script>
const form = document.getElementById('gs-form');
const submitBtn = document.getElementById('gs-submit');
const successMsg = document.getElementById('gs-success');
const errorMsg = document.getElementById('gs-error');

form?.addEventListener('submit', async (e) => {
  e.preventDefault();

  const btnText = submitBtn.querySelector('.gs-btn-text');
  const btnLoading = submitBtn.querySelector('.gs-btn-loading');
  btnText.style.display = 'none';
  btnLoading.style.display = 'inline';
  submitBtn.disabled = true;

  try {
    const formData = new FormData(form);
    const email = formData.get('email');
    const name = formData.get('name');
    const phone = formData.get('phone');
    const company = formData.get('company');
    const website = formData.get('website');
    const service = formData.get('service_interest');

    // Store the full intake as a lead in Supabase (same pipeline as the contact form)
    const res = await fetch('https://cdrcgmdvepxwsbqaifxv.supabase.co/rest/v1/leads', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'apikey': 'sb_publishable_dNkzT9Le1oI0oSIZ9U_QFQ_6o4P6jIY',
        'Prefer': 'return=minimal'
      },
      body: JSON.stringify({
        name,
        email,
        phone: phone || '',
        company: company || '',
        website: website || '',
        service_interest: service || '',
        source: 'cc3po.com-get-started',
        lead_type: 'contact'
      })
    });

    // Also scan the website if provided
    if (website) {
      fetch('https://scanner.cc3po.com/api/scan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: website, email })
      }).catch(() => {}); // fire and forget
    }

    if (res.ok) {
      form.style.display = 'none';
      successMsg.style.display = 'block';
    } else {
      throw new Error('Submission failed');
    }
  } catch (err) {
    form.style.display = 'none';
    errorMsg.style.display = 'block';
  }
});

// Handle Stripe checkout success redirect
(function() {
  const params = new URLSearchParams(window.location.search);
  if (params.get('checkout') === 'success') {
    const plan = params.get('plan') || 'shield';
    const form = document.getElementById('gs-form');
    const successMsg = document.getElementById('gs-success');
    if (form && successMsg) {
      form.style.display = 'none';
      successMsg.style.display = 'block';
      successMsg.innerHTML = `
        <div class=\"gs-success-icon\">✓</div>
        <h3>Welcome to ${plan.charAt(0).toUpperCase() + plan.slice(1)}!</h3>
        <p>Your subscription is active. Check your email for your compliance scan link and onboarding details. Your dashboard is at <a href=\"https://comply.cc3po.com\" style=\"color:#00e676;text-decoration:underline;\">comply.cc3po.com</a>.</p>
      `;
    }
  }
})();
</script>