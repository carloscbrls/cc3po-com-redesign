  <script is:inline>
    // ===== SET MORNING DATE =====
    const dateEl = document.getElementById('morning-date');
    if (dateEl) { const now = new Date(); dateEl.textContent = now.toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric' }); }

    // ===== SMOOTH SCROLL OFFSET =====
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const target = document.querySelector(this.getAttribute('href'));
        if (target) { e.preventDefault(); const offset=64; const top = target.getBoundingClientRect().top + window.pageYOffset - offset; window.scrollTo({ top, behavior:'smooth' }); }
      });
    });

    // ===== BUTTON LOADING =====
    document.querySelectorAll('form').forEach(form => {
      form.addEventListener('submit', () => { const btn=form.querySelector('button[type="submit"]'); if(btn){ btn.classList.add('is-loading'); btn.style.position='relative'; } });
    });

    // ===== HERO CANVAS: Constellation Network =====
    const canvas = document.getElementById('hero-canvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      let w, h, particles=[], mouse={x:-1000,y:-1000};
      function resize(){ w=canvas.width=canvas.offsetWidth; h=canvas.height=canvas.offsetHeight; }
      resize(); window.addEventListener('resize', resize);
      document.addEventListener('mousemove', e=>{ mouse.x=e.clientX; mouse.y=e.clientY; });
      class Particle { constructor(){ this.reset(); } reset(){ this.x=Math.random()*w; this.y=Math.random()*h; this.vx=(Math.random()-0.5)*0.3; this.vy=(Math.random()-0.5)*0.3; this.r=Math.random()*1.5+0.5; this.color=['#10b981','#d4af37','#4fc3f7','#ffd700','#e8506b'][Math.floor(Math.random()*5)]; }
        update(){ this.x+=this.vx; this.y+=this.vy; if(this.x<0||this.x>w)this.vx*=-1; if(this.y<0||this.y>h)this.vy*=-1; const dx=this.x-mouse.x,dy=this.y-mouse.y; const dist=Math.sqrt(dx*dx+dy*dy); if(dist<120){ this.x+=dx*0.01; this.y+=dy*0.01; } }
        draw(){ ctx.beginPath(); ctx.arc(this.x,this.y,this.r,0,Math.PI*2); ctx.fillStyle=this.color; ctx.globalAlpha=0.6; ctx.fill(); }
      }
      const count = Math.min(80, Math.floor(w*h/12000));
      for(let i=0;i<count;i++) particles.push(new Particle());
      let animating=true;
      const canvasObserver = new IntersectionObserver(([e])=>{ animating=e.isIntersecting; if(animating)animate(); }, {threshold:0});
      canvasObserver.observe(canvas);
      function animate(){ if(!animating)return; ctx.clearRect(0,0,w,h); particles.forEach(p=>{p.update();p.draw();}); ctx.globalAlpha=0.08; ctx.strokeStyle='#10b981'; ctx.lineWidth=0.5; for(let i=0;i<particles.length;i++){ for(let j=i+1;j<particles.length;j++){ const dx=particles[i].x-particles[j].x, dy=particles[i].y-particles[j].y, d=dx*dx+dy*dy; if(d<15000){ ctx.globalAlpha=0.06*(1-d/15000); ctx.beginPath(); ctx.moveTo(particles[i].x,particles[i].y); ctx.lineTo(particles[j].x,particles[j].y); ctx.stroke(); } } } ctx.globalAlpha=1; requestAnimationFrame(animate); }
      animate();
    }

    // ===== SCROLL REVEAL =====
    const revealEls = document.querySelectorAll('.reveal');
    revealEls.forEach(el => el.classList.add('reveal-out'));
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => { if(entry.isIntersecting){ entry.target.classList.add('revealed'); entry.target.classList.remove('reveal-out'); revealObserver.unobserve(entry.target); } });
    }, { threshold:0.05, rootMargin:'0px 0px -20px 0px' });
    revealEls.forEach(el => revealObserver.observe(el));
    const heroEls = document.querySelectorAll('.lux-hero .reveal');
    setTimeout(() => { heroEls.forEach(el => { if(!el.classList.contains('revealed')){ el.classList.add('revealed'); el.classList.remove('reveal-out'); } }); }, 200);

