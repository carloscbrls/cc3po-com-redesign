---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CC3PO — We Keep Your Business Legally Protected">
  <!-- ====== HERO ====== -->
  <section class="hero" id="main-content" id="hero">
    <video class="hero-video" autoplay loop muted playsinline aria-label="Animated network visualization background">
      <source src="/videos/hero-network.webm" type="video/webm">
      <source src="/videos/hero-network.mp4" type="video/mp4">
    </video>
    <button class="video-pause-btn" id="video-pause-btn" aria-label="Pause background video" title="Pause video" style="position:absolute;top:12px;right:12px;background:rgba(0,0,0,0.5);color:#fff;border:none;border-radius:50%;width:32px;height:32px;cursor:pointer;z-index:10;font-size:14px;opacity:0.6;transition:opacity 0.2s;">⏸</button>
    <canvas id="hero-canvas"></canvas>
    <div class="hero-content">
      <div class="hero-badge reveal">
        <span class="pulse-dot"></span>
        Compliance · Monitoring · Protection — 24/7
      </div>

      <h1 class="hero-title reveal">
        We keep your business<br>legally protected.
      </h1>

      <p class="hero-sub reveal">
        ADA compliance, website monitoring, review management, and social — all running 24/7 so you're never caught off guard.
      </p>
      <p class="hero-location hide-mobile">Based in Lathrop, CA — Serving San Joaquin County &amp; All 58 California Counties</p>

      <!-- Mobile: Single CTA button (form is below the fold) -->
      <div class="hero-cta-mobile show-mobile-only reveal">
        <a href="#cta" class="btn btn-primary btn-glow" style="width:100%;max-width:320px;justify-content:center;font-size:16px;">
          🔍 Scan My Business — Free
        </a>
        <p style="margin-top:8px;color:var(--text-muted);font-size:0.75rem;text-align:center;">30 seconds · No credit card</p>
        <a href="#morning-report" class="scroll-hint" style="display:block;text-align:center;margin-top:16px;color:var(--text-muted);font-size:0.8rem;text-decoration:none;">
          ▼ See how it works
        </a>
      </div>

      <!-- Desktop: Full lead capture form -->
      <div class="lead-form-wrap reveal hide-mobile-form" id="lead-form">
        <div class="lead-form-title">Get Your Free Business Scan</div>
        <div class="lead-form-sub">No credit card. 30 seconds. See where you stand.</div>
        <form class="lead-form" id="hero-lead-form" novalidate>
          <div class="form-group">
            <label for="lf-name">Name</label>
            <input type="text" id="lf-name" name="name" required placeholder="Your name" />
          </div>
          <div class="form-group">
            <label for="lf-email">Email</label>
            <input type="email" id="lf-email" name="email" required placeholder="you@yourbusiness.com" />
          </div>
          <div class="form-group">
            <label for="lf-website">Website URL</label>
            <input type="url" id="lf-website" name="website" placeholder="https://yourbusiness.com" />
          </div>
          <div class="form-group full">
            <label for="lf-need">What do you need help with?</label>
            <select id="lf-need" name="need">
              <option value="">Select an option…</option>
              <option value="website">Website</option>
              <option value="social-media">Social Media</option>
              <option value="reviews">Reviews</option>
              <option value="compliance">Compliance</option>
              <option value="all">All of the above</option>
            </select>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-glow" style="position:relative">
              <span class="btn-icon">🔍</span> Scan My Business — Free
            </button>
          </div>
          <div class="form-message" id="lf-message"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- ====== TRUST BAR ====== -->
  <section class="trust-bar" style="background: var(--bg-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 16px 0;">
    <div class="container" style="display: flex; align-items: center; justify-content: center; gap: 32px; flex-wrap: wrap; text-align: center;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #ffd700; font-size: 18px;">🏛️</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">CA Certified Small Business</span>
        <span style="color: var(--text-muted); font-size: 12px;">SB #2052063</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #e94560; font-size: 18px;">🌎</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">Latino-Owned Business</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #4fc3f7; font-size: 18px;">🛡️</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">SB/DVBE Option Eligible</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #00e676; font-size: 18px;">🌐</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">Se habla español</span>
      </div>
    </div>
  </section>

  <!-- ====== MORNING REPORT ====== -->
  <section class="section" id="morning-report">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">What You Wake Up To</div>
        <h2 class="section-title">Every morning, your compliance status is waiting.</h2>
        <p class="section-desc">No dashboards to check. No reports to run. Just open your phone and see if you're legally protected.</p>
      </div>

      <div class="morning-report-card reveal">
        <div class="morning-report-header">
          <span class="morning-greeting">☀️ Good morning.</span>
          <span class="morning-date" id="morning-date"></span>
        </div>
        <div class="morning-report-subtitle">Your business ran great overnight.</div>
        <div class="morning-report-items">
          <div class="morning-item">
            <span class="morning-check">✅</span>
            <div class="morning-item-content">
              <span class="morning-item-title">Website</span>
              <span class="morning-item-desc">Plugin conflict fixed at 2:14 AM</span>
            </div>
          </div>
          <div class="morning-item">
            <span class="morning-check">✅</span>
            <div class="morning-item-content">
              <span class="morning-item-title">Reviews</span>
              <span class="morning-item-desc">3 responded to professionally</span>
            </div>
          </div>
          <div class="morning-item">
            <span class="morning-check">✅</span>
            <div class="morning-item-content">
              <span class="morning-item-title">Social</span>
              <span class="morning-item-desc">2 posts published on schedule</span>
            </div>
          </div>
          <div class="morning-item">
            <span class="morning-check">✅</span>
            <div class="morning-item-content">
              <span class="morning-item-title">Compliance</span>
              <span class="morning-item-desc">Up to date — new law already handled</span>
            </div>
          </div>
          <div class="morning-item">
            <span class="morning-check">✅</span>
            <div class="morning-item-content">
              <span class="morning-item-title">Competitor</span>
              <span class="morning-item-desc">Price drop detected — recommendation ready</span>
            </div>
          </div>
        </div>
        <div class="morning-score">
          <div class="morning-score-label">Business Health Score</div>
          <div class="morning-score-value">
            <span class="morning-score-num">87</span><span class="morning-score-max">/100</span>
          </div>
          <div class="morning-score-change">↑ 14 from last month</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== MEET YOUR TEAM ====== -->
  <section class="section" id="team" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Your Team</div>
        <h2 class="section-title">Meet the people who never sleep.</h2>
        <p class="section-desc">24 specialists. Real faces. Real expertise. Each one owns their domain.</p>
      </div>

      <div class="team-grid reveal">
        <a href="/village/carlos/" class="team-card team-card-portrait">
          <img src="/images/authors/carlos.png" alt="Carlos" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Carlos 🧑🏽‍💻</div>
            <div class="team-role">Founder & Builder</div>
            <p class="team-desc">Built the village because people deserve better tools. Still up at 2am fixing things.</p>
          </div>
        </a>
        <a href="/village/atlas/" class="team-card team-card-portrait">
          <img src="/images/authors/atlas.png" alt="Atlas" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Atlas 🌍</div>
            <div class="team-role">Systems Coordinator</div>
            <p class="team-desc">Carries the weight of the village so your systems never break.</p>
          </div>
        </a>
        <a href="/village/sentinel/" class="team-card team-card-portrait">
          <img src="/images/authors/sentinel.png" alt="Sentinel" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Sentinel 🛡️</div>
            <div class="team-role">Compliance Guardian</div>
            <p class="team-desc">Already checked the exits. Keeps you legal and accessible.</p>
          </div>
        </a>
        <a href="/village/forge/" class="team-card team-card-portrait">
          <img src="/images/authors/forge.png" alt="Forge" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Forge ⚒️</div>
            <div class="team-role">Automation Engineering</div>
            <p class="team-desc">If it's manual, it's broken. Builds systems that run themselves.</p>
          </div>
        </a>
        <a href="/village/weaver/" class="team-card team-card-portrait">
          <img src="/images/authors/weaver.png" alt="Weaver" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Weaver 🕸️</div>
            <div class="team-role">Content & Strategy</div>
            <p class="team-desc">Every story is a thread. She finds the ones worth weaving.</p>
          </div>
        </a>
        <a href="/village/spark/" class="team-card team-card-portrait">
          <img src="/images/authors/spark.png" alt="Spark" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Spark ✨</div>
            <div class="team-role">Social & Engagement</div>
            <p class="team-desc">Walks into a room and the energy shifts. Your brand's voice on every platform.</p>
          </div>
        </a>
        <a href="/village/leo/" class="team-card team-card-portrait">
          <img src="/images/authors/leo.png" alt="Leo" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Leo 🦁</div>
            <div class="team-role">Email & Outreach</div>
            <p class="team-desc">Every email is a handshake. Direct, warm, and impossible to ignore.</p>
          </div>
        </a>
        <a href="/village/mirror/" class="team-card team-card-portrait">
          <img src="/images/authors/mirror.png" alt="Mirror" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Mirror 🪞</div>
            <div class="team-role">Reviews & Reputation</div>
            <p class="team-desc">The signal is always in the noise. Protects your reputation in real time.</p>
          </div>
        </a>
        <a href="/village/apollo/" class="team-card team-card-portrait">
          <img src="/images/authors/apollo.png" alt="Apollo" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Apollo 🔍</div>
            <div class="team-role">Deep Research</div>
            <p class="team-desc">Doesn't stop at the first answer. Finds what others miss.</p>
          </div>
        </a>
      </div>

      <p class="reveal" style="text-align:center;margin-top:32px;"><a href="/village/" style="color:var(--accent);font-size:1rem;font-weight:600;text-decoration:none;border-bottom:1px solid var(--accent);">See all 24 team members →</a></p>
    </div>
  </section>

  <!-- ====== BEFORE / AFTER ====== -->
  <section class="section" id="before-after">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">The Difference</div>
        <h2 class="section-title">Your day. With and without.</h2>
      </div>

      <div class="before-after-split reveal">
        <div class="ba-column ba-without">
          <div class="ba-column-title">⚠️ Without CC3PO</div>
          <div class="ba-column-items">
            <div class="ba-line-item">
              <span class="ba-line-icon">😰</span>
              <span>Website breaks — you find out from an angry customer</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">😠</span>
              <span>Bad review sits unanswered for days</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">📅</span>
              <span>Should post on social media — forgot again</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">📋</span>
              <span>New accessibility law? Now you're exposed to $4K+ per violation</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">😪</span>
              <span>11 PM — still checking reviews</span>
            </div>
          </div>
        </div>
        <div class="ba-column ba-with">
          <div class="ba-column-title">✅ With CC3PO</div>
          <div class="ba-column-items">
            <div class="ba-line-item">
              <span class="ba-line-icon">🛡️</span>
              <span>Website: fixed a problem at 2 AM</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">💬</span>
              <span>Reviews: 3 responded to in 30 minutes</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">📱</span>
              <span>Social: 2 posts went out automatically</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">✅</span>
              <span>Compliance: WCAG 2.2 AA — already up to date</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">😴</span>
              <span>Sleep great — business ran overnight</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== HOW IT WORKS ====== -->
  <section class="section how-section" id="how-it-works" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">How It Works</div>
        <h2 class="section-title">Three steps. Better business.</h2>
      </div>

      <div class="workflow-steps">
        <div class="workflow-step reveal">
          <div class="step-connector"></div>
          <div class="step-number">01</div>
          <div class="step-content">
            <div class="step-icon">📋</div>
            <h3>Tell us about your business</h3>
            <p>Answer a few questions. We learn your industry, your goals, your customers.</p>
          </div>
        </div>
        <div class="workflow-step reveal">
          <div class="step-connector"></div>
          <div class="step-number">02</div>
          <div class="step-content">
            <div class="step-icon">🤖</div>
            <h3>Your team gets to work</h3>
            <p>Your website is watched. Your reviews are answered. Your content is created. Your compliance is handled. 24/7.</p>
          </div>
        </div>
        <div class="workflow-step reveal">
          <div class="step-connector"></div>
          <div class="step-number">03</div>
          <div class="step-content">
            <div class="step-icon">☀️</div>
            <h3>Wake up to a better business</h3>
            <p>Every morning, check your Business Health Score. It goes up every month.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== COMPARISON TABLE ====== -->
  <section class="section" id="comparison">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">The Math</div>
        <h2 class="section-title">What it costs to hire separately vs. CC3PO.</h2>
      </div>

      <div class="comparison-table-wrap reveal">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Hire Separately</th>
              <th>Cost/mo</th>
              <th>CC3PO</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Web developer</td>
              <td class="cost-cell">$5,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Social media manager</td>
              <td class="cost-cell">$3,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>SEO consultant</td>
              <td class="cost-cell">$2,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Compliance officer</td>
              <td class="cost-cell">$4,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr class="total-row">
              <td><strong>Total</strong></td>
              <td class="cost-cell"><strong>$14,000/mo</strong></td>
              <td class="included-cell"><strong>Starting at $497/mo</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ====== TESTIMONIALS ====== -->
  <section class="section" id="proof">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Proof</div>
        <h2 class="section-title">Real businesses. Real results.</h2>
      </div>
      <div class="testimonials-grid reveal">
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"I used to spend 3 hours a day managing reviews and social media. Now I wake up and it's all done. My Business Health Score went from 52 to 87 in two months."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Dr. Alan Lee</div>
            <div class="testimonial-role">Sunrise Dental, Stockton CA</div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"The compliance scanning alone is worth it. We had 14 ADA violations we didn't know about. Sentinel found them, fixed them, and now we're clean. That would've been a $4,000 fine per violation."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Matt Safdari</div>
            <div class="testimonial-role">Top Class Fitness, Modesto CA</div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"I was skeptical about AI running my business. Then I got my first morning report and realized — they actually did everything while I slept. My Google reviews went from 3.2 to 4.7 stars."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Julius Jones</div>
            <div class="testimonial-role">Central Valley Auto, Lathrop CA</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== NEWSLETTER ====== -->
  <section class="section" id="newsletter" style="background:var(--bg-secondary);">
    <div class="container">
      <div class="reveal" style="text-align:center;max-width:600px;margin:0 auto;">
        <div class="section-label">Stay in the loop</div>
        <h2 class="section-title" style="font-size:clamp(1.5rem,3vw,2rem);">Get the Signal. Free business insights, every week.</h2>
        <p style="color:var(--text-muted);margin-bottom:24px;">AI automation strategies, compliance updates, and tips for growing your business. No spam. Unsubscribe anytime.</p>
        <form class="newsletter-form" id="newsletter-form" style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
          <label for="newsletter-email" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">Email address</label>
          <input type="email" id="newsletter-email" name="email" placeholder="Your email address" required style="flex:1;min-width:240px;padding:14px 18px;background:var(--bg);border:1px solid var(--border);border-radius:12px;color:#fff;font-size:1rem;font-family:var(--font);">
          <button type="submit" class="btn btn-primary btn-glow">Get the Signal →</button>
        </form>
        <p id="newsletter-message" style="margin-top:12px;font-size:0.85rem;color:var(--accent);display:none;"></p>
        <p style="margin-top:8px;font-size:0.75rem;color:var(--text-muted);">Join 1,000+ business owners. Unsubscribe anytime.</p>
      </div>
    </div>
  </section>

  <!-- ====== CTA ====== -->
  <section class="cta-section" id="cta">
    <div class="container cta-content">
      <div class="reveal">
        <h2>Your compliance status is waiting.</h2>
        <p>Find out where you stand — free, in 30 seconds. See your legal risk. No sales pitch.</p>
        <!-- Bottom Lead Form -->
        <div class="bottom-cta-form reveal" id="bottom-lead-form-wrap">
          <form class="lead-form" id="bottom-lead-form" novalidate>
            <div class="form-group">
              <label for="blf-name">Name</label>
              <input type="text" id="blf-name" name="name" required placeholder="Your name" />
            </div>
            <div class="form-group">
              <label for="blf-email">Email</label>
              <input type="email" id="blf-email" name="email" required placeholder="you@yourbusiness.com" />
            </div>
            <div class="form-group">
              <label for="blf-website">Website URL</label>
              <input type="url" id="blf-website" name="website" placeholder="https://yourbusiness.com" />
            </div>
            <div class="form-group full">
              <label for="blf-need">What do you need help with?</label>
              <select id="blf-need" name="need">
                <option value="">Select an option…</option>
                <option value="website">Website</option>
                <option value="social-media">Social Media</option>
                <option value="reviews">Reviews</option>
                <option value="compliance">Compliance</option>
                <option value="all">All of the above</option>
              </select>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary btn-glow" style="position:relative">
                <span class="btn-icon">🔍</span> Scan My Business — Free
              </button>
              <a href="https://cc3po.io/strategy-call" class="btn btn-secondary" target="_blank" rel="noopener">
                <span class="btn-icon">📞</span> Strategy Call
              </a>
            </div>
            <div class="form-message" id="blf-message"></div>
          </form>
        </div>
        <div class="cta-trust" style="margin-top:24px;">
          <span>✓ No credit card</span>
          <span>✓ 30-second scan</span>
          <span>✓ Real recommendations</span>
          <span>✓ Lawsuit protection starts today</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
