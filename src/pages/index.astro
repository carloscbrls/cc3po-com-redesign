---
import Layout from '../layouts/Layout.astro';
import HeroOps from '../components/HeroOps.astro';
import OpsPanel from '../components/OpsPanel.astro';
import TrustBand from '../components/TrustBand.astro';
import ShieldBand from '../components/ShieldBand.astro';
import VignetteFeed from '../components/VignetteFeed.astro';
import CardGrid from '../components/CardGrid.astro';
import PricingStrip from '../components/PricingStrip.astro';
import CTAClose from '../components/CTAClose.astro';

/* Command Center (Nightshift) homepage — Shift Change #1, 2026-11-24.
   Layout/visual rebuild to Direction A. ALL copy below is the live
   page's own copy, verbatim; the Figma frame only set the grammar. */

const opsRows = [
  { time: '02:14 AM', name: 'Atlas', role: 'Infrastructure Architect', message: '"Plugin conflict detected on your site. Assigning to Sentinel for the compliance check, then I\'ll patch the server."', chip: 'Running' },
  { name: 'Sentinel', role: 'Compliance Sentinel', message: '"Nightly WCAG scan finished — every finding goes straight onto the fix list. New CA law flagged, already drafted the fix list for Axecessor."', chip: 'Passed' },
  { name: 'Leo', role: 'Outreach Architect', message: '"3 reviews responded to professionally. Warm follow-up scheduled for tomorrow 9 AM. No cold handshakes here."', chip: '3 Done', chipTone: 'gold' as const },
];

const vignettes = [
  { time: '02:14 AM', portrait: '/images/authors/atlas.webp', alt: 'Atlas', name: 'Atlas 🌍', role: 'Infrastructure Architect', message: '"Plugin conflict detected on your site. Assigning to Sentinel for the compliance check, then I\'ll patch the server."', tag: 'Running', meta: 'Infrastructure', lead: true },
  { portrait: '/images/authors/sentinel.webp', alt: 'Sentinel', name: 'Sentinel', role: 'Compliance Sentinel', message: '"Nightly WCAG scan finished — every finding goes straight onto the fix list. New CA law flagged, already drafted the fix list for Axecessor."', tag: 'Compliance', meta: 'Passed' },
  { portrait: '/images/authors/leo.webp', alt: 'Leo', name: 'Leo', role: 'Outreach Architect', message: '"3 reviews responded to professionally. Warm follow-up scheduled for tomorrow 9 AM. No cold handshakes here."', tag: 'Reviews', meta: '3 Done' },
  { portrait: '/images/authors/alexandria.webp', alt: 'Alexandria', name: 'Alexandria', role: 'Knowledge', message: '"Two posts published on schedule. Blog drafted and sent to Spark for the voice pass."', tag: 'Content', tagTone: 'gold' as const, meta: 'Published' },
  { portrait: '/images/authors/carlos.webp', alt: 'Carlos', name: 'Carlos', role: 'Founder & Conductor', message: '"The village runs itself now. My job is the vision — and making sure every small business gets this team."', tag: 'Oversight', tagTone: 'gold' as const, meta: 'Human First', conductor: true },
];

const trustItems = [
  { strong: 'CA Certified Small Business', detail: 'SB #2052063' },
  { strong: 'Latino-Owned Business' },
  { strong: 'SB/DVBE Option Eligible' },
  { strong: 'Se habla español' },
];

const steps = [
  { kicker: '01', icon: '📋', title: 'Tell us about your business', body: 'Answer a few questions. The village learns your industry, your goals, your customers.' },
  { kicker: '02', icon: '🤖', title: 'The village gets to work', body: 'Your website is watched, your reviews answered, your content created, your compliance handled. 24/7, together.' },
  { kicker: '03', icon: '☀️', title: 'Wake up to a better business', body: 'Every morning, check your Business Health Score. The village makes it go up every month.' },
];

const priceRows = [
  { label: 'Web developer', cost: '$5,000', included: 'Included' },
  { label: 'IT support', cost: '$2,000', included: 'Included' },
  { label: 'Compliance officer', cost: '$4,000', included: 'Included' },
  { label: 'Phone system & AI receptionist', cost: '$3,000', included: 'Included' },
  { label: 'Social media manager', cost: '$3,000', included: 'Included' },
  { label: 'SEO consultant', cost: '$2,000', included: 'Included' },
];

const testimonials = [
  { stars: '★★★★★', text: '"I used to spend 3 hours a day managing reviews and social media. Now I wake up and the village has done it all. My Business Health Score went from 52 to 87 in two months."', name: 'Dr. Alan Lee', role: 'Alan Lee DDS, Manteca CA' },
  { stars: '★★★★★', text: '"The compliance scanning alone is worth it. We had 14 ADA violations we didn\'t know about. Sentinel found them, fixed them, and now we\'re clean. That would\'ve been a $4,000 fine per violation."', name: 'Matt Safdari', role: 'Top Class Fitness, Modesto CA' },
  { stars: '★★★★★', text: '"I was skeptical about AI running my business. Then I got my first morning report and realized — they actually did everything while I slept. My Google reviews went from 3.2 to 4.7 stars."', name: 'Julius Jones', role: 'Central Valley Auto, Lathrop CA' },
];
---

<Layout title="CC3PO — The AI Village That Runs Your Business" description="CC3PO — a team of AI agents that runs your business: compliance monitoring, website management, IT support, AI automation, and phone systems. One team, 24/7.">
  <!-- ============================================================
       CC3PO.com — Command Center (Nightshift) · Shift Change #1
       Night/navy + gold · The Village Working Together
  ============================================================ -->

  <HeroOps
    eyebrow="A Village of AI Specialists · Working for You, 24/7"
    titleLead="The Village that"
    titleAccent="runs your business."
    sub="Compliance, web, IT, and AI — not as scattered tools, but as a living village of specialists who work together overnight so you wake up protected, automated, and ahead."
    location="Based in Lathrop, CA — Serving San Joaquin County & All 58 California Counties"
  >
    <Fragment slot="mobile-cta">
<div class="lux-hero-cta-mobile show-mobile-only reveal">
        <a href="#cta" class="btn btn-primary btn-glow" style="width:100%;max-width:320px;justify-content:center;font-size:16px;">
          🔍 Scan My Business — Free
        </a>
        <p style="margin-top:8px;color:var(--text-secondary);font-size:0.8rem;text-align:center;">30 seconds · No credit card</p>
      </div>
    </Fragment>
    <OpsPanel slot="panel" score={87} changeLabel="↑ 14 from last month" rows={opsRows} />
<div class="lux-form-wrap reveal hide-mobile-form" id="lead-form">
        <div class="lux-form-head">
          <span class="lux-form-badge">Free Business Scan</span>
          <div class="lux-form-title">See where you stand</div>
          <div class="lux-form-sub">30 seconds · No credit card · Real recommendations</div>
        </div>
        <form class="lead-form" id="hero-lead-form" novalidate>
          <div class="form-group">
            <label for="lf-name">Name</label>
            <input type="text" id="lf-name" name="name" required aria-required="true" placeholder="Your name" />
          </div>
          <div class="form-group">
            <label for="lf-email">Email</label>
            <input type="email" id="lf-email" name="email" required aria-required="true" placeholder="you@yourbusiness.com" />
          </div>
          <div class="form-group">
            <label for="lf-website">Website URL</label>
            <input type="url" id="lf-website" name="website" placeholder="https://yourbusiness.com" />
          </div>
          <div class="form-group full">
            <label for="lf-need">What do you need help with?</label>
            <select id="lf-need" name="need">
              <option value="">Select an option…</option>
              <option value="compliance">Compliance Monitoring</option>
              <option value="website">Website Design & Management</option>
              <option value="it-support">IT Support</option>
              <option value="ai-automation">AI & Automation</option>
              <option value="phone-systems">Phone Systems</option>
              <option value="all">All of the above</option>
            </select>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-glow" style="position:relative">
              <span class="btn-icon">🔍</span> Scan My Business — Free
            </button>
          </div>
          <div class="form-message" id="lf-message"></div>
        </form>
      </div>
  </HeroOps>

  <TrustBand items={trustItems} />

  <ShieldBand
    badge="🛡️ Worried about ADA website claims?"
    title="Central Valley Compliance Shield"
    body="Monitoring and fix-it guidance from $297/mo, or a one-time $495 Fix Sprint. Got a letter already? Talk to an attorney first, then we can help fix the site."
  >
    <a href="/pricing/#compliance" class="btn btn-primary btn-glow" style="white-space:nowrap;">See Plans →</a>
    <a href="tel:+12097011137" class="btn btn-secondary" style="white-space:nowrap;">📞 Talk to Carlos</a>
  </ShieldBand>

  <VignetteFeed
    label="The Village at Work"
    titleLead="A team of AI agents."
    titleRest="Working while you sleep."
    desc="This is what happens every night inside the village — real agents, real roles, cooperating on real work for your business."
    cards={vignettes}
    scoreLabel="Business Health Score"
    scoreValue="87"
    scoreMax="/100"
    scoreChange="↑ 14 from last month"
    moreHref="/team/"
    moreText="Meet the village →"
  />

<!-- ====== FEATURED VIDEO ====== -->
  <section class="section" id="featured-video">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Watch Carlos' Story</div>
        <h2 class="section-title">From Youth Programs to Mental Health Grants</h2>
        <p class="section-desc">Carlos sat down with Fantasy Turf War to share the story behind CC3PO — how a 20-year-old grew a youth tech program from 3 locations to 16, and turned that into a grant writing service that funds the organizations that need it most.</p>
      </div>

      <div class="reveal" style="max-width:800px;margin:0 auto;">
        <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:var(--radius-md);border:1px solid var(--border);margin-bottom:28px;">
          <iframe src="https://www.youtube.com/embed/AB-j3Fa5KYg" title="From Youth Programs to Mental Health Grants — Carlos' Story on Fantasy Turf War" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
        </div>

        <!-- Key takeaways from the video -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px;">
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md);padding:20px;text-align:center;">
            <div style="font-size:2rem;font-weight:800;color:var(--lux-emerald,var(--semantic-success));">20</div>
            <div style="color:var(--text-muted);font-size:0.8rem;text-transform:uppercase;letter-spacing:1px;">Years old when he started</div>
          </div>
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md);padding:20px;text-align:center;">
            <div style="font-size:2rem;font-weight:800;color:var(--lux-gold,var(--brand-gold));">3 → 16</div>
            <div style="color:var(--text-muted);font-size:0.85rem;text-transform:uppercase;letter-spacing:1px;">Youth program locations</div>
          </div>
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md);padding:20px;text-align:center;">
            <div style="font-size:2rem;font-weight:800;color:var(--semantic-success);">150+</div>
            <div style="color:var(--text-muted);font-size:0.85rem;text-transform:uppercase;letter-spacing:1px;">Students served</div>
          </div>
        </div>

        <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
          <a href="/products/grant-writing/" class="btn btn-primary btn-glow">📋 Grant Writing Services →</a>
          <a href="/about/" class="btn btn-secondary">About Carlos →</a>
        </div>
      </div>
    </div>
  </section>

  <CardGrid
    label="How It Works"
    title="Three steps. Better business."
    items={steps}
  />

  <PricingStrip
    label="The Math"
    title="Hire one village, not six vendors."
    head={['Hire Separately', 'Cost/mo', 'CC3PO Village']}
    rows={priceRows}
    total={{ label: 'Total', cost: '$19,000/mo', included: '$497/mo · by consultation' }}
  />

  <CardGrid
    label="Proof"
    title="Real businesses. Real results."
    variant="quote"
    items={testimonials}
  />

  <CTAClose
    heading="Your business status is waiting."
    sub="Find out where you stand — free, in 30 seconds. Let the village show you what it can do."
    trust={['✓ No credit card', '✓ 30-second scan', '✓ Real recommendations', '✓ Continuous WCAG 2.2 AA monitoring starts today']}
  >
<div class="bottom-cta-form reveal" id="bottom-lead-form-wrap">
          <form class="lead-form" id="bottom-lead-form" novalidate>
            <div class="form-group"><label for="blf-name">Name</label><input type="text" id="blf-name" name="name" required aria-required="true" placeholder="Your name" /></div>
            <div class="form-group"><label for="blf-email">Email</label><input type="email" id="blf-email" name="email" required aria-required="true" placeholder="you@yourbusiness.com" /></div>
            <div class="form-group"><label for="blf-website">Website URL</label><input type="url" id="blf-website" name="website" placeholder="https://yourbusiness.com" /></div>
            <div class="form-group full">
              <label for="blf-need">What do you need help with?</label>
              <select id="blf-need" name="need">
                <option value="">Select an option…</option>
                <option value="compliance">Compliance Monitoring</option>
                <option value="website">Website Design & Management</option>
                <option value="it-support">IT Support</option>
                <option value="ai-automation">AI & Automation</option>
                <option value="phone-systems">Phone Systems</option>
                <option value="all">All of the above</option>
              </select>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary btn-glow" style="position:relative"><span class="btn-icon">🔍</span> Scan My Business — Free</button>
              <a href="https://cc3po.io/strategy-call" class="btn btn-secondary" target="_blank" rel="noopener"><span class="btn-icon">📞</span> Strategy Call</a>
            </div>
            <div class="form-message" id="blf-message"></div>
          </form>
        </div>
    <Fragment slot="newsletter">
<div id="newsletter" class="reveal" style="text-align:center;max-width:600px;margin:56px auto 0;">
          <div class="section-label">Stay in the loop</div>
          <h2 class="section-title" style="font-size:clamp(1.5rem,3vw,2rem);">Get the Signal. Free business insights, every week.</h2>
          <p style="color:var(--text-secondary);margin-bottom:24px;">AI automation strategies, compliance updates, and tips from the village for growing your business. No spam. Unsubscribe anytime.</p>
          <form class="newsletter-form" id="newsletter-form" style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
            <label for="newsletter-email" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">Email address</label>
            <input type="email" id="newsletter-email" name="email" placeholder="Your email address" required style="flex:1;min-width:240px;padding:14px 18px;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--brand-paper);font-size:1rem;font-family:var(--font);">
            <button type="submit" class="btn btn-primary btn-glow">Get the Signal →</button>
          </form>
          <p id="newsletter-message" style="margin-top:12px;font-size:0.85rem;color:var(--accent);display:none;"></p>
          <p style="margin-top:8px;font-size:0.8rem;color:var(--text-secondary);">No spam. Unsubscribe anytime.</p>
        </div>
    </Fragment>
  </CTAClose>

  <style is:inline>
    /* Featured-video section: keep the standing markup, tune its
       section label to the Nightshift mono/gold grammar. */
    #featured-video .section-label {
      font-family: var(--font-mono); color: var(--brand-gold);
      border: none; background: none; border-radius: 0; padding: 0;
      letter-spacing: 3px;
    }
  </style>

<!-- ====== SCRIPTS ====== -->
  <script is:inline>
    // ===== SET MORNING DATE =====
    const dateEl = document.getElementById('morning-date');
    if (dateEl) { const now = new Date(); dateEl.textContent = now.toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric' }); }

    // ===== SMOOTH SCROLL OFFSET =====
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const target = document.querySelector(this.getAttribute('href'));
        if (target) { e.preventDefault(); const offset=64; const top = target.getBoundingClientRect().top + window.pageYOffset - offset; window.scrollTo({ top, behavior:'smooth' }); }
      });
    });

    // ===== BUTTON LOADING =====
    document.querySelectorAll('form').forEach(form => {
      form.addEventListener('submit', () => { const btn=form.querySelector('button[type="submit"]'); if(btn){ btn.classList.add('is-loading'); btn.style.position='relative'; } });
    });

    // ===== HERO CANVAS: Constellation Network =====
    const canvas = document.getElementById('hero-canvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      let w, h, particles=[], mouse={x:-1000,y:-1000};
      function resize(){ w=canvas.width=canvas.offsetWidth; h=canvas.height=canvas.offsetHeight; }
      resize(); window.addEventListener('resize', resize);
      document.addEventListener('mousemove', e=>{ mouse.x=e.clientX; mouse.y=e.clientY; });
      class Particle { constructor(){ this.reset(); } reset(){ this.x=Math.random()*w; this.y=Math.random()*h; this.vx=(Math.random()-0.5)*0.3; this.vy=(Math.random()-0.5)*0.3; this.r=Math.random()*1.5+0.5; this.color=['#00e676','#e6a50f','#4fc3f7','#ffd700','#e8506b'][Math.floor(Math.random()*5)]; }
        update(){ this.x+=this.vx; this.y+=this.vy; if(this.x<0||this.x>w)this.vx*=-1; if(this.y<0||this.y>h)this.vy*=-1; const dx=this.x-mouse.x,dy=this.y-mouse.y; const dist=Math.sqrt(dx*dx+dy*dy); if(dist<120){ this.x+=dx*0.01; this.y+=dy*0.01; } }
        draw(){ ctx.beginPath(); ctx.arc(this.x,this.y,this.r,0,Math.PI*2); ctx.fillStyle=this.color; ctx.globalAlpha=0.6; ctx.fill(); }
      }
      const count = Math.min(80, Math.floor(w*h/12000));
      for(let i=0;i<count;i++) particles.push(new Particle());
      let animating=true;
      const canvasObserver = new IntersectionObserver(([e])=>{ animating=e.isIntersecting; if(animating)animate(); }, {threshold:0});
      canvasObserver.observe(canvas);
      function animate(){ if(!animating)return; ctx.clearRect(0,0,w,h); particles.forEach(p=>{p.update();p.draw();}); ctx.globalAlpha=0.08; ctx.strokeStyle='#00e676'; ctx.lineWidth=0.5; for(let i=0;i<particles.length;i++){ for(let j=i+1;j<particles.length;j++){ const dx=particles[i].x-particles[j].x, dy=particles[i].y-particles[j].y, d=dx*dx+dy*dy; if(d<15000){ ctx.globalAlpha=0.06*(1-d/15000); ctx.beginPath(); ctx.moveTo(particles[i].x,particles[i].y); ctx.lineTo(particles[j].x,particles[j].y); ctx.stroke(); } } } ctx.globalAlpha=1; requestAnimationFrame(animate); }
      animate();
    }

    // ===== SCROLL REVEAL =====
    const revealEls = document.querySelectorAll('.reveal');
    revealEls.forEach(el => el.classList.add('reveal-out'));
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => { if(entry.isIntersecting){ entry.target.classList.add('revealed'); entry.target.classList.remove('reveal-out'); revealObserver.unobserve(entry.target); } });
    }, { threshold:0.05, rootMargin:'0px 0px -20px 0px' });
    revealEls.forEach(el => revealObserver.observe(el));
    const heroEls = document.querySelectorAll('.lux-hero .reveal');
    setTimeout(() => { heroEls.forEach(el => { if(!el.classList.contains('revealed')){ el.classList.add('revealed'); el.classList.remove('reveal-out'); } }); }, 200);

    // ===== SUPABASE LEAD FORM =====
    const SUPABASE_URL='https://cdrcgmdvepxwsbqaifxv.supabase.co';
    const SUPABASE_ANON_KEY='sb_publishable_dNkzT9Le1oI0oSIZ9U_QFQ_6o4P6jIY';
    async function submitLead(form, messageEl){
      messageEl.textContent=''; messageEl.className='form-message';
      const name=form.querySelector('[name="name"]').value.trim();
      const email=form.querySelector('[name="email"]').value.trim();
      const website=form.querySelector('[name="website"]')?.value.trim()||'';
      const need=form.querySelector('[name="need"]')?.value||'';
      if(!name||!email){ messageEl.textContent='Please fill in your name and email.'; messageEl.classList.add('error'); return; }
      const body={ name, email, phone:null, company:null, service_interest:need||null, message:website?'Website: '+website:null, source:form.id==='hero-lead-form'?'cc3po.com-hero':'cc3po.com-cta', lead_type:'contact' };
      try {
        const res = await fetch(SUPABASE_URL+'/rest/v1/leads', { method:'POST', headers:{ 'apikey':SUPABASE_ANON_KEY, 'Authorization':'Bearer '+SUPABASE_ANON_KEY, 'Content-Type':'application/json', 'Prefer':'return=minimal' }, body:JSON.stringify(body) });
        if(res.ok){
          messageEl.classList.add('success'); form.reset();
          const formWrap = form.closest('.lux-form-wrap, .bottom-cta-form-wrap, #bottom-lead-form-wrap') || form.parentElement;
          if(formWrap){ formWrap.innerHTML = `<div style="text-align:center;padding:40px 20px;"><div style="font-size:48px;margin-bottom:16px;">✅</div><h3 style="color:var(--brand-paper);margin-bottom:8px;">We're scanning now.</h3><p style="color:var(--text-secondary);font-size:0.95rem;">Here's what happens next:</p><div style="text-align:left;max-width:360px;margin:16px auto;"><div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;color:var(--text-secondary);"><span style="font-size:1.2rem;">1️⃣</span><span>We scan your website for compliance, speed, SEO, and security issues.</span></div><div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;color:var(--text-secondary);"><span style="font-size:1.2rem;">2️⃣</span><span>You get a detailed report with real recommendations within 24 hours.</span></div><div style="display:flex;align-items:flex-start;gap:12px;color:var(--text-secondary);"><span style="font-size:1.2rem;">3️⃣</span><span>No obligation. No sales pitch. Just actionable insights.</span></div></div><a href="https://cc3po.io/strategy-call" target="_blank" rel="noopener" class="btn btn-primary btn-glow" style="margin-top:16px;display:inline-flex;align-items:center;gap:8px;text-decoration:none;">📞 Book a Strategy Call Instead</a></div>`; }
        } else { const err=await res.text().catch(()=>'Unknown error'); console.error('Supabase error:',res.status,err); messageEl.textContent='Something went wrong. Please try again or email us directly.'; messageEl.classList.add('error'); }
      } catch(e){ console.error('Network error:',e); messageEl.textContent='Network error. Please check your connection and try again.'; messageEl.classList.add('error'); }
    }
    document.getElementById('hero-lead-form')?.addEventListener('submit', function(e){ e.preventDefault(); submitLead(this, document.getElementById('lf-message')); });
    document.getElementById('bottom-lead-form')?.addEventListener('submit', function(e){ e.preventDefault(); submitLead(this, document.getElementById('blf-message')); });

    // ===== NEWSLETTER =====
    document.getElementById('newsletter-form')?.addEventListener('submit', async function(e){
      e.preventDefault();
      const email=this.querySelector('[name="email"]').value.trim();
      const msg=document.getElementById('newsletter-message');
      if(!email)return;
      try {
        const res = await fetch('https://scanner.cc3po.com/api/newsletter-subscribe', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ email, source:'homepage' }) });
        if(res.ok){ msg.textContent="✓ You're in! Check your inbox for the Signal."; msg.style.display='block'; msg.style.color='var(--green)'; this.reset(); }
        else { msg.textContent='Something went wrong. Please try again.'; msg.style.display='block'; msg.style.color='var(--primary)'; }
      } catch(e){ msg.textContent='Network error. Please try again.'; msg.style.display='block'; msg.style.color='var(--primary)'; }
    });

    // ===== VIDEO PAUSE =====
    const videoPauseBtn=document.getElementById('video-pause-btn');
    const heroVideo=document.querySelector('.hero-video');
    if(videoPauseBtn && heroVideo){
      videoPauseBtn.addEventListener('click', () => {
        if(heroVideo.paused){ heroVideo.play(); videoPauseBtn.textContent='⏸'; videoPauseBtn.setAttribute('aria-label','Play background video'); videoPauseBtn.title='Play video'; }
        else { heroVideo.pause(); videoPauseBtn.textContent='▶'; videoPauseBtn.setAttribute('aria-label','Pause background video'); videoPauseBtn.title='Pause video'; }
      });
      videoPauseBtn.addEventListener('mouseenter',()=>{ videoPauseBtn.style.opacity='1'; });
      videoPauseBtn.addEventListener('mouseleave',()=>{ videoPauseBtn.style.opacity='0.6'; });
    }
  </script>

</Layout>
