    const SUPABASE_URL='https://cdrcgmdvepxwsbqaifxv.supabase.co';
    const SUPABASE_ANON_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNkcmNnbWR2ZXB4d3NicWFpZnh2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM1MDY4MDksImV4cCI6MjA4OTA4MjgwOX0.pKWLWvsSimTOMkpaXKKrLJESrQEMUayUU1c9ANzr1Dc';
    async function submitLead(form, messageEl){
      messageEl.textContent=''; messageEl.className='form-message';
      const name=form.querySelector('[name="name"]').value.trim();
      const email=form.querySelector('[name="email"]').value.trim();
      const website=form.querySelector('[name="website"]')?.value.trim()||'';
      const need=form.querySelector('[name="need"]')?.value||'';
      if(!name||!email){ messageEl.textContent='Please fill in your name and email.'; messageEl.classList.add('error'); return; }
      const body={ name, email, phone:null, company:null, service_interest:need||null, message:website?'Website: '+website:null, source:form.id==='hero-lead-form'?'cc3po.com-hero':'cc3po.com-cta', lead_type:'contact' };
      try {
        const res = await fetch(SUPABASE_URL+'/rest/v1/leads', { method:'POST', headers:{ 'apikey':SUPABASE_ANON_KEY, 'Authorization':'Bearer '+SUPABASE_ANON_KEY, 'Content-Type':'application/json', 'Prefer':'return=minimal' }, body:JSON.stringify(body) });
        if(res.ok){
          messageEl.classList.add('success'); form.reset();
          const formWrap = form.closest('.lux-form-wrap, .bottom-cta-form-wrap, #bottom-lead-form-wrap') || form.parentElement;
          if(formWrap){ formWrap.innerHTML = `<div style="text-align:center;padding:40px 20px;"><div style="font-size:48px;margin-bottom:16px;">✅</div><h3 style="color:#fff;margin-bottom:8px;">We're scanning now.</h3><p style="color:var(--text-secondary);font-size:0.95rem;">Here's what happens next:</p><div style="text-align:left;max-width:360px;margin:16px auto;"><div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;color:var(--text-secondary);"><span style="font-size:1.2rem;">1️⃣</span><span>We scan your website for compliance, speed, SEO, and security issues.</span></div><div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;color:var(--text-secondary);"><span style="font-size:1.2rem;">2️⃣</span><span>You get a detailed report with real recommendations within 24 hours.</span></div><div style="display:flex;align-items:flex-start;gap:12px;color:var(--text-secondary);"><span style="font-size:1.2rem;">3️⃣</span><span>No obligation. No sales pitch. Just actionable insights.</span></div></div><a href="https://cc3po.io/strategy-call" target="_blank" rel="noopener" class="btn btn-primary btn-glow" style="margin-top:16px;display:inline-flex;align-items:center;gap:8px;text-decoration:none;">📞 Book a Strategy Call Instead</a></div>`; }
        } else { const err=await res.text().catch(()=>'Unknown error'); console.error('Supabase error:',res.status,err); messageEl.textContent='Something went wrong. Please try again or email us directly.'; messageEl.classList.add('error'); }
      } catch(e){ console.error('Network error:',e); messageEl.textContent='Network error. Please check your connection and try again.'; messageEl.classList.add('error'); }
    }
    document.getElementById('hero-lead-form')?.addEventListener('submit', function(e){ e.preventDefault(); submitLead(this, document.getElementById('lf-message')); });
    document.getElementById('bottom-lead-form')?.addEventListener('submit', function(e){ e.preventDefault(); submitLead(this, document.getElementById('blf-message')); });

    // ===== NEWSLETTER =====
    document.getElementById('newsletter-form')?.addEventListener('submit', async function(e){
      e.preventDefault();
      const email=this.querySelector('[name="email"]').value.trim();
      const msg=document.getElementById('newsletter-message');
      if(!email)return;
      try {
        const res = await fetch('https://scanner.cc3po.com/api/newsletter-subscribe', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ email, source:'homepage' }) });
        if(res.ok){ msg.textContent="✓ You're in! Check your inbox for the Signal."; msg.style.display='block'; msg.style.color='var(--green)'; this.reset(); }
        else { msg.textContent='Something went wrong. Please try again.'; msg.style.display='block'; msg.style.color='var(--primary)'; }
      } catch(e){ msg.textContent='Network error. Please try again.'; msg.style.display='block'; msg.style.color='var(--primary)'; }
    });

    // ===== VIDEO PAUSE =====
    const videoPauseBtn=document.getElementById('video-pause-btn');
    const heroVideo=document.querySelector('.hero-video');
    if(videoPauseBtn && heroVideo){
      videoPauseBtn.addEventListener('click', () => {
        if(heroVideo.paused){ heroVideo.play(); videoPauseBtn.textContent='⏸'; videoPauseBtn.setAttribute('aria-label','Play background video'); videoPauseBtn.title='Play video'; }
        else { heroVideo.pause(); videoPauseBtn.textContent='▶'; videoPauseBtn.setAttribute('aria-label','Pause background video'); videoPauseBtn.title='Pause video'; }
      });
      videoPauseBtn.addEventListener('mouseenter',()=>{ videoPauseBtn.style.opacity='1'; });
      videoPauseBtn.addEventListener('mouseleave',()=>{ videoPauseBtn.style.opacity='0.6'; });
    }
  </script>

</Layout>
