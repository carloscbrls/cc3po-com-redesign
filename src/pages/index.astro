---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CC3PO — The AI Village That Runs Your Business" description="CC3PO — a village of 29 specialized AI agents working together to run your business: compliance monitoring, website management, IT support, AI automation, and phone systems. One team, 24/7.">
  <!-- ============================================================
       CC3PO.com — Luxurious Village Landing Page
       Emerald & Champagne-Gold · The Village Working Together
  ============================================================ -->

  <!-- ====== HERO — The Village That Runs Your Business ====== -->
  <section class="lux-hero" id="main-content">
    <video class="hero-video" autoplay loop muted playsinline aria-label="Animated network visualization background">
      <source src="/videos/hero-network.webm" type="video/webm">
      <source src="/videos/hero-network.mp4" type="video/mp4">
    </video>
    <button class="video-pause-btn" id="video-pause-btn" aria-label="Pause background video" title="Pause video">⏸</button>
    <canvas id="hero-canvas"></canvas>
    <div class="lux-hero-inner">
      <div class="lux-eyebrow reveal">
        <span class="pulse-dot"></span>
        A Village of 29 Agents · Working for You, 24/7
      </div>

      <h1 class="lux-hero-title reveal">
        The Village that<br /><span class="lux-gold">runs your business.</span>
      </h1>

      <p class="lux-hero-sub reveal">
        Compliance, web, IT, and AI — not as scattered tools, but as a living village of specialists who work together overnight so you wake up protected, automated, and ahead.
      </p>
      <p class="lux-hero-location hide-mobile reveal">Based in Lathrop, CA — Serving San Joaquin County &amp; All 58 California Counties</p>

      <!-- Mobile CTA -->
      <div class="lux-hero-cta-mobile show-mobile-only reveal">
        <a href="#cta" class="btn btn-primary btn-glow" style="width:100%;max-width:320px;justify-content:center;font-size:16px;">
          🔍 Scan My Business — Free
        </a>
        <p style="margin-top:8px;color:var(--text-secondary);font-size:0.8rem;text-align:center;">30 seconds · No credit card</p>
      </div>

      <!-- Desktop lead form -->
      <div class="lux-form-wrap reveal hide-mobile-form" id="lead-form">
        <div class="lux-form-head">
          <span class="lux-form-badge">Free Business Scan</span>
          <div class="lux-form-title">See where you stand</div>
          <div class="lux-form-sub">30 seconds · No credit card · Real recommendations</div>
        </div>
        <form class="lead-form" id="hero-lead-form" novalidate>
          <div class="form-group">
            <label for="lf-name">Name</label>
            <input type="text" id="lf-name" name="name" required aria-required="true" placeholder="Your name" />
          </div>
          <div class="form-group">
            <label for="lf-email">Email</label>
            <input type="email" id="lf-email" name="email" required aria-required="true" placeholder="you@yourbusiness.com" />
          </div>
          <div class="form-group">
            <label for="lf-website">Website URL</label>
            <input type="url" id="lf-website" name="website" placeholder="https://yourbusiness.com" />
          </div>
          <div class="form-group full">
            <label for="lf-need">What do you need help with?</label>
            <select id="lf-need" name="need">
              <option value="">Select an option…</option>
              <option value="compliance">Compliance Monitoring</option>
              <option value="website">Website Design & Management</option>
              <option value="it-support">IT Support</option>
              <option value="ai-automation">AI & Automation</option>
              <option value="phone-systems">Phone Systems</option>
              <option value="all">All of the above</option>
            </select>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-glow" style="position:relative">
              <span class="btn-icon">🔍</span> Scan My Business — Free
            </button>
          </div>
          <div class="form-message" id="lf-message"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- ====== TRUST BAR ====== -->
  <section class="lux-trustbar">
    <div class="container">
      <div class="lux-trust-items">
        <div class="lux-trust-item">🏛️ <strong>CA Certified Small Business</strong> <span>SB #2052063</span></div>
        <div class="lux-trust-item">🌎 <strong>Latino-Owned Business</strong></div>
        <div class="lux-trust-item">🛡️ <strong>SB/DVBE Option Eligible</strong></div>
        <div class="lux-trust-item">🌐 <strong>Se habla español</strong></div>
      </div>
    </div>
  </section>

  <!-- ====== SHOW & TELL EVENT BANNER ====== -->
  <section class="showtell-banner" id="showtell" style="background: linear-gradient(135deg, rgba(233,69,96,0.10) 0%, rgba(79,195,247,0.06) 100%); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 36px 0;">
    <div class="container">
      <div class="showtell-card" style="display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; background: linear-gradient(145deg, var(--bg-card), #0a1628); border: 1px solid rgba(233,69,96,0.35); border-radius: 16px; padding: 28px 32px; box-shadow: 0 8px 40px rgba(233,69,96,0.12);">
        <div style="flex: 1; min-width: 280px;">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
            <span class="pulse-dot"></span>
            <span style="font-weight: 700; color: var(--accent); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase;">Live Event · Nov 13 · Modesto, CA</span>
          </div>
          <h3 style="margin: 0 0 8px; color: var(--text-primary); font-size: clamp(1.4rem, 3vw, 1.9rem); line-height: 1.25;">Two Locals. 200 Days of AI. <span style="color: var(--accent);">The Good, The Bad &amp; The Ugly.</span></h3>
          <p style="margin: 0; color: var(--text-secondary); font-size: 15px; line-height: 1.55; max-width: 560px;">We built a 29-agent AI village — the same team behind this site — and we're telling the whole story, live. Live demos, real numbers, no sugar-coating.</p>
        </div>
        <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
          <a href="https://showandtell.cc3po.com" class="btn btn-primary btn-glow" style="white-space: nowrap;">Get Tickets — $109 →</a>
          <a href="https://showandtell.cc3po.com" class="btn btn-secondary" style="white-space: nowrap;">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== SHIELD CTA — Compliance Shield ====== -->
  <section class="lux-shield" id="shield-cta">
    <div class="container">
      <div class="lux-shield-card">
        <div class="lux-shield-body">
          <div class="lux-shield-badge">🛡️ Got an ADA demand letter?</div>
          <h3>Central Valley Compliance Shield</h3>
          <p>Monthly monitoring + fix-it guidance. Starting at $97/mo. Live in 24 hours.</p>
        </div>
        <div class="lux-shield-actions">
          <a href="https://shield.cc3po.com" class="btn btn-primary btn-glow" style="white-space:nowrap;">See Plans →</a>
          <a href="tel:+12097011137" class="btn btn-secondary" style="white-space:nowrap;">📞 Talk to Carlos</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== THE VILLAGE AT WORK — working together ====== -->
  <section class="lux-section lux-section-alt" id="village-work">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">The Village at Work</div>
        <h2 class="section-title">29 specialists. One team.<br />Working while you sleep.</h2>
        <p class="section-desc">This is what happens every night inside the village — real agents, real roles, cooperating on real work for your business.</p>
      </div>

      <div class="lux-work-grid reveal">
        <div class="lux-work-card lux-work-lead">
          <div class="lux-work-time">02:14 AM</div>
          <div class="lux-work-agent">
            <img src="/images/authors/atlas.png" alt="Atlas" width="44" height="44" loading="lazy" />
            <div>
              <div class="lux-work-name">Atlas 🌍</div>
              <div class="lux-work-role">Infrastructure Architect</div>
            </div>
          </div>
          <p class="lux-work-msg">"Plugin conflict detected on your site. Assigning to Sentinel for the compliance check, then I'll patch the server."</p>
          <div class="lux-work-meta"><span class="lux-tag-emerald">Running</span> · Infrastructure</div>
        </div>

        <div class="lux-work-card">
          <div class="lux-work-head">
            <span class="lux-work-emoji">🛡️</span>
            <div>
              <div class="lux-work-name">Sentinel</div>
              <div class="lux-work-role">Compliance Sentinel</div>
            </div>
          </div>
          <p class="lux-work-msg">"WCAG 2.2 AA scan complete — 0 new violations. New CA law flagged, already drafted the fix list for Axecessor."</p>
          <div class="lux-work-meta"><span class="lux-tag-emerald">Compliance</span> · Passed</div>
        </div>

        <div class="lux-work-card">
          <div class="lux-work-head">
            <span class="lux-work-emoji">⚡</span>
            <div>
              <div class="lux-work-name">Hermes</div>
              <div class="lux-work-role">Research &amp; Compute</div>
            </div>
          </div>
          <p class="lux-work-msg">"Competitor price drop detected. Recommendation ready — Leo is drafting the outreach."</p>
          <div class="lux-work-meta"><span class="lux-tag-gold">Competitor Intel</span> · Actioned</div>
        </div>

        <div class="lux-work-card">
          <div class="lux-work-head">
            <span class="lux-work-emoji">🦁</span>
            <div>
              <div class="lux-work-name">Leo</div>
              <div class="lux-work-role">Outreach Architect</div>
            </div>
          </div>
          <p class="lux-work-msg">"3 reviews responded to professionally. Warm follow-up scheduled for tomorrow 9 AM. No cold handshakes here."</p>
          <div class="lux-work-meta"><span class="lux-tag-emerald">Reviews</span> · 3 Done</div>
        </div>

        <div class="lux-work-card">
          <div class="lux-work-head">
            <span class="lux-work-emoji">📚</span>
            <div>
              <div class="lux-work-name">Alexandria</div>
              <div class="lux-work-role">Knowledge</div>
            </div>
          </div>
          <p class="lux-work-msg">"Two posts published on schedule. Blog drafted and sent to Spark for the voice pass."</p>
          <div class="lux-work-meta"><span class="lux-tag-gold">Content</span> · Published</div>
        </div>

        <div class="lux-work-card">
          <div class="lux-work-head">
            <span class="lux-work-emoji">✨</span>
            <div>
              <div class="lux-work-name">Spark</div>
              <div class="lux-work-role">Engagement Spark</div>
            </div>
          </div>
          <p class="lux-work-msg">"Copy tightened. The morning report is ready — Carlos gets it at 7 AM sharp, every day."</p>
          <div class="lux-work-meta"><span class="lux-tag-emerald">Delivery</span> · Ready</div>
        </div>

        <div class="lux-work-card lux-work-conductor">
          <div class="lux-work-head">
            <span class="lux-work-emoji">🧑🏽‍💻</span>
            <div>
              <div class="lux-work-name">Carlos</div>
              <div class="lux-work-role">Founder &amp; Conductor</div>
            </div>
          </div>
          <p class="lux-work-msg">"The village runs itself now. My job is the vision — and making sure every small business gets this team."</p>
          <div class="lux-work-meta"><span class="lux-tag-gold">Oversight</span> · Human First</div>
        </div>
      </div>

      <p class="lux-village-more reveal"><a href="/village/">Meet all 29 members of the village →</a></p>
    </div>
  </section>

  <!-- ====== FEATURED VIDEO ====== -->
  <section class="section" id="featured-video">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Watch Carlos' Story</div>
        <h2 class="section-title">From Youth Programs to Mental Health Grants</h2>
        <p class="section-desc">Carlos sat down with Fantasy Turf War to share the story behind CC3PO — how a 20-year-old grew a youth tech program from 3 locations to 16, and turned that into a grant writing service that funds the organizations that need it most.</p>
      </div>

      <div class="reveal" style="max-width:800px;margin:0 auto;">
        <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:16px;border:1px solid var(--border);margin-bottom:28px;">
          <iframe src="https://www.youtube.com/embed/AB-j3Fa5KYg" title="From Youth Programs to Mental Health Grants — Carlos' Story on Fantasy Turf War" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
        </div>

        <!-- Key takeaways from the video -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px;">
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:20px;text-align:center;">
            <div style="font-size:2rem;font-weight:800;color:var(--lux-emerald,#10b981);">20</div>
            <div style="color:var(--text-muted);font-size:0.8rem;text-transform:uppercase;letter-spacing:1px;">Years old when he started</div>
          </div>
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:20px;text-align:center;">
            <div style="font-size:2rem;font-weight:800;color:var(--lux-gold,#d4af37);">3 → 16</div>
            <div style="color:var(--text-muted);font-size:0.85rem;text-transform:uppercase;letter-spacing:1px;">Youth program locations</div>
          </div>
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:20px;text-align:center;">
            <div style="font-size:2rem;font-weight:800;color:var(--gold,#10b981);">150+</div>
            <div style="color:var(--text-muted);font-size:0.85rem;text-transform:uppercase;letter-spacing:1px;">Students served</div>
          </div>
        </div>

        <div style="background:linear-gradient(160deg,rgba(16,185,129,0.06),rgba(212,175,55,0.05));border:1px solid var(--border);border-radius:16px;padding:24px;margin-bottom:24px;">
          <div style="font-size:0.8rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--gold,#d4af37);margin-bottom:12px;">What you'll hear in the video</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">• How a 20-year-old helped a youth tech program grow 3 → 16 locations<br/>• Giving 150+ students free computers &amp; tech education</div>
            <div style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">• Why that experience became CC3PO's grant writing service<br/>• How nonprofits fund mental health &amp; community programs</div>
          </div>
        </div>

        <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
          <a href="/products/grant-writing/" class="btn btn-primary btn-glow">📋 Grant Writing Services →</a>
          <a href="/about/" class="btn btn-secondary">About Carlos →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== MORNING REPORT ====== -->
  <section class="section section-alt" id="morning-report" style="background:var(--bg-secondary);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">What You Wake Up To</div>
        <h2 class="section-title">Every morning, your compliance status is waiting.</h2>
        <p class="section-desc">No dashboards to check. No reports to run. The village leaves it ready on your phone.</p>
      </div>

      <div class="morning-report-card reveal">
        <div class="morning-report-header">
          <span class="morning-greeting">☀️ Good morning.</span>
          <span class="morning-date" id="morning-date"></span>
        </div>
        <div class="morning-report-subtitle">The village ran your business great overnight.</div>
        <div class="morning-report-items">
          <div class="morning-item">
            <span class="morning-check">✅</span>
            <div class="morning-item-content">
              <span class="morning-item-title">Website</span>
              <span class="morning-item-desc">Plugin conflict fixed at 2:14 AM</span>
            </div>
          </div>
          <div class="morning-item">
            <span class="morning-check">✅</span>
            <div class="morning-item-content">
              <span class="morning-item-title">Reviews</span>
              <span class="morning-item-desc">3 responded to professionally</span>
            </div>
          </div>
          <div class="morning-item">
            <span class="morning-check">✅</span>
            <div class="morning-item-content">
              <span class="morning-item-title">Social</span>
              <span class="morning-item-desc">2 posts published on schedule</span>
            </div>
          </div>
          <div class="morning-item">
            <span class="morning-check">✅</span>
            <div class="morning-item-content">
              <span class="morning-item-title">Compliance</span>
              <span class="morning-item-desc">Up to date — new law already handled</span>
            </div>
          </div>
          <div class="morning-item">
            <span class="morning-check">✅</span>
            <div class="morning-item-content">
              <span class="morning-item-title">Competitor</span>
              <span class="morning-item-desc">Price drop detected — recommendation ready</span>
            </div>
          </div>
        </div>
        <div class="morning-score">
          <div class="morning-score-label">Business Health Score</div>
          <div class="morning-score-value">
            <span class="morning-score-num">87</span><span class="morning-score-max">/100</span>
          </div>
          <div class="morning-score-change">↑ 14 from last month</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== MEET THE VILLAGE ====== -->
  <section class="section" id="team">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Your Village</div>
        <h2 class="section-title">Meet the people who never sleep.</h2>
        <p class="section-desc">29 specialists. Real faces. Real expertise. Each one owns their domain — together, they run your business.</p>
      </div>

      <div class="team-grid reveal">
        <a href="/village/carlos/" class="team-card team-card-portrait">
          <img src="/images/authors/carlos.png" alt="Carlos" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Carlos 🧑🏽‍💻</div>
            <div class="team-role">Founder & Conductor</div>
            <p class="team-desc">Built the village because people deserve better tools. The vision behind every system.</p>
          </div>
        </a>
        <a href="/village/atlas/" class="team-card team-card-portrait">
          <img src="/images/authors/atlas.png" alt="Atlas" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Atlas 🌍</div>
            <div class="team-role">Infrastructure Architect</div>
            <p class="team-desc">Carries the weight of the village so your systems never break.</p>
          </div>
        </a>
        <a href="/village/sentinel/" class="team-card team-card-portrait">
          <img src="/images/authors/sentinel.png" alt="Sentinel" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Sentinel 🛡️</div>
            <div class="team-role">Compliance Sentinel</div>
            <p class="team-desc">Already checked the exits. Keeps you legal and accessible.</p>
          </div>
        </a>
        <a href="/village/forge/" class="team-card team-card-portrait">
          <img src="/images/authors/forge.png" alt="Forge" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Forge ⚒️</div>
            <div class="team-role">Systems Forge</div>
            <p class="team-desc">If it's manual, it's broken. Builds systems that run themselves.</p>
          </div>
        </a>
        <a href="/village/weaver/" class="team-card team-card-portrait">
          <img src="/images/authors/weaver.png" alt="Weaver" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Weaver 🕸️</div>
            <div class="team-role">Narrative Architect</div>
            <p class="team-desc">Every story is a thread. She finds the ones worth weaving.</p>
          </div>
        </a>
        <a href="/village/spark/" class="team-card team-card-portrait">
          <img src="/images/authors/spark.png" alt="Spark" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Spark ✨</div>
            <div class="team-role">Engagement Spark</div>
            <p class="team-desc">Walks into a room and the energy shifts. Your brand's voice on every platform.</p>
          </div>
        </a>
        <a href="/village/leo/" class="team-card team-card-portrait">
          <img src="/images/authors/leo.png" alt="Leo" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Leo 🦁</div>
            <div class="team-role">Outreach Architect</div>
            <p class="team-desc">Every email is a handshake. Direct, warm, impossible to ignore.</p>
          </div>
        </a>
        <a href="/village/mirror/" class="team-card team-card-portrait">
          <img src="/images/authors/mirror.png" alt="Mirror" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Mirror 🪞</div>
            <div class="team-role">Trust & Reflection</div>
            <p class="team-desc">The signal is always in the noise. Protects your reputation in real time.</p>
          </div>
        </a>
        <a href="/village/apollo/" class="team-card team-card-portrait">
          <img src="/images/authors/apollo.png" alt="Apollo" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Apollo 🔍</div>
            <div class="team-role">Truth & Discovery</div>
            <p class="team-desc">Doesn't stop at the first answer. Finds what others miss.</p>
          </div>
        </a>
        <a href="/ai-voice-agent/" class="team-card team-card-portrait">
          <img src="/images/authors/callie.jpg" alt="Callie" class="team-portrait" width="80" height="80" loading="lazy" />
          <div class="team-card-body">
            <div class="team-name">Callie 📞</div>
            <div class="team-role">Voice Concierge</div>
            <p class="team-desc">She picked her own name, voice, and way of listening. Your first hello when you call CC3PO.</p>
          </div>
        </a>
      </div>

      <p class="reveal" style="text-align:center;margin-top:32px;"><a href="/village/" style="color:var(--accent);font-size:1rem;font-weight:600;text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--accent);">See all 29 team members →</a></p>
    </div>
  </section>

  <!-- ====== BEFORE / AFTER ====== -->
  <section class="section section-alt" id="before-after" style="background:var(--bg-secondary);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">The Difference</div>
        <h2 class="section-title">Your day. With and without the village.</h2>
      </div>

      <div class="before-after-split reveal">
        <div class="ba-column ba-without">
          <div class="ba-column-title">⚠️ Without CC3PO</div>
          <div class="ba-column-items">
