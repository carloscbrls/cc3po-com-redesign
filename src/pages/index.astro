  <!-- ====== SCRIPTS ====== -->
  <script is:inline>
    // ===== SET MORNING DATE =====
    const dateEl = document.getElementById('morning-date');
    if (dateEl) {
      const now = new Date();
      dateEl.textContent = now.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
    }

    // ===== MOBILE DRAWER (handled by Layout.astro) =====
    // Drawer toggle is initialized in Layout.astro for all pages

    // ===== SMOOTH SCROLL OFFSET =====
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          e.preventDefault();
          const offset = 64;
          const top = target.getBoundingClientRect().top + window.pageYOffset - offset;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      });
    });

    // ===== BUTTON LOADING STATE =====
    document.querySelectorAll('form').forEach(form => {
      form.addEventListener('submit', () => {
        const btn = form.querySelector('button[type="submit"]');
        if (btn) {
          btn.classList.add('is-loading');
          btn.style.position = 'relative';
        }
      });
    });

    // ===== HERO CANVAS: Constellation Network =====
    const canvas = document.getElementById('hero-canvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      let w, h, particles = [], mouse = { x: -1000, y: -1000 };

      function resize() {
        w = canvas.width = canvas.offsetWidth;
        h = canvas.height = canvas.offsetHeight;
      }
      resize();
      window.addEventListener('resize', resize);
      document.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });

      class Particle {
        constructor() { this.reset(); }
        reset() {
          this.x = Math.random() * w;
          this.y = Math.random() * h;
          this.vx = (Math.random() - 0.5) * 0.3;
          this.vy = (Math.random() - 0.5) * 0.3;
          this.r = Math.random() * 1.5 + 0.5;
          this.color = ['#e94560','#0f3460','#4fc3f7','#ffd700','#00e676'][Math.floor(Math.random()*5)];
        }
        update() {
          this.x += this.vx; this.y += this.vy;
          if (this.x < 0 || this.x > w) this.vx *= -1;
          if (this.y < 0 || this.y > h) this.vy *= -1;
          const dx = this.x - mouse.x, dy = this.y - mouse.y;
          const dist = Math.sqrt(dx*dx + dy*dy);
          if (dist < 120) {
            this.x += dx * 0.01; this.y += dy * 0.01;
          }
        }
        draw() {
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.r, 0, Math.PI*2);
          ctx.fillStyle = this.color;
          ctx.globalAlpha = 0.6;
          ctx.fill();
        }
      }

      const count = Math.min(80, Math.floor(w * h / 12000));
      for (let i = 0; i < count; i++) particles.push(new Particle());

      let animating = true;
      const canvasObserver = new IntersectionObserver(([entry]) => {
        animating = entry.isIntersecting;
        if (animating) animate();
      }, { threshold: 0 });
      canvasObserver.observe(canvas);

      function animate() {
        if (!animating) return;
        ctx.clearRect(0, 0, w, h);
        particles.forEach(p => { p.update(); p.draw(); });
        ctx.globalAlpha = 0.08;
        ctx.strokeStyle = '#e94560';
        ctx.lineWidth = 0.5;
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const d = dx*dx + dy*dy;
            if (d < 15000) {
              ctx.globalAlpha = 0.06 * (1 - d/15000);
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.stroke();
            }
          }
        }
        ctx.globalAlpha = 1;
        requestAnimationFrame(animate);
      }
      animate();
    }

    // ===== SCROLL REVEAL =====
    // Progressive reveal: content is visible by default (CSS). 
    // JS adds 'reveal-out' to hide, then 'revealed' to animate in.
    // If JS fails, content stays visible — no blank page on mobile.
    const revealEls = document.querySelectorAll('.reveal');
    revealEls.forEach(el => {
      el.classList.add('reveal-out'); // Hide elements that will be animated
    });

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          entry.target.classList.remove('reveal-out');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -20px 0px' });
    revealEls.forEach(el => revealObserver.observe(el));

    // Force-reveal hero elements after 200ms (mobile Safari fix)
    // IntersectionObserver may not fire for elements already in viewport on page load
    const heroEls = document.querySelectorAll('.hero .reveal');
    setTimeout(() => {
      heroEls.forEach(el => {
        if (!el.classList.contains('revealed')) {
          el.classList.add('revealed');
          el.classList.remove('reveal-out');
        }
      });
    }, 200);

    // Nav scroll handled by SiteNav component

    // ===== SUPABASE LEAD FORM =====
    const SUPABASE_URL = 'https://cdrcgmdvepxwsbqaifxv.supabase.co';
    const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNkcmNnbWR2ZXB4d3NicWFpZnh2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM1MDY4MDksImV4cCI6MjA4OTA4MjgwOX0.pKWLWvsSimTOMkpaXKKrLJESrQEMUayUU1c9ANzr1Dc';

    async function submitLead(form, messageEl) {
      messageEl.textContent = '';
      messageEl.className = 'form-message';

      const name = form.querySelector('[name="name"]').value.trim();
      const email = form.querySelector('[name="email"]').value.trim();
      const website = form.querySelector('[name="website"]')?.value.trim() || '';
      const need = form.querySelector('[name="need"]')?.value || '';

      if (!name || !email) {
        messageEl.textContent = 'Please fill in your name and email.';
        messageEl.classList.add('error');
        return;
      }

      const body = {
        name: name,
        email: email,
        phone: null,
        company: null,
        service_interest: need || null,
        message: website ? 'Website: ' + website : null,
        source: form.id === 'hero-lead-form' ? 'cc3po.com-hero' : 'cc3po.com-cta',
        lead_type: 'contact'
      };

      try {
        const res = await fetch(SUPABASE_URL + '/rest/v1/leads', {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_ANON_KEY,
            'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify(body)
        });

        if (res.ok) {
          messageEl.classList.add('success');
          form.reset();

          // Show confirmation animation
          const formWrap = form.closest('.lead-form-wrap, .bottom-cta-form-wrap, #bottom-lead-form-wrap') || form.parentElement;
          if (formWrap) {
            const origHTML = formWrap.innerHTML;
            formWrap.innerHTML = `
              <div style="text-align:center;padding:40px 20px;">
                <div style="font-size:48px;margin-bottom:16px;">✅</div>
                <h3 style="color:#fff;margin-bottom:8px;">We're scanning now.</h3>
                <p style="color:var(--text-muted);font-size:0.95rem;">Here's what happens next:</p>
                <div style="text-align:left;max-width:360px;margin:16px auto;">
                  <div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;color:var(--text-secondary);">
                    <span style="font-size:1.2rem;">1️⃣</span>
                    <span>We scan your website for compliance, speed, SEO, and security issues.</span>
                  </div>
                  <div style="display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;color:var(--text-secondary);">
                    <span style="font-size:1.2rem;">2️⃣</span>
                    <span>You get a detailed report with real recommendations within 24 hours.</span>
                  </div>
                  <div style="display:flex;align-items:flex-start;gap:12px;color:var(--text-secondary);">
                    <span style="font-size:1.2rem;">3️⃣</span>
                    <span>No obligation. No sales pitch. Just actionable insights.</span>
                  </div>
                </div>
                <a href="https://cc3po.io/strategy-call" target="_blank" rel="noopener" class="btn btn-primary btn-glow" style="margin-top:16px;display:inline-flex;align-items:center;gap:8px;text-decoration:none;">
                  📞 Book a Strategy Call Instead
                </a>
              </div>
            `;
          }
        } else {
          const err = await res.text().catch(() => 'Unknown error');
          console.error('Supabase error:', res.status, err);
          messageEl.textContent = 'Something went wrong. Please try again or email us directly.';
          messageEl.classList.add('error');
        }
      } catch (e) {
        console.error('Network error:', e);
        messageEl.textContent = 'Network error. Please check your connection and try again.';
        messageEl.classList.add('error');
      }
    }

    document.getElementById('hero-lead-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      submitLead(this, document.getElementById('lf-message'));
    });

    document.getElementById('bottom-lead-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      submitLead(this, document.getElementById('blf-message'));
    });

    // ===== NEWSLETTER FORM =====
    document.getElementById('newsletter-form')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      const email = this.querySelector('[name="email"]').value.trim();
      const msg = document.getElementById('newsletter-message');
      if (!email) return;

      try {
        const res = await fetch(SUPABASE_URL + '/rest/v1/leads', {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_ANON_KEY,
            'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
            'Content-Type': 'application/json',
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({
            name: 'Newsletter',
            email: email,
            phone: null,
            company: null,
            service_interest: 'newsletter',
            message: 'Subscribed to newsletter from homepage',
            source: 'cc3po.com-newsletter',
            lead_type: 'newsletter'
          })
        });

        if (res.ok) {
          msg.textContent = '✓ You're in! Check your inbox for the Signal.';
          msg.style.display = 'block';
          msg.style.color = 'var(--green)';
          this.reset();
        } else {
          msg.textContent = 'Something went wrong. Please try again.';
          msg.style.display = 'block';
          msg.style.color = 'var(--primary)';
        }
      } catch (e) {
        msg.textContent = 'Network error. Please try again.';
        msg.style.display = 'block';
        msg.style.color = 'var(--primary)';
      }
    });

      // Video pause button for accessibility
      const videoPauseBtn = document.getElementById('video-pause-btn');
      const heroVideo = document.querySelector('.hero-video');
      if (videoPauseBtn && heroVideo) {
        videoPauseBtn.addEventListener('click', () => {
          if (heroVideo.paused) {
            heroVideo.play();
            videoPauseBtn.textContent = '⏸';
            videoPauseBtn.setAttribute('aria-label', 'Play background video');
            videoPauseBtn.title = 'Play video';
          } else {
            heroVideo.pause();
            videoPauseBtn.textContent = '▶';
            videoPauseBtn.setAttribute('aria-label', 'Pause background video');
            videoPauseBtn.title = 'Pause video';
          }
        });
        videoPauseBtn.addEventListener('mouseenter', () => { videoPauseBtn.style.opacity = '1'; });
        videoPauseBtn.addEventListener('mouseleave', () => { videoPauseBtn.style.opacity = '0.6'; });
      }
  </script>

</Layout>