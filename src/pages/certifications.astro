---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Certifications & Supplier Diversity — CC3PO" description="CC3PO LLC certifications: CA Certified Small Business SB #2052063, Latino-Owned, SB/DVBE Option. HIPAA compliance scanning, ADA/WCAG audit capability. Meets supplier diversity goals.">

  <nav class="nav" id="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <img src="/images/cc3po-crypto-enhanced.png" alt="CC3PO" class="nav-logo-img nav-logo-full">
        <img src="/images/cc3po-crypto-56px.png" alt="CC3PO" class="nav-logo-img nav-logo-icon" width="56" height="56" loading="eager">
        <span>CC3PO</span>
      </a>
      <ul class="nav-links">
        <li><a href="/services">Services</a></li>
        <li><a href="/government">Government</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
        <li><a href="/ai-compliance">AI Compliance</a></li>
        <li><a href="/certifications" class="active">Certifications</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <a href="/contact" class="nav-cta">Get Started</a>
      <button class="mobile-toggle" aria-label="Menu" aria-expanded="false" id="mobile-menu-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero" id="main-content" style="padding-top:140px;padding-bottom:80px;min-height:60vh;">
    <div class="container" style="max-width:900px;">
      <div class="hero-badge reveal"><span class="pulse-dot"></span>SB #2052063</div>
      <h1 class="hero-title reveal" style="font-size:var(--text-5xl);">Certified. Verified.<br><span style="background:linear-gradient(135deg,#ffd700,#e94560);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Ready to Work.</span></h1>
      <p class="hero-sub reveal" style="max-width:600px;margin:0 auto;">Your supplier diversity goals, our technical excellence. CC3PO helps agencies and enterprises meet diversity targets while delivering advanced AI and automation.</p>
    </div>
  </section>

  <!-- ACTIVE CERTIFICATIONS -->
  <section class="section" style="padding-top:0;">
    <div class="container" style="max-width:1000px;">
      <div class="section-header reveal">
        <div class="section-label">Active Certifications</div>
        <h2 class="section-title">Currently Held</h2>
      </div>
      <div class="proof-grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
        <div class="proof-card reveal" style="border-left:3px solid #ffd700;">
          <div style="font-size:28px;margin-bottom:12px;">🏛️</div>
          <h3 style="color:var(--text-primary);margin-bottom:8px;">California Certified Small Business</h3>
          <p style="color:var(--accent);font-family:var(--font-mono);font-size:14px;margin-bottom:12px;">SB #2052063</p>
          <p style="color:var(--text-muted);font-size:14px;">Auto-approved. Bidder ID: BID0129747. Eligible for 5% bid preference on state contracts. SB/DVBE Option direct awards up to $249,999.99.</p>
          <div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:6px;">
            <span style="background:rgba(255,215,0,0.15);color:#ffd700;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;">Active</span>
            <span style="background:rgba(0,230,118,0.15);color:#00e676;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;">All 58 CA Counties</span>
          </div>
        </div>
        <div class="proof-card reveal" style="border-left:3px solid #e94560;">
          <div style="font-size:28px;margin-bottom:12px;">🌎</div>
          <h3 style="color:var(--text-primary);margin-bottom:8px;">Latino-Owned Business</h3>
          <p style="color:var(--text-muted);font-size:14px;">Hispanic/Latino-owned IT consulting firm. Helps meet corporate and government supplier diversity objectives.</p>
          <div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:6px;">
            <span style="background:rgba(233,69,96,0.15);color:#e94560;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;">Active</span>
          </div>
        </div>
        <div class="proof-card reveal" style="border-left:3px solid #4fc3f7;">
          <div style="font-size:28px;margin-bottom:12px;">🤖</div>
          <h3 style="color:var(--text-primary);margin-bottom:8px;">Microsoft AI Professional</h3>
          <p style="color:var(--text-muted);font-size:14px;">Certified in AI solution design and implementation. Azure AI services expertise.</p>
          <div style="margin-top:12px;">
            <span style="background:rgba(79,195,247,0.15);color:#4fc3f7;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;">Active</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PENDING CERTIFICATIONS -->
  <section class="section" style="background:var(--bg-secondary);">
    <div class="container" style="max-width:1000px;">
      <div class="section-header reveal">
        <div class="section-label">In Progress</div>
        <h2 class="section-title">Certifications We're Pursuing</h2>
        <p class="section-desc">Expanding our supplier diversity profile to unlock more contract opportunities.</p>
      </div>
      <div class="proof-grid" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;">
        <div class="proof-card reveal" style="opacity:0.85;border-left:3px solid rgba(255,215,0,0.4);">
          <h3 style="color:var(--text-primary);font-size:16px;margin-bottom:6px;">NMSDC MBE</h3>
          <p style="color:var(--text-muted);font-size:13px;">National Minority Supplier Development Council. Opens Fortune 500 supplier diversity programs.</p>
          <span style="background:rgba(255,215,0,0.1);color:#ffd700;padding:2px 8px;border-radius:12px;font-size:11px;">Applying</span>
        </div>
        <div class="proof-card reveal" style="opacity:0.85;border-left:3px solid rgba(255,215,0,0.4);">
          <h3 style="color:var(--text-primary);font-size:16px;margin-bottom:6px;">CPUC Supplier Clearinghouse MBE</h3>
          <p style="color:var(--text-muted);font-size:13px;">Opens PG&E, SCE, AT&T utility contracts. FREE certification.</p>
          <span style="background:rgba(255,215,0,0.1);color:#ffd700;padding:2px 8px;border-radius:12px;font-size:11px;">Applying</span>
        </div>
        <div class="proof-card reveal" style="opacity:0.85;border-left:3px solid rgba(255,215,0,0.4);">
          <h3 style="color:var(--text-primary);font-size:16px;margin-bottom:6px;">DBE (CUCP/Caltrans)</h3>
          <p style="color:var(--text-muted);font-size:13px;">Federal transportation contracts. Caltrans, BART, LA Metro, airports. FREE.</p>
          <span style="background:rgba(255,215,0,0.1);color:#ffd700;padding:2px 8px;border-radius:12px;font-size:11px;">Applying</span>
        </div>
        <div class="proof-card reveal" style="opacity:0.85;border-left:3px solid rgba(79,195,247,0.4);">
          <h3 style="color:var(--text-primary);font-size:16px;margin-bottom:6px;">SAM.gov Registration</h3>
          <p style="color:var(--text-muted);font-size:13px;">Required for all federal contracts. UEI number. FREE.</p>
          <span style="background:rgba(79,195,247,0.1);color:#4fc3f7;padding:2px 8px;border-radius:12px;font-size:11px;">Registering</span>
        </div>
        <div class="proof-card reveal" style="opacity:0.85;border-left:3px solid rgba(0,230,118,0.4);">
          <h3 style="color:var(--text-primary);font-size:16px;margin-bottom:6px;">SBA 8(a) Business Development</h3>
          <p style="color:var(--text-muted);font-size:13px;">Sole-source federal contracts up to $4M. Eligible December 2026 (2-year requirement).</p>
          <span style="background:rgba(0,230,118,0.1);color:#00e676;padding:2px 8px;border-radius:12px;font-size:11px;">Eligible Dec 2026</span>
        </div>
      </div>
    </div>
  </section>

  <!-- NAICS / UNSPSC CODES -->
