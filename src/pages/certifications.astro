        </div>
        <div style="background:var(--bg-card);border-radius:var(--radius);padding:24px;">
          <h3 style="color:var(--text-primary);margin-bottom:16px;font-size:16px;">UNSPSC Codes</h3>
          <div style="display:grid;gap:8px;font-size:13px;">
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span style="font-family:var(--font-mono);">81112101</span><span style="color:var(--text-muted);">IT Consulting</span></div>
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span style="font-family:var(--font-mono);">81111504</span><span style="color:var(--text-muted);">Application Programming</span></div>
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span style="font-family:var(--font-mono);">43231501</span><span style="color:var(--text-muted);">Helpdesk Software</span></div>
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span style="font-family:var(--font-mono);">81111501</span><span style="color:var(--text-muted);">Computer Programming</span></div>
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span style="font-family:var(--font-mono);">81112200</span><span style="color:var(--text-muted);">Web Site Development</span></div>
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span style="font-family:var(--font-mono);">72012000</span><span style="color:var(--text-muted);">IT Training</span></div>
          </div>
