        <div style="background:var(--bg-card);border-radius:var(--radius);padding:24px;">
          <h3 style="color:var(--text-primary);margin-bottom:16px;font-size:16px;">NAICS Codes</h3>
          <div style="display:grid;gap:8px;font-size:13px;">
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span>541512</span><span style="color:var(--text-muted);">Computer Systems Design Services</span></div>
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span>541511</span><span style="color:var(--text-muted);">Custom Computer Programming</span></div>
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span>541519</span><span style="color:var(--text-muted);">Other Computer Related Services</span></div>
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span>518210</span><span style="color:var(--text-muted);">Data Processing & Hosting</span></div>
            <div style="display:flex;justify-content:space-between;color:var(--text-secondary);"><span>541690</span><span style="color:var(--text-muted);">Other Scientific & Technical Consulting</span></div>
