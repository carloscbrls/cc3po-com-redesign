---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing — CC3PO">
  <meta http-equiv="refresh" content="0;url=/products/shield/" />
  <script is:inline>
    window.location.href = '/products/shield/';
  </script>
  <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;text-align:center;padding:40px;">
    <div>
      <h1>Redirecting to Pricing…</h1>
      <p>If you are not redirected, <a href="/products/shield/" style="color:var(--accent);text-decoration:underline;">click here</a>.</p>
    </div>
  </div>
</Layout>
