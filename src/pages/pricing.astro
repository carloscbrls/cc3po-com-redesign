---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing — CC3PO">
  <meta http-equiv="refresh" content="0;url=https://offers.cc3po.com/pricing" />
  <script is:inline>
    window.location.href = 'https://offers.cc3po.com/pricing';
  </script>
  <div style="display:flex;align-items:center;justify-content:center;min-height:100vh;text-align:center;padding:40px;">
    <div>
      <h1>Redirecting to Pricing…</h1>
      <p>If you are not redirected, <a href="https://offers.cc3po.com/pricing" style="color:#e94560;text-decoration:underline;">click here</a>.</p>
    </div>
  </div>
</Layout>
