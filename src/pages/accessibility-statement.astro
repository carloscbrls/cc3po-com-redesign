---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Accessibility Statement — CC3PO">

  <!-- Navigation -->
  <nav class="nav" id="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <img src="/images/cc3po-crypto-enhanced.png" alt="CC3PO" class="nav-logo-img nav-logo-full">
        <img src="/images/cc3po-crypto-56px.png" alt="CC3PO" class="nav-logo-img nav-logo-icon" width="56" height="56" loading="eager">
        <span>CC3PO</span>
      </a>
      <ul class="nav-links">
        <li><a href="/services">Services</a></li>
        <li><a href="/government">Government</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
        <li><a href="/certifications">Certifications</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <a href="/contact" class="nav-cta">Get Started</a>
      <button class="mobile-toggle" aria-label="Menu" aria-expanded="false" id="mobile-menu-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero" style="padding-top:120px;padding-bottom:60px;min-height:auto;">
    <div class="container" style="max-width:800px;">
      <div class="section-header reveal" style="text-align:left;">
        <div class="section-label">Legal</div>
        <h1 class="section-title" style="font-size:var(--text-4xl);">Accessibility Statement</h1>
        <p style="color:var(--text-muted);font-size:var(--text-sm);">Last updated: May 4, 2026</p>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="section" style="padding-top:0;">
    <div class="container" style="max-width:800px;">

      <div class="reveal" style="color:var(--text-secondary);line-height:1.8;">
        <h2 style="color:var(--text-primary);margin-bottom:16px;">Our Commitment</h2>
        <p style="margin-bottom:24px;">
          CC3PO LLC is committed to ensuring digital accessibility for people with disabilities. We continually improve the user experience for everyone and apply the relevant accessibility standards.
        </p>
        <p style="margin-bottom:32px;">
          This website is designed to conform to <strong>WCAG 2.1 Level AA</strong> (with ongoing improvements toward WCAG 2.2 AA), in alignment with the Americans with Disabilities Act (ADA), Section 508 of the Rehabilitation Act, and California Government Code § 11135.
        </p>

        <h2 style="color:var(--text-primary);margin-bottom:16px;">Standards &amp; Conformance</h2>
        <p style="margin-bottom:16px;">
          We align our digital properties with the following standards:
        </p>
        <ul style="list-style:disc;padding-left:24px;margin-bottom:32px;">
          <li style="margin-bottom:8px;"><strong>WCAG 2.1 Level AA</strong> — Web Content Accessibility Guidelines</li>
          <li style="margin-bottom:8px;"><strong>Section 508</strong> — Rehabilitation Act of 1973, as amended</li>
          <li style="margin-bottom:8px;"><strong>ADA Title II &amp; III</strong> — Americans with Disabilities Act</li>
          <li style="margin-bottom:8px;"><strong>CA Government Code § 11135</strong> — State accessibility requirements</li>
          <li style="margin-bottom:8px;"><strong>AB 434</strong> — California state agency homepage certification support</li>
        </ul>

        <h2 style="color:var(--text-primary);margin-bottom:16px;">Accessibility Features</h2>
        <ul style="list-style:disc;padding-left:24px;margin-bottom:32px;">
          <li style="margin-bottom:8px;">Semantic HTML structure for screen reader compatibility</li>
          <li style="margin-bottom:8px;">Keyboard navigation support across all interactive elements</li>
          <li style="margin-bottom:8px;">ARIA labels and roles where native semantics are insufficient</li>
          <li style="margin-bottom:8px;">Color contrast ratios meeting WCAG AA minimums (4.5:1 for text)</li>
          <li style="margin-bottom:8px;">Responsive design for all screen sizes and devices</li>
          <li style="margin-bottom:8px;">Focus indicators for keyboard users</li>
          <li style="margin-bottom:8px;">Alt text for meaningful images</li>
          <li style="margin-bottom:8px;">No content reliance on color alone</li>
          <li style="margin-bottom:8px;">Form labels and error messaging for accessibility</li>
        </ul>

        <h2 style="color:var(--text-primary);margin-bottom:16px;">Known Limitations</h2>
        <p style="margin-bottom:32px;">
          Despite our best efforts, some accessibility limitations may exist. We actively monitor and remediate issues as they are identified. Third-party integrations (forms, analytics, chat widgets) may have their own accessibility characteristics outside our direct control.
        </p>

        <h2 style="color:var(--text-primary);margin-bottom:16px;">Our Accessibility Services</h2>
        <p style="margin-bottom:16px;">
          CC3PO provides accessibility audit and remediation services to help organizations meet their compliance obligations:
        </p>
        <ul style="list-style:disc;padding-left:24px;margin-bottom:32px;">
          <li style="margin-bottom:8px;">WCAG 2.1/2.2 AA auditing (automated + manual testing)</li>
          <li style="margin-bottom:8px;">Section 508 compliance assessment</li>
          <li style="margin-bottom:8px;">AB 434 certification support for California agencies</li>
          <li style="margin-bottom:8px;">VPAT / Accessibility Conformance Report (ACR) preparation</li>
          <li style="margin-bottom:8px;">Remediation guidance and implementation</li>
          <li style="margin-bottom:8px;">Ongoing monitoring and re-testing</li>
        </ul>
        <p style="margin-bottom:32px;">
          <a href="/accessibility" style="color:var(--accent);text-decoration:underline;">Learn about our accessibility services →</a>
        </p>

        <h2 style="color:var(--text-primary);margin-bottom:16px;">Feedback &amp; Contact</h2>
        <p style="margin-bottom:16px;">
          We welcome your feedback on the accessibility of this website. If you encounter accessibility barriers, please contact us:
        </p>
        <div style="background:var(--bg-card);border-radius:var(--radius);padding:24px;margin-bottom:32px;">
          <p style="margin-bottom:8px;"><strong>CC3PO LLC</strong></p>
          <p style="margin-bottom:8px;">📧 Email: <a href="mailto:support@cc3po.com" style="color:var(--accent);">support@cc3po.com</a></p>
          <p style="margin-bottom:8px;">📞 Phone: <a href="tel:+12094236633" style="color:var(--accent);">209-423-6633</a></p>
          <p>📍 Lathrop, CA 95330</p>
        </div>
        <p style="margin-bottom:32px;">
          We aim to respond to accessibility feedback within 2 business days and to propose a solution within 10 business days.
        </p>

        <h2 style="color:var(--text-primary);margin-bottom:16px;">Formal Complaints</h2>
        <p>
          If you wish to file a formal complaint regarding accessibility, you may contact the Department of Justice via the <a href="https://www.ada.gov/file-a-complaint/" style="color:var(--accent);text-decoration:underline;" target="_blank" rel="noopener">ADA complaint process</a> or the California Department of Rehabilitation.
        </p>
      </div>

    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div style="font-size:17px;font-weight:800;margin-bottom:8px;">CC3PO</div>
          <p>AI Agents That Work Within Your Rules.</p>
          <div style="margin-top:16px;font-size:0.75rem;color:rgba(255,255,255,0.35);">
            <strong style="color:rgba(255,255,255,0.5);">Certifications:</strong> CA Small Business SB #2052063 · Latino-Owned · SB/DVBE Option · <a href="/certifications" style="color:var(--accent);">View All →</a>
          </div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Services</div>
          <div class="footer-col-links">
            <a href="/services">All Services</a>
            <a href="/accessibility">Accessibility</a>
            <a href="/government">Government</a>
            <a href="/ai-compliance">AI Compliance</a>
          </div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Legal</div>
          <div class="footer-col-links">
            <a href="/accessibility-statement">Accessibility Statement</a>
            <a href="/privacy/">Privacy Policy</a>
            <a href="/terms/">Terms of Service</a>
          </div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Company</div>
          <div class="footer-col-links">
            <a href="/#founder">About</a>
            <a href="/certifications">Certifications</a>
            <a href="/village">The Village</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-copy">© 2026 CC3PO LLC. All rights reserved.</div>
        <div class="footer-legal">
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/accessibility-statement">Accessibility</a>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline>
    // Nav scroll effect
    const nav = document.getElementById('nav');
    let scrollTicking = false;
    window.addEventListener('scroll', () => {
      if (!scrollTicking) {
        requestAnimationFrame(() => {
          nav.classList.toggle('nav-scrolled', window.scrollY > 50);
          scrollTicking = false;
        });
        scrollTicking = true;
      }
    });

    // Scroll reveal
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

    // Mobile menu
    const menuBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.getElementById('drawer-overlay');
    function openDrawer() {
      drawer.classList.add('active');
      overlay.style.display = 'block';
      requestAnimationFrame(() => { overlay.classList.add('active'); });
      menuBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer.classList.remove('active');
      overlay.classList.remove('active');
      menuBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(() => { overlay.style.display = 'none'; }, 300);
    }
    if (menuBtn && drawer && overlay) {
      menuBtn.addEventListener('click', () => {
        if (drawer.classList.contains('active')) closeDrawer();
        else openDrawer();
      });
      overlay.addEventListener('click', closeDrawer);
      drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));
    }
  </script>

</Layout>