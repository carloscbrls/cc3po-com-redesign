<style>
  .legal-page h1 {
    font-size: var(--text-5xl);
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }
  .legal-updated {
    font-size: var(--text-caption);
    color: var(--text-muted);
    margin-bottom: var(--space-2xl);
  }
  .legal-page h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-secondary);
    margin: var(--space-xl) 0 var(--space-sm);
  }
  .legal-page p {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.8;
  }
  .legal-page ul {
    list-style: disc;
    padding-left: 24px;
    margin-bottom: var(--space-md);
  }
  .legal-page li {
    color: var(--text-muted);
    font-size: var(--text-base);
    line-height: 1.8;
    margin-bottom: 8px;
  }
  .legal-page a {
    color: var(--accent);
    transition: color var(--duration-fast);
  }
  .legal-page a:hover {
    color: var(--accent-hover);
  }
  .legal-page code {
    background: rgba(255,255,255,0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>

<script is:inline>
  const nav = document.getElementById('nav');
  let t=false;
  window.addEventListener('scroll',()=>{if(!t){requestAnimationFrame(()=>{nav.classList.toggle('nav-scrolled',window.scrollY>50);t=false});t=true}});
  const ro=new IntersectionObserver((e)=>{e.forEach(en=>{if(en.isIntersecting){en.target.classList.add('revealed');ro.unobserve(en.target)}})},{threshold:0.15});
  document.querySelectorAll('.reveal').forEach(el=>ro.observe(el));
  const mb=document.getElementById('mobile-menu-btn'),dr=document.getElementById('mobile-drawer'),ov=document.getElementById('drawer-overlay');
  function od(){dr.classList.add('active');ov.style.display='block';requestAnimationFrame(()=>ov.classList.add('active'));mb.setAttribute('aria-expanded','true');document.body.style.overflow='hidden'}
  function cd(){dr.classList.remove('active');ov.classList.remove('active');mb.setAttribute('aria-expanded','false');document.body.style.overflow='';setTimeout(()=>ov.style.display='none',300)}
  if(mb&&dr&&ov){mb.addEventListener('click',()=>dr.classList.contains('active')?cd():od());ov.addEventListener('click',cd);dr.querySelectorAll('a').forEach(a=>a.addEventListener('click',cd))}
</script>