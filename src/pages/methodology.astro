          <tr style="border-bottom:1px solid rgba(255,255,255,0.08);"><td style="padding:10px 12px;color:var(--text-primary);">New York</td><td style="padding:10px 12px;">🟠 High</td><td style="padding:10px 12px;color:var(--text-muted);">NY Human Rights Law + ADA Title III</td><td style="padding:10px 12px;color:var(--text-muted);">Major filing jurisdiction</td></tr>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.08);"><td style="padding:10px 12px;color:var(--text-primary);">Florida</td><td style="padding:10px 12px;">🟠 High</td><td style="padding:10px 12px;color:var(--text-muted);">ADA Title III (federal)</td><td style="padding:10px 12px;color:var(--text-muted);">2nd most active state for web suits</td></tr>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.08);"><td style="padding:10px 12px;color:var(--text-primary);">Illinois</td><td style="padding:10px 12px;">🟡 Moderate</td><td style="padding:10px 12px;color:var(--text-muted);">ADA Title III (federal)</td><td style="padding:10px 12px;color:var(--text-muted);">No Unruh-equivalent statutory damages</td></tr>
          <tr><td style="padding:10px 12px;color:var(--text-primary);">Colorado</td><td style="padding:10px 12px;">🟡 Moderate</td><td style="padding:10px 12px;color:var(--text-muted);">ADA Title III (federal)</td><td style="padding:10px 12px;color:var(--text-muted);">Lower litigation volume</td></tr>
