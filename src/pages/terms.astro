        <p style="margin-bottom:8px;"><strong>CC3PO LLC</strong></p>
        <p style="margin-bottom:8px;">16299 Adobe Way, Lathrop, CA 95330</p>
        <p style="margin-bottom:8px;">📧 <a href="mailto:legal@cc3po.com">legal@cc3po.com</a></p>
        <p style="margin-bottom:8px;">📞 <a href="tel:+12097011137">(209) 701-1137</a></p>
      </div>

      <div style="margin-top:48px;text-align:center;">
        <a href="/" class="btn btn-secondary">← Back to Home</a>
