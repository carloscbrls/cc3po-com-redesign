---
import Layout from '../layouts/Layout.astro';
---
<Layout title="AI Compliance & Digital Accessibility — CC3PO" description="AI compliance audits for CA Executive Order N-5-26, WCAG 2.1 AA accessibility audits, VPAT/ACR documentation, and remediation services for government agencies.">
  <!-- ====== HERO ====== -->
  <section class="hero" id="main-content" id="hero" style="min-height:70vh;">
    <div class="hero-content">
      <div class="hero-badge reveal">
        <span class="pulse-dot"></span>
        Compliance Ready
      </div>
      <h1 class="hero-title reveal">
        AI Compliance &<br>
        <span class="typed-gradient">Digital Accessibility</span>
      </h1>
      <p class="hero-sub reveal">
        California EO N-5-26 AI governance audits and WCAG 2.1 AA accessibility compliance —<br>
        documented, audit-ready, and built for government procurement requirements.
      </p>
      <div class="hero-buttons reveal">
        <a href="/contact" class="btn btn-primary btn-glow">
          <span class="btn-icon">📋</span> Request Compliance Assessment
        </a>
        <a href="#services" class="btn btn-secondary">
          <span class="btn-icon">🔍</span> View Services
        </a>
      </div>
    </div>
  </section>

  <!-- ====== TRUST BAR ====== -->
  <section class="section" style="padding:var(--space-2xl) 0;background:var(--bg-secondary);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="container">
      <div class="trust-bar-grid reveal" style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-lg);text-align:center;">
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--accent);margin-bottom:var(--space-2xs);">EO N-5-26</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">AI Governance Compliance</div>
        </div>
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--success);margin-bottom:var(--space-2xs);">WCAG 2.1 AA</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">Accessibility Standards</div>
        </div>
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--blue);margin-bottom:var(--space-2xs);">VPAT/ACR</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">Conformance Documentation</div>
        </div>
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--warning);margin-bottom:var(--space-2xs);">AB 434</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">Agency Certification Support</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== AI COMPLIANCE SECTION ====== -->
  <section class="section" id="ai-compliance-section">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">AI Governance</div>
        <h2 class="section-title">California Executive Order N-5-26 Compliance</h2>
        <p class="section-desc">California agencies must evaluate AI tools for bias, transparency, and security before deployment. We help you meet those requirements with documented AI governance.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(2,1fr);">
        <div class="product-card reveal" style="--accent-color:var(--accent);">
          <div class="product-icon-wrap"><span>📋</span></div>
          <div class="product-name">AI Compliance Audits</div>
          <div class="product-desc">Comprehensive assessment of your AI systems against EO N-5-26 requirements. We evaluate every AI tool your agency uses for bias, transparency, security, and governance gaps — with documented findings and remediation roadmap.</div>
          <div class="product-badge">EO N-5-26 Required</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#4fc3f7;">
          <div class="product-icon-wrap"><span>⚖️</span></div>
          <div class="product-name">Bias Assessment Documentation</div>
          <div class="product-desc">Documented bias evaluations for AI decision-making systems. We test for disparate impact, demographic bias, and algorithmic fairness — producing procurement-ready reports that satisfy state review requirements.</div>
          <div class="product-badge">Procurement-Ready</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:95%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#00e676;">
          <div class="product-icon-wrap"><span>🔍</span></div>
          <div class="product-name">Transparency Reports</div>
          <div class="product-desc">EO N-5-26 requires agencies to document how AI systems make decisions. We produce transparency reports covering data sources, model logic, decision pathways, and human oversight mechanisms for each AI tool.</div>
          <div class="product-badge">Audit-Ready</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:98%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#ffd700;">
          <div class="product-icon-wrap"><span>📦</span></div>
          <div class="product-name">Procurement Compliance Packages</div>
          <div class="product-desc">Complete compliance documentation packages ready for state procurement review. Includes AI inventory, risk assessments, bias evaluations, transparency documentation, and security reviews — everything your agency needs to demonstrate EO N-5-26 compliance.</div>
          <div class="product-badge">Full Package</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== WCAG ACCESSIBILITY SECTION ====== -->
  <section class="section" id="accessibility-section" style="background:var(--bg-secondary);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Digital Accessibility</div>
        <h2 class="section-title">WCAG 2.1 AA & Section 508 Compliance</h2>
        <p class="section-desc">Full accessibility audits, remediation, and documentation to meet ADA Title II, Section 508, and California AB 434 requirements — before regulators find the gaps.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(2,1fr);">
        <div class="product-card reveal" style="--accent-color:var(--accent);">
          <div class="product-icon-wrap"><span>♿</span></div>
          <div class="product-name">WCAG 2.1 AA Compliance Audits</div>
          <div class="product-desc">Thorough audits against WCAG 2.1 Level AA success criteria. We test every page for perceivability, operability, understandability, and robustness — producing a detailed findings report with severity ratings and remediation guidance.</div>
          <div class="product-badge">WCAG 2.1 AA</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#4fc3f7;">
          <div class="product-icon-wrap"><span>🔧</span></div>
          <div class="product-name">Accessibility Remediation</div>
          <div class="product-desc">Code-level fixes for accessibility barriers — ARIA attributes, keyboard navigation, color contrast adjustments, semantic HTML corrections, form labeling, focus management, and screen reader compatibility. We fix what the audit finds.</div>
          <div class="product-badge">Code-Level Fixes</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#00e676;">
          <div class="product-icon-wrap"><span>📄</span></div>
          <div class="product-name">VPAT/ACR Documentation</div>
          <div class="product-desc">We prepare WCAG/Section 508 VPAT® and Accessibility Conformance Reports for custom web solutions and AI tools. Vendor-appropriate documentation that supports California agencies in meeting AB 434 accessibility certification requirements.</div>
          <div class="product-badge">VPAT® / ACR</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:95%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#ffd700;">
          <div class="product-icon-wrap"><span>🏛️</span></div>
          <div class="product-name">AB 434 Agency Support</div>
          <div class="product-desc">Support for California agencies to meet AB 434 (Gov. Code 11546.7) requirements — including testing documentation, conformance evidence, and guidance for directors/CIOs preparing the signed homepage accessibility certification.</div>
          <div class="product-badge">AB 434 Ready</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
      </div>
      <div class="reveal" style="margin-top:var(--space-2xl);padding:var(--space-lg) var(--space-xl);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-md);text-align:center;">
        <p style="color:var(--text-secondary);font-size:var(--text-body);max-width:800px;margin:0 auto;">
          <strong style="color:var(--text-primary);">Our commitment:</strong> This website is designed to conform to WCAG 2.1 Level AA with ongoing improvements toward WCAG 2.2 AA, in alignment with ADA and Section 508 requirements.
        </p>
      </div>
    </div>
  </section>

  <!-- ====== SERVICES & PRICING ====== -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Services & Pricing</div>
        <h2 class="section-title">Compliance Services</h2>
        <p class="section-desc">Transparent pricing for AI governance and accessibility compliance services. SB/DVBE Option eligible.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(4,1fr);">
        <div class="product-card reveal" style="--accent-color:var(--accent);">
          <div class="product-icon-wrap"><span>🤖</span></div>
          <div class="product-name">AI Compliance Audit</div>
          <div class="product-price">Starting at $499</div>
          <div class="product-desc">Full EO N-5-26 assessment — AI inventory, bias evaluation, transparency documentation, and security review for your agency's AI systems.</div>
          <div class="product-badge">EO N-5-26</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#4fc3f7;">
          <div class="product-icon-wrap"><span>♿</span></div>
          <div class="product-name">WCAG 2.1 AA Audit</div>
          <div class="product-price">Starting at $449</div>
          <div class="product-desc">Comprehensive accessibility audit against WCAG 2.1 AA success criteria with detailed findings, severity ratings, and remediation guidance.</div>
          <div class="product-badge">WCAG 2.1 AA</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#00e676;">
          <div class="product-icon-wrap"><span>🔧</span></div>
          <div class="product-name">Accessibility Remediation</div>
          <div class="product-price">Starting at $499</div>
          <div class="product-desc">Code-level fixes for all identified accessibility barriers — ARIA, keyboard nav, color contrast, semantic HTML, form labeling, and screen reader compatibility.</div>
          <div class="product-badge">Code-Level</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#ffd700;">
          <div class="product-icon-wrap"><span>📄</span></div>
          <div class="product-name">VPAT/ACR Documentation</div>
          <div class="product-price">Starting at $299</div>
          <div class="product-desc">WCAG/Section 508 VPAT® and Accessibility Conformance Reports for custom web solutions and AI tools — procurement-ready documentation.</div>
          <div class="product-badge">VPAT® / ACR</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:95%;"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== COMPLIANCE CTA ====== -->
  <section class="cta-section" id="compliance-cta">
    <div class="container cta-content">
      <div class="reveal">
        <h2>Request Compliance Assessment</h2>
        <p>Whether you need an AI governance audit, accessibility review, or full compliance documentation package — we deliver audit-ready results within your procurement timeline.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-primary btn-glow">
            <span class="btn-icon">📋</span> Request Compliance Assessment
          </a>
          <a href="/government" class="btn btn-secondary">
            <span class="btn-icon">🏛️</span> Government Services
          </a>
        </div>
        <div class="cta-trust" style="margin-top:24px;">
          <span>✓ EO N-5-26 Ready</span>
          <span>✓ WCAG 2.1 AA</span>
          <span>✓ VPAT/ACR</span>
          <span>✓ SB/DVBE Option</span>
          <span>✓ AB 434 Support</span>
          <span>✓ Self-Hosted (Data Stays Local)</span>
          <span>✓ NIST AI RMF Aligned</span>
        </div>
        <p style="margin-top:20px;font-size:0.9rem;opacity:0.85;">Need an instant ADA/WCAG accessibility widget while remediation is in progress? <a href="https://dash.accessiblyapp.com/register?ref=carlos78" target="_blank" rel="noopener" style="font-weight:700;">Get Accessibly</a> — via our affiliate link.</p>
      </div>
    </div>
  </section>

  <!-- Schema -->
