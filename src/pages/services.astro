---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services" description="CC3PO services — AI automation, HIPAA compliance, managed IT, website design, and more for healthcare and small businesses.">

  <section class="hero">
    <div class="container">
      <h1>What We Do</h1>
      <p class="hero-sub">AI-powered services that handle the work you don't have time for. From answering calls to staying HIPAA-compliant.</p>
    </div>
  </section>

  <section class="services-section">
    <div class="container">
      <div class="services-grid">

        <a href="https://offers.cc3po.com/daily-content" class="service-card">
          <div class="service-icon">📝</div>
          <h3>Daily Content</h3>
          <p>AI-written blog posts, social media, and newsletters published on autopilot. Your brand, your voice, every day.</p>
          <span class="service-price">From $297/mo</span>
          <span class="service-link">Learn more →</span>
        </a>

        <a href="https://offers.cc3po.com/ai-phone-answering" class="service-card">
          <div class="service-icon">📞</div>
          <h3>AI Phone Answering</h3>
          <p>Never miss a call again. Our AI answers, books appointments, and escalates — 24/7. Built for dental and medical offices.</p>
          <span class="service-price">From $497/mo</span>
          <span class="service-link">Learn more →</span>
        </a>

        <a href="https://offers.cc3po.com/hipaa-compliance" class="service-card">
          <div class="service-icon">🛡️</div>
          <h3>HIPAA Compliance</h3>
          <p>Full HIPAA compliance for dental and medical websites. Security audits, risk assessments, BAAs, and documentation.</p>
          <span class="service-price">From $349 one-time</span>
          <span class="service-link">Learn more →</span>
        </a>

        <a href="https://offers.cc3po.com/website-design" class="service-card">
          <div class="service-icon">🌐</div>
          <h3>Website Design</h3>
          <p>Modern, fast, mobile-first websites built for conversion. HIPAA-compliant options available for healthcare.</p>
          <span class="service-price">From $2,500</span>
          <span class="service-link">Learn more →</span>
        </a>

        <a href="https://offers.cc3po.com/it-consulting" class="service-card">
          <div class="service-icon">🔧</div>
          <h3>Managed IT</h3>
          <p>Proactive IT support, security patching, backups, and monitoring. Your tech stack, handled.</p>
          <span class="service-price">From $197/mo</span>
          <span class="service-link">Learn more →</span>
        </a>

        <a href="https://audit.cc3po.com" class="service-card featured">
          <div class="service-icon">🔍</div>
          <h3>Free Website Audit</h3>
          <p>Get a free comprehensive audit covering speed, security, SEO, mobile, accessibility, and HIPAA compliance.</p>
          <span class="service-price">Free</span>
          <span class="service-link">Get your audit →</span>
        </a>

        <a href="https://offers.cc3po.com/care-plans" class="service-card">
          <div class="service-icon">💰</div>
          <h3>Care Plans</h3>
          <p>IT support that grows with you. Proactive monitoring, priority response, and monthly health checks.</p>
          <span class="service-price">From $97/mo</span>
          <span class="service-link">Learn more →</span>
        </a>

        <a href="https://offers.cc3po.com/sales-engine" class="service-card">
          <div class="service-icon">📈</div>
          <h3>Sales Engine</h3>
          <p>AI-powered lead generation and follow-up. Finds prospects, reaches out, books calls — while you sleep.</p>
          <span class="service-price">From $497/mo</span>
          <span class="service-link">Learn more →</span>
        </a>

      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2>Not sure which service you need?</h2>
      <p>Start with a free website audit. We'll show you exactly what's broken and what to fix first.</p>
      <a href="https://audit.cc3po.com" class="btn btn-primary">Get Your Free Audit</a>
      <a href="/contact" class="btn btn-secondary">Talk to Us</a>
    </div>
  </section>

</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, #050508 0%, #1a0a2e 50%, #050508 100%);
    text-align: center;
    padding: 120px 24px 60px;
  }
  .hero h1 {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    background: linear-gradient(135deg, #fff, #a78bfa, #4fc3f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 16px;
  }
  .hero-sub {
    font-size: 18px;
    color: #a1a1aa;
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .services-section { padding: 60px 0; background: #0a0a0b; }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
  .service-card {
    background: #141418;
    border: 1px solid #2a2a3a;
    border-radius: 16px;
    padding: 28px;
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
  }
  .service-card:hover {
    transform: translateY(-4px);
    border-color: #6b35ff;
    box-shadow: 0 8px 30px rgba(107,53,255,0.2);
  }
  .service-card.featured {
    border-color: #4fc3f7;
    background: linear-gradient(135deg, #141418, #0d1f2d);
  }
  .service-card.featured:hover { border-color: #4fc3f7; }
  .service-icon { font-size: 32px; margin-bottom: 12px; }
  .service-card h3 { color: #fff; font-size: 20px; margin-bottom: 8px; }
  .service-card p { color: #a1a1aa; font-size: 14px; line-height: 1.6; flex: 1; }
  .service-price { color: #4fc3f7; font-weight: 700; font-size: 15px; margin-top: 12px; }
  .service-link { color: #6b35ff; font-weight: 600; font-size: 14px; margin-top: 8px; }
  .service-card:hover .service-link { color: #4fc3f7; }
  .cta-section {
    padding: 80px 0;
    background: linear-gradient(135deg, #0d0d0f, #1a0a2e);
    text-align: center;
  }
  .cta-section h2 { color: #fff; font-size: 32px; margin-bottom: 12px; }
  .cta-section p { color: #a1a1aa; font-size: 18px; margin-bottom: 32px; max-width: 560px; margin-left: auto; margin-right: auto; }
  .btn-primary {
    background: linear-gradient(135deg, #6b35ff, #4fc3f7); color: #fff;
    padding: 14px 32px; border: none; border-radius: 8px; font-size: 16px;
    font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block;
    margin: 0 8px; transition: transform 0.2s;
  }
  .btn-primary:hover { transform: translateY(-1px); }
  .btn-secondary {
    background: transparent; color: #4fc3f7; border: 2px solid #4fc3f7;
    padding: 14px 32px; border-radius: 8px; font-size: 16px;
    font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block;
    margin: 0 8px; transition: background 0.2s;
  }
  .btn-secondary:hover { background: rgba(79,195,247,0.1); }
</style>