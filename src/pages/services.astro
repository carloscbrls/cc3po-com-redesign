---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services — Compliance, Web, IT, AI & Phone Systems | CC3PO" description="CC3PO services — compliance monitoring, website design, IT support, AI automation, and phone systems for small businesses. When services connect, they multiply.">

  <!-- Hero Section with animated gradient -->
  <section class="services-hero" id="main-content">
    <div class="hero-particles" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-content">
      <div class="hero-badge">Full Stack Services</div>
      <h1>Compliance Leads.<br><span class="hero-accent">Full Stack Delivers.</span></h1>
      <p class="hero-sub">ADA compliance gets you in the door. Web development, IT support, AI automation, and phone systems keep you growing. Every service compounds — one improvement lifts everything.</p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">5</span>
          <span class="stat-label">Services</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">9.2+</span>
          <span class="stat-label">Avg LINC Score</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">1</span>
          <span class="stat-label">System</span>
        </div>
      </div>
      <div class="hero-ctas">
        <a href="/intelligence-audit" class="btn btn-primary">Get Your Intelligence Audit →</a>
        <a href="#stacks" class="btn btn-ghost">Explore Stacks ↓</a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="trust-bar">
    <div class="container">
      <div class="trust-items">
        <div class="trust-item">
          <span class="trust-icon">🛡️</span>
          <span>ADA/WCAG Compliant</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">🏛️</span>
          <span>CA Certified Small Business</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">🌎</span>
          <span>Latino-Owned</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon">🔒</span>
          <span>SB/DVBE Eligible</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stacks Section -->
  <section class="stacks-section" id="stacks">
    <div class="container">
      <div class="section-header">
        <span class="section-badge">Service Stacks</span>
        <h2>Five Services. <span class="gold">One System.</span></h2>
        <p>Compliance is the spear. Tech stack is the shaft. Most agencies sell you one thing — we build systems where every piece makes the next piece stronger.</p>
      </div>

      <!-- COMPLIANCE + TECH STACK -->
      <div class="stack">
        <div class="stack-glow" aria-hidden="true"></div>
        <div class="stack-header">
          <div class="stack-icon-wrap">
            <span class="stack-icon">🛡️</span>
          </div>
          <div class="stack-header-text">
            <h3 class="stack-title">Compliance + Tech Stack</h3>
            <p class="stack-tagline">WCAG auditing + automated monitoring + IT support = continuous compliance, not one-and-done</p>
          </div>
          <span class="stack-linc-score"><span class="linc-label">LINC</span> 9.2</span>
        </div>
        <div class="stack-flow">
          <div class="flow-step">
            <div class="flow-dot"></div>
            <div class="flow-content">
              <strong>Compliance identifies the gaps</strong>
              <span>ADA, WCAG & HIPAA audits reveal what's broken</span>
            </div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-dot"></div>
            <div class="flow-content">
              <strong>Web dev & IT fix them</strong>
              <span>Website fixes, IT support, and monitoring keeps them from coming back</span>
            </div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-dot flow-dot--gold"></div>
            <div class="flow-content">
              <strong>Result: Compliance that compounds</strong>
              <span>Every audit makes the tech stack smarter. Every fix prevents the next finding.</span>
            </div>
          </div>
        </div>
        <div class="stack-services">
          <a href="/products/shield/" class="service-card featured">
            <div class="service-card-shine" aria-hidden="true"></div>
            <div class="sc-icon-wrap sc-icon-wrap--shield"><span>🛡️</span></div>
            <h4>Compliance Monitoring</h4>
            <p>ADA, WCAG & HIPAA scanning. Continuous protection from $4K+ lawsuits.</p>
            <span class="sc-price">From $97/mo</span>
          </a>
          <a href="/services/" class="service-card">
            <div class="sc-icon-wrap sc-icon-wrap--web"><span>🌐</span></div>
            <h4>Website Design</h4>
            <p>Modern, fast, mobile-first websites. ADA-compliant. Built for conversion.</p>
            <span class="sc-price">From $2,500</span>
          </a>
          <a href="/services/" class="service-card">
            <div class="sc-icon-wrap sc-icon-wrap--it"><span>🔧</span></div>
            <h4>IT Support</h4>
            <p>Proactive IT, security patching, backups, and monitoring. Your tech stack, handled.</p>
            <span class="sc-price">From $197/mo</span>
          </a>
        </div>
      </div>

      <!-- LOCAL BUSINESS + AI STACK -->
      <div class="stack">
        <div class="stack-glow stack-glow--blue" aria-hidden="true"></div>
        <div class="stack-header">
          <div class="stack-icon-wrap stack-icon-wrap--blue">
            <span class="stack-icon">📞</span>
          </div>
          <div class="stack-header-text">
            <h3 class="stack-title">Local Business + AI Stack</h3>
            <p class="stack-tagline">Website + AI phone answering + automation = no lead left behind</p>
          </div>
          <span class="stack-linc-score stack-linc-score--blue"><span class="linc-label">LINC</span> 9.4</span>
        </div>
        <div class="stack-flow">
          <div class="flow-step">
            <div class="flow-dot"></div>
            <div class="flow-content">
              <strong>Website captures every lead</strong>
              <span>Modern, fast, conversion-optimized design</span>
            </div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-dot"></div>
            <div class="flow-content">
              <strong>AI answers calls 24/7</strong>
              <span>Callie — our AI receptionist — answers, qualifies, and transfers live</span>
            </div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-dot flow-dot--blue"></div>
            <div class="flow-content">
              <strong>Result: Revenue that compounds</strong>
              <span>More captured leads → more data → smarter AI → more conversions</span>
            </div>
          </div>
        </div>
        <div class="stack-services">
          <a href="/services/" class="service-card">
            <div class="sc-icon-wrap sc-icon-wrap--web"><span>🌐</span></div>
            <h4>Website Design</h4>
            <p>Modern, fast, mobile-first websites built for conversion. ADA-compliant.</p>
            <span class="sc-price">From $2,500</span>
          </a>
          <a href="/ai-voice-agent/" class="service-card featured featured--blue">
            <div class="service-card-shine" aria-hidden="true"></div>
            <div class="sc-icon-wrap sc-icon-wrap--callie"><span>📞</span></div>
            <h4>AI Phone Answering (Callie)</h4>
            <p>Never miss a call again. Callie answers, qualifies, and transfers — 24/7.</p>
            <span class="sc-price">From $497/mo</span>
          </a>
          <a href="/ai-workflow-audit/" class="service-card">
            <div class="sc-icon-wrap sc-icon-wrap--ai"><span>🤖</span></div>
            <h4>AI Workflow Audit</h4>
            <p>Find where AI can save you 10+ hours/week. Automate the boring stuff.</p>
            <span class="sc-price">From $497/mo</span>
          </a>
        </div>
      </div>

      <!-- CONTENT + RESEARCH STACK -->
      <div class="stack">
        <div class="stack-glow stack-glow--purple" aria-hidden="true"></div>
        <div class="stack-header">
          <div class="stack-icon-wrap stack-icon-wrap--purple">
            <span class="stack-icon">📝</span>
          </div>
          <div class="stack-header-text">
            <h3 class="stack-title">Content + Research Stack</h3>
            <p class="stack-tagline">Blog + social + research = compounding authority</p>
          </div>
          <span class="stack-linc-score stack-linc-score--purple"><span class="linc-label">LINC</span> 8.7</span>
        </div>
        <div class="stack-flow">
          <div class="flow-step">
            <div class="flow-dot"></div>
            <div class="flow-content">
              <strong>Research feeds content</strong>
              <span>AI-driven insights become blog posts, social posts, newsletters</span>
            </div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-dot"></div>
            <div class="flow-content">
              <strong>Content builds authority</strong>
              <span>Published consistently, optimizing for search and engagement</span>
            </div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-dot flow-dot--purple"></div>
            <div class="flow-content">
              <strong>Result: Authority that compounds</strong>
              <span>Every post strengthens SEO. Content becomes an asset, not an expense.</span>
            </div>
          </div>
        </div>
        <div class="stack-services">
          <a href="/services/" class="service-card">
            <div class="sc-icon-wrap sc-icon-wrap--content"><span>📝</span></div>
            <h4>Daily Content</h4>
            <p>AI-written blog posts, social media, and newsletters on autopilot. Your brand, every day.</p>
            <span class="sc-price">From $297/mo</span>
          </a>
          <a href="/pricing/" class="service-card">
            <div class="sc-icon-wrap sc-icon-wrap--care"><span>💰</span></div>
            <h4>Care Plans</h4>
            <p>IT support that grows with you. Proactive monitoring, priority response, monthly health checks.</p>
            <span class="sc-price">From $97/mo</span>
          </a>
        </div>
      </div>

      <!-- AUTOMATED SERVICES STACK -->
      <div class="stack">
        <div class="stack-glow stack-glow--emerald" aria-hidden="true"></div>
        <div class="stack-header">
          <div class="stack-icon-wrap stack-icon-wrap--emerald">
            <span class="stack-icon">🤖</span>
          </div>
          <div class="stack-header-text">
            <h3 class="stack-title">Automated Services Stack</h3>
            <p class="stack-tagline">AI-powered monitoring, backup, security, and optimization — all automated</p>
          </div>
          <span class="stack-linc-score stack-linc-score--emerald"><span class="linc-label">LINC</span> 8.5</span>
        </div>
        <div class="stack-flow">
          <div class="flow-step">
            <div class="flow-dot"></div>
            <div class="flow-content">
              <strong>AI monitors everything</strong>
              <span>Chatbot compliance, AI visibility, SSL certs, uptime — all checked daily</span>
            </div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-dot"></div>
            <div class="flow-content">
              <strong>Automated fixes & backups</strong>
              <span>Auto-fix disclosures, auto-renew SSL, daily M365/Workspace backups</span>
            </div>
          </div>
          <div class="flow-arrow">→</div>
          <div class="flow-step">
            <div class="flow-dot flow-dot--emerald"></div>
            <div class="flow-content">
              <strong>Result: Zero-touch operations</strong>
              <span>Daily Telegram one-liners, monthly PDFs, 30-day TTL auto-cancel. Set it and forget it.</span>
            </div>
          </div>
        </div>
        <div class="stack-services stack-services--grid">
          <a href="https://insights.cc3po.com/products/disclose-shield/" class="service-card featured featured--emerald">
            <div class="service-card-shine" aria-hidden="true"></div>
            <div class="sc-icon-wrap sc-icon-wrap--shield"><span>🛡️</span></div>
            <h4>DiscloseShield</h4>
            <p>Automated AI chatbot disclosure monitoring for EU AI Act compliance.</p>
            <span class="sc-price">From $67/mo</span>
          </a>
          <a href="https://insights.cc3po.com/products/visible-ai/" class="service-card">
            <div class="sc-icon-wrap"><span>👁️</span></div>
            <h4>VisibleAI</h4>
            <p>Monitor what AI search engines say about your business.</p>
            <span class="sc-price">From $79/mo</span>
          </a>
          <a href="https://insights.cc3po.com/products/backup-shield/" class="service-card">
            <div class="sc-icon-wrap"><span>💾</span></div>
            <h4>BackupShield</h4>
            <p>Automated backup for Microsoft 365 and Google Workspace.</p>
            <span class="sc-price">From $97/mo</span>
          </a>
          <a href="https://insights.cc3po.com/products/secure-stack/" class="service-card">
            <div class="sc-icon-wrap"><span>🔒</span></div>
            <h4>SecureStack</h4>
            <p>EDR, DNS filtering, password manager. Cyber insurance compliant.</p>
            <span class="sc-price">From $37/user/mo</span>
          </a>
          <a href="https://insights.cc3po.com/products/resena/" class="service-card">
            <div class="sc-icon-wrap"><span>⭐</span></div>
            <h4>Reseña</h4>
            <p>Bilingual Google Business Profile review management. AI replies.</p>
            <span class="sc-price">From $97/mo</span>
          </a>
          <a href="https://insights.cc3po.com/products/pixel-diet/" class="service-card">
            <div class="sc-icon-wrap"><span>🖼️</span></div>
            <h4>PixelDiet</h4>
            <p>Automated image optimization and CDN delivery. WebP/AVIF.</p>
            <span class="sc-price">From $39/mo</span>
          </a>
          <a href="https://insights.cc3po.com/products/cert-guard/" class="service-card">
            <div class="sc-icon-wrap"><span>🔐</span></div>
            <h4>CertGuard</h4>
            <p>SSL certificate monitoring and auto-renewal.</p>
            <span class="sc-price">From $19/mo</span>
          </a>
          <a href="https://insights.cc3po.com/products/site-health/" class="service-card">
            <div class="sc-icon-wrap"><span>📊</span></div>
            <h4>SiteHealth</h4>
            <p>Uptime, Core Web Vitals, error monitoring with status pages.</p>
            <span class="sc-price">From $49/mo</span>
          </a>
          <a href="https://insights.cc3po.com/products/inbox-concierge/" class="service-card">
            <div class="sc-icon-wrap"><span>📬</span></div>
            <h4>InboxConcierge</h4>
            <p>Bilingual AI inbox triage. Sorts emails, drafts replies.</p>
            <span class="sc-price">From $97/mo</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Uncarved Block Philosophy -->
  <section class="philosophy-section">
    <div class="container">
      <div class="philosophy-card">
        <div class="philosophy-glow" aria-hidden="true"></div>
        <span class="philosophy-icon">◻️</span>
        <h2>We're Not a Specialist Tool.<br>We're the <span class="gold">Uncarved Block.</span></h2>
        <p>Most agencies do one thing well. We do many things that <em>connect</em> well. The uncarved block — 樸 — represents unlimited potential before it's shaped into something limited. We stay multi-domain, adaptive, compounding. That's why stacks outperform standalone services.</p>
        <div class="philosophy-pillars">
          <div class="pillar">
            <div class="pillar-icon">◇</div>
            <strong>Multi-domain</strong>
            <span>Compliance, IT, content, AI — not siloed, connected</span>
          </div>
          <div class="pillar">
            <div class="pillar-icon">◈</div>
            <strong>Adaptive</strong>
            <span>Stacks flex as your business evolves</span>
          </div>
          <div class="pillar">
            <div class="pillar-icon">◆</div>
            <strong>Compounding</strong>
            <span>Every improvement lifts the whole system</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-glow" aria-hidden="true"></div>
      <h2>Find Out Which Stack Fits Your Business</h2>
      <p>Our Intelligence Architecture Audit maps your current systems and shows you exactly which stack will compound fastest for your business.</p>
      <div class="cta-buttons">
        <a href="https://insights.cc3po.com/products/" class="btn btn-primary">Browse All Products →</a>
        <a href="/intelligence-audit" class="btn btn-outline">Get Your Intelligence Audit</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ===== LUXURY VARIABLES ===== */
  :root {
    --gold: #d4a853;
    --gold-light: #f0d78c;
    --gold-dark: #a67c2e;
    --navy: #0a0e1a;
    --navy-light: #111827;
    --navy-mid: #1a2035;
    --blue-accent: #4fc3f7;
    --emerald: #00e676;
    --purple: #a78bfa;
    --glass-bg: rgba(255, 255, 255, 0.03);
    --glass-border: rgba(255, 255, 255, 0.08);
    --glass-hover: rgba(255, 255, 255, 0.06);
  }

  /* ===== HERO ===== */
  .services-hero {
    position: relative;
    background: linear-gradient(135deg, #050510 0%, #0d1b2a 30%, #1a0a2e 60%, #050510 100%);
    padding: 140px 24px 100px;
    text-align: center;
    overflow: hidden;
  }
  .hero-particles {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(212,168,83,0.3) 50%, transparent 100%),
      radial-gradient(1px 1px at 30% 60%, rgba(212,168,83,0.2) 50%, transparent 100%),
      radial-gradient(1px 1px at 50% 10%, rgba(79,195,247,0.3) 50%, transparent 100%),
      radial-gradient(1px 1px at 70% 80%, rgba(167,139,250,0.2) 50%, transparent 100%),
      radial-gradient(1px 1px at 90% 40%, rgba(212,168,83,0.25) 50%, transparent 100%),
      radial-gradient(1.5px 1.5px at 25% 85%, rgba(255,255,255,0.15) 50%, transparent 100%),
      radial-gradient(1.5px 1.5px at 75% 15%, rgba(255,255,255,0.1) 50%, transparent 100%);
    pointer-events: none;
  }
  .hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(212,168,83,0.08) 0%, rgba(79,195,247,0.04) 40%, transparent 70%);
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 2;
  }
  .hero-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    padding: 6px 20px;
    border: 1px solid rgba(212,168,83,0.3);
    border-radius: 100px;
    background: rgba(212,168,83,0.06);
    margin-bottom: 28px;
  }
  .services-hero h1 {
    font-size: clamp(36px, 5.5vw, 64px);
    font-weight: 800;
    color: #fff;
    margin-bottom: 20px;
    line-height: 1.1;
    letter-spacing: -2px;
  }
  .hero-accent {
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background: linear-gradient(135deg, var(--gold), var(--gold-light), var(--blue-accent));
  }
  .hero-sub {
    font-size: 18px;
    color: rgba(255,255,255,0.65);
    max-width: 600px;
    margin: 0 auto 36px;
    line-height: 1.7;
  }
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-bottom: 40px;
  }
  .stat {
    text-align: center;
  }
  .stat-number {
    display: block;
    font-size: 32px;
    font-weight: 800;
    color: var(--gold);
    letter-spacing: -1px;
  }
  .stat-label {
    font-size: 12px;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.15);
  }
  .hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ===== TRUST BAR ===== */
  .trust-bar {
    background: var(--navy);
    border-top: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
    padding: 20px 0;
  }
  .trust-items {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    font-weight: 500;
  }
  .trust-icon {
    font-size: 18px;
  }

  /* ===== SECTION HEADER ===== */
  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .section-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    padding: 6px 16px;
    border: 1px solid rgba(212,168,83,0.25);
    border-radius: 100px;
    background: rgba(212,168,83,0.06);
    margin-bottom: 16px;
  }
  .section-header h2 {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 800;
    color: #fff;
    margin-bottom: 16px;
    letter-spacing: -1px;
  }
  .gold {
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
  }
  .section-header p {
    font-size: 17px;
    color: rgba(255,255,255,0.6);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ===== STACKS ===== */
  .stacks-section {
    padding: 80px 0;
    background: var(--navy);
  }
  .stack {
    position: relative;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 40px 36px;
    margin-bottom: 36px;
    backdrop-filter: blur(12px);
    transition: border-color 0.4s, box-shadow 0.4s;
    overflow: hidden;
  }
  .stack:hover {
    border-color: rgba(212,168,83,0.2);
    box-shadow: 0 0 60px rgba(212,168,83,0.05);
  }
  .stack-glow {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(212,168,83,0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .stack-glow--blue {
    background: radial-gradient(ellipse, rgba(79,195,247,0.06) 0%, transparent 70%);
  }
  .stack-glow--purple {
    background: radial-gradient(ellipse, rgba(167,139,250,0.06) 0%, transparent 70%);
  }
  .stack-glow--emerald {
    background: radial-gradient(ellipse, rgba(0,230,118,0.06) 0%, transparent 70%);
