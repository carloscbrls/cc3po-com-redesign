---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI for Dental Practices — HIPAA Compliance, Reviews & Website Management | CC3PO" description="AI agents that manage your dental practice's website, reviews, HIPAA compliance, and content — 24/7. Starting at $497/mo. Based in Lathrop, CA.">

  <!-- ====== HERO ====== -->
  <section class="hero dental-hero" id="main-content">
    <canvas id="hero-canvas"></canvas>
    <div class="hero-content">
      <a href="/" class="back-link reveal">← Back to Services</a>
      <div class="hero-badge reveal">
        <span class="pulse-dot"></span>
        Built for dental practices
      </div>

      <h1 class="hero-title reveal">
        AI That Manages Your Dental Practice's Website, Reviews, Compliance & Content
      </h1>

      <p class="hero-sub reveal">
        HIPAA violations cost <strong>$4,000 each</strong>. <strong>72% of patients</strong> check reviews before booking. Your dental website loads in <strong>3.2 seconds</strong> — that's costing you patients. We handle it all. 24/7. One price.
      </p>

      <div class="hero-stats reveal">
        <div class="stat-item">
          <span class="stat-number">$4K</span>
          <span class="stat-label">HIPAA violation cost</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">72%</span>
          <span class="stat-label">Check reviews first</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">3.2s</span>
          <span class="stat-label">Avg dental site load</span>
        </div>
      </div>

      <div class="hero-ctas reveal">
        <a href="/#cta" class="btn btn-primary btn-glow">Free Dental Practice Health Score →</a>
        <a href="https://cc3po.io/strategy-call" class="btn btn-secondary" target="_blank" rel="noopener">📞 Strategy Call</a>
      </div>
    </div>
  </section>

  <!-- ====== TRUST BAR ====== -->
  <section class="trust-bar" style="background: var(--bg-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 16px 0;">
    <div class="container" style="display: flex; align-items: center; justify-content: center; gap: 32px; flex-wrap: wrap; text-align: center;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #ffd700; font-size: 18px;">🏛️</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">CA Certified Small Business</span>
        <span style="color: var(--text-muted); font-size: 12px;">SB #2052063</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: var(--accent); font-size: 18px;">🌎</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">Latino-Owned Business</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #4fc3f7; font-size: 18px;">🛡️</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">SB/DVBE Option Eligible</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #00e676; font-size: 18px;">🌐</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">Se habla español</span>
      </div>
    </div>
  </section>

  <!-- ====== WHAT WE HANDLE ====== -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">What Your Village Handles</div>
        <h2 class="section-title">Everything your dental practice needs. Running 24/7.</h2>
        <p class="section-desc">While you're focused on patients, our AI team is managing your online presence, protecting your compliance, and growing your practice.</p>
      </div>

      <div class="services-grid reveal">
        <div class="service-card">
          <div class="service-icon">🏥</div>
          <h3>HIPAA-Compliant Website Management</h3>
          <p>Your dental website, monitored and maintained to HIPAA standards. Forms, patient portals, privacy policies — all compliant, all the time.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">⭐</div>
          <h3>Review Response (Google & Yelp)</h3>
          <p>Every review answered within 30 minutes — professionally, personally, and in a way that protects your reputation and attracts new patients.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">♿</div>
          <h3>ADA & WCAG Accessibility</h3>
          <p>ADA lawsuits targeting dental websites are rising. We scan, fix, and monitor your site so you stay compliant and avoid $4,000+ fines.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📱</div>
          <h3>Social Media Content</h3>
          <p>Consistent dental content that educates patients and builds your practice's authority. Posted automatically, every week.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🛡️</div>
          <h3>Compliance Monitoring</h3>
          <p>HIPAA, CCPA, California Dental Board regulations — we watch for changes and update your practice before violations happen.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📅</div>
          <h3>Appointment Follow-Ups</h3>
          <p>Automated reminders, recare scheduling, and follow-ups that keep your chairs full and patients coming back.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== CALIFORNIA COMPLIANCE ====== -->
  <section class="section" style="background: var(--bg-secondary);" id="compliance">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">California Compliance</div>
        <h2 class="section-title">Dental practices in California face 5 major compliance areas.</h2>
        <p class="section-desc">We monitor and manage all of them. Automatically.</p>
      </div>

      <div class="compliance-grid reveal">
        <div class="compliance-item">
          <div class="compliance-icon">🔒</div>
          <h3>HIPAA</h3>
          <p>Health Insurance Portability and Accountability Act — website forms, patient data handling, BAA requirements, and breach notification protocols.</p>
          <div class="compliance-risk">Risk: <strong>$4,000+ per violation</strong></div>
        </div>
        <div class="compliance-item">
          <div class="compliance-icon">📋</div>
          <h3>CCPA</h3>
          <p>California Consumer Privacy Act — patient data rights, privacy policy requirements, opt-out mechanisms, and data handling disclosures.</p>
          <div class="compliance-risk">Risk: <strong>$7,500 per intentional violation</strong></div>
        </div>
        <div class="compliance-item">
          <div class="compliance-icon">🦷</div>
          <h3>Dental Board Regulations</h3>
          <p>California Dental Practice Act — advertising rules, license display requirements, scope of practice disclosures on your website.</p>
          <div class="compliance-risk">Risk: <strong>License action possible</strong></div>
        </div>
        <div class="compliance-item">
          <div class="compliance-icon">⚖️</div>
          <h3>Unruh Act</h3>
          <p>California Civil Code §51 — website accessibility requirements for places of public accommodation. $4,000+ statutory damages per violation.</p>
          <div class="compliance-risk">Risk: <strong>$4,000+ per violation</strong></div>
        </div>
        <div class="compliance-item">
          <div class="compliance-icon">♿</div>
          <h3>ADA / WCAG</h3>
          <p>Americans with Disabilities Act — WCAG 2.1 AA compliance for your dental website. Screen readers, contrast, navigation, alt text.</p>
          <div class="compliance-risk">Risk: <strong>Lawsuit + settlement costs</strong></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== COMPARISON TABLE ====== -->
  <section class="section" id="comparison">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">The Math for Dental Practices</div>
        <h2 class="section-title">What it costs to hire separately vs. CC3PO.</h2>
      </div>

      <div class="comparison-table-wrap reveal">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Hire Separately</th>
              <th>Cost/mo</th>
              <th>CC3PO</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Web developer (dental experience)</td>
              <td class="cost-cell">$5,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Social media manager</td>
              <td class="cost-cell">$3,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>HIPAA compliance consultant</td>
              <td class="cost-cell">$2,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Review management service</td>
              <td class="cost-cell">$1,500</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>SEO specialist</td>
              <td class="cost-cell">$2,500</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr class="total-row">
              <td><strong>Total</strong></td>
              <td class="cost-cell"><strong>$14,000/mo</strong></td>
              <td class="included-cell"><strong>Starting at $497/mo</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ====== TESTIMONIALS ====== -->
  <section class="section" id="proof">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Proof</div>
        <h2 class="section-title">Real businesses. Real results.</h2>
      </div>
      <div class="testimonials-grid reveal">
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"I used to spend 3 hours a day managing reviews and social media. Now I wake up and it's all done. My Business Health Score went from 52 to 87 in two months."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Dr. Alan Lee</div>
            <div class="testimonial-role">Sunrise Dental, Stockton CA</div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"The compliance scanning alone is worth it. We had 14 ADA violations we didn't know about. Sentinel found them, fixed them, and now we're clean. That would've been a $4,000 fine per violation."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Matt Safdari</div>
            <div class="testimonial-role">Top Class Fitness, Modesto CA</div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"I was skeptical about AI running my business. Then I got my first morning report and realized — they actually did everything while I slept. My Google reviews went from 3.2 to 4.7 stars."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Julius Jones</div>
            <div class="testimonial-role">Central Valley Auto, Lathrop CA</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== FAQ ====== -->
  <section class="section" style="background: var(--bg-secondary);" id="faq">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">FAQ</div>
        <h2 class="section-title">Questions dental practices ask us.</h2>
      </div>

      <div class="faq-list reveal">
        <details class="faq-item">
          <summary>How do you ensure my dental website is HIPAA compliant?</summary>
          <div class="faq-answer">
            <p>We continuously scan your website for HIPAA violations — unsecured patient forms, missing privacy policies, non-compliant contact forms, and improper data handling. Our AI agents monitor for regulation changes and update your site before violations occur. We also ensure all Business Associate Agreements (BAAs) are in place with any third-party services handling patient data.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Can an AI receptionist handle dental appointment scheduling?</summary>
          <div class="faq-answer">
            <p>Yes. Our AI voice agent (Callie) answers calls 24/7, schedules appointments directly into your practice management software, handles insurance inquiries, and sends automated reminders. She never takes a day off, never puts a patient on hold, and follows your exact protocols for scheduling and emergencies.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>What dental practice automation tools do you offer for California practices?</summary>
          <div class="faq-answer">
            <p>Our dental practice automation covers five critical areas for California practices: HIPAA compliance monitoring and remediation, review management across Google and Yelp, social media content creation and scheduling, website speed and accessibility optimization, and California Dental Board regulation compliance. All running 24/7, all included in one monthly price.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>How do you handle patient reviews for dental offices?</summary>
          <div class="faq-answer">
            <p>Our AI reviews every new Google and Yelp review within 30 minutes. Positive reviews get personalized thank-you responses that reinforce patient loyalty. Negative reviews get professional, empathetic responses that protect your reputation and demonstrate your commitment to patient care. You approve responses before they're posted — or let our AI handle it automatically based on your guidelines.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>What makes CC3PO different from other dental marketing agencies?</summary>
          <div class="faq-answer">
            <p>We're not a marketing agency — we're an AI village that runs your entire digital operation. Agencies charge $3,000–$5,000/month for just one service. We give you a full team (website, reviews, social, compliance, SEO, voice agent) for $497/month. Plus, we're a CA Certified Small Business (SB #2052063), which means our services may qualify for your small business procurement programs.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Do you help with California Dental Board advertising compliance?</summary>
          <div class="faq-answer">
            <p>Absolutely. The California Dental Practice Act has specific advertising requirements — license display, scope of practice disclosures, "false or misleading" language prohibitions, and more. We audit your website and marketing materials against current Dental Board regulations and fix violations before they become problems.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>How quickly can you improve my dental practice's online presence?</summary>
          <div class="faq-answer">
            <p>Most dental practices see measurable improvement within the first month: reviews responded to within 30 minutes, website compliance issues fixed, social media posting on schedule. By month three, practices typically see their Business Health Score climb 20–30 points, with better review ratings, faster website speed, and full compliance documentation.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ====== CTA ====== -->
  <section class="cta-section" id="cta">
    <div class="container cta-content">
      <div class="reveal">
        <h2>Your dental practice health score is waiting.</h2>
        <p>Find out where your website, reviews, compliance, and online presence stand — free, in 30 seconds.</p>
        <div class="cta-trust" style="margin-top:24px;">
          <span>✓ No credit card</span>
          <span>✓ HIPAA compliance check</span>
          <span>✓ ADA/WCAG scan</span>
          <span>✓ Real recommendations</span>
        </div>
        <div class="hero-ctas" style="margin-top:32px;">
          <a href="/#cta" class="btn btn-primary btn-glow">Free Dental Practice Health Score →</a>
          <a href="https://cc3po.io/strategy-call" class="btn btn-secondary" target="_blank" rel="noopener">📞 Strategy Call</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div style="font-size:17px;font-weight:800;margin-bottom:8px;">CC3PO</div>
          <p>Your whole business team. One price. 24/7.</p>
          <p class="footer-tagline" style="margin-top:12px;font-size:0.75rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,0.4);">Build once. Run forever. Evolve continuously.</p>
          <div style="margin-top:16px;font-size:0.75rem;color:rgba(255,255,255,0.35);line-height:1.5;"><strong style="color:rgba(255,255,255,0.5);">Certifications:</strong> CA Certified Small Business — SB #2052063 · Latino-Owned Business · Se habla español · SB/DVBE Option · <a href="/certifications" style="color:var(--accent);">View All →</a></div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Services</div>
          <div class="footer-col-links">
            <a href="/dental">Dental Practices</a>
