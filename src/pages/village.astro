        { greek: 'Spark ✨', title: 'Social & Engagement', emoji: '✨', photo: '/images/authors/spark.png', desc: 'Walks into a room and the energy shifts. Ideas always sparking behind her eyes.', quote: 'If it doesn\'t make you feel something, it\'s not done.' },
