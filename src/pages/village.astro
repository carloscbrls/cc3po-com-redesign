        { greek: 'Lens 🎥', title: 'Video & Visual Content', emoji: '🎥', photo: '/images/authors/lens.png', desc: 'Always framing something in his mind even without a camera. Sees the shot before it exists.', quote: 'The best angle isn\'t found. It\'s felt.' },
      ]
    },
    {
