---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Your Digital Team — CC3PO">
  <div id="village-app" role="main" aria-label="Main content">
    <!-- Canvas for particles -->
    <canvas id="particle-canvas"></canvas>

    <!-- Header -->
    <header class="village-header">
      <div class="header-content">
        <h1 class="village-title">Your Digital Team</h1>
        <p class="village-subtitle">23 specialists with their own voices, faces, and expertise — coordinated so your business never stops.</p>
        <div class="status-bar">
          <span class="status-dot active"></span>
          <span class="status-text">All Systems Operational</span>
          <span class="status-separator">|</span>
          <span class="status-count"><span id="active-count">22</span> Team Members Active</span>
        </div>
      </div>
    </header>

    <!-- How It Works Section -->
    <section class="how-it-works">
      <h2 class="section-heading">How Your Digital Team Works</h2>
      <div class="steps-grid">
        <div class="step-card">
          <span class="step-number">1</span>
          <h3>Map Your Workflow</h3>
          <p>We break down your process step by step — lead intake, follow-up, scheduling, reporting — and identify where things slow down or fall through the cracks.</p>
        </div>
        <div class="step-card">
          <span class="step-number">2</span>
          <h3>Assign the Right Assistants</h3>
          <p>Each step gets a specialist — a researcher for deep-dive, a writer for outreach, a dispatcher for routing. No generalists doing everything poorly.</p>
        </div>
        <div class="step-card">
          <span class="step-number">3</span>
          <h3>Coordinate in Real Time</h3>
          <p>Your digital assistants hand off tasks to each other automatically — like a well-run office where the researcher's findings go straight to the writer, then to the dispatcher.</p>
        </div>
        <div class="step-card">
          <span class="step-number">4</span>
          <h3>Dashboard + Human Override</h3>
          <p>See everything in one place. Approve, adjust, or take over any step. You're always in control — the team works for you, not instead of you.</p>
        </div>
      </div>
    </section>

    <!-- Main Team Section -->
    <main class="village-main">

      <!-- Command -->
      <section class="department" id="dept-command">
        <div class="department-label">
          <span class="dept-icon">🎯</span>
          <h2>Command</h2>
          <span class="dept-tagline">Strategic coordination & leadership</span>
        </div>
        <div class="agents-grid"></div>
      </section>

      <!-- Intelligence -->
      <section class="department" id="dept-intelligence">
        <div class="department-label">
          <span class="dept-icon">🔬</span>
          <h2>Intelligence</h2>
          <span class="dept-tagline">Research, analysis & insights</span>
        </div>
        <div class="agents-grid"></div>
      </section>

      <!-- Content Studio -->
      <section class="department" id="dept-content">
        <div class="department-label">
          <span class="dept-icon">🎨</span>
          <h2>Content Studio</h2>
          <span class="dept-tagline">Writing, media & publishing</span>
        </div>
        <div class="agents-grid"></div>
      </section>

      <!-- Operations -->
      <section class="department" id="dept-operations">
        <div class="department-label">
          <span class="dept-icon">⚙️</span>
          <h2>Operations</h2>
          <span class="dept-tagline">Tasks, onboarding & support</span>
        </div>
        <div class="agents-grid"></div>
      </section>

      <!-- Communications -->
      <section class="department" id="dept-communications">
        <div class="department-label">
          <span class="dept-icon">📡</span>
          <h2>Communications</h2>
          <span class="dept-tagline">Email, phone & social outreach</span>
        </div>
        <div class="agents-grid"></div>
      </section>

      <!-- Engineering -->
      <section class="department" id="dept-engineering">
        <div class="department-label">
          <span class="dept-icon">🔧</span>
          <h2>Engineering</h2>
          <span class="dept-tagline">Automation & infrastructure</span>
        </div>
        <div class="agents-grid"></div>
      </section>

      <!-- Compliance -->
      <section class="department" id="dept-compliance">
        <div class="department-label">
          <span class="dept-icon">🛡️</span>
          <h2>Compliance</h2>
          <span class="dept-tagline">Audits, accessibility & reporting</span>
        </div>
        <div class="agents-grid"></div>
      </section>

    </main>

    <!-- Proof & Safety Section -->
    <section class="proof-section">
      <h2 class="section-heading">You're Always in Control</h2>
      <div class="proof-grid">
        <div class="proof-card">
          <span class="proof-icon">👁️</span>
          <h3>Human-in-the-Loop Reviews</h3>
          <p>Every critical action goes through your approval first. The team suggests — you decide.</p>
        </div>
        <div class="proof-card">
          <span class="proof-icon">📜</span>
          <h3>Full Audit Log</h3>
          <p>Every action is logged with timestamps. You always know who did what, when, and why.</p>
        </div>
        <div class="proof-card">
          <span class="proof-icon">🔄</span>
          <h3>Clear Failover</h3>
          <p>If a digital assistant can't handle something, it escalates to you — never silently fails.</p>
        </div>
        <div class="proof-card">
          <span class="proof-icon">🔐</span>
          <h3>Your Tools, Your Data</h3>
          <p>Works with your existing email, CRM, and calendar. Nothing leaves your stack.</p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="village-footer">
      <p class="motto">BUILD ONCE. RUN FOREVER. <span class="motto-highlight">EVOLVE CONTINUOUSLY.</span></p>
      <p class="footer-sub">The CC3PO Digital Team — Coordinated assistants that work together.</p>
    </footer>

  </div>
</Layout>

<style>
  /* ===== CSS VARIABLES ===== */
  :root {
    --bg-primary: #0a0a0b;
    --bg-secondary: #111114;
    --bg-card: #16161a;
    --bg-card-hover: #1c1c22;
    --purple-primary: #6b35ff;
    --purple-glow: rgba(107, 53, 255, 0.4);
    --purple-dim: rgba(107, 53, 255, 0.15);
    --gold-primary: #FFD700;
    --gold-glow: rgba(255, 215, 0, 0.4);
    --gold-dim: rgba(255, 215, 0, 0.15);
    --cyan-primary: #00d2ff;
    --cyan-glow: rgba(0, 210, 255, 0.3);
    --cyan-dim: rgba(0, 210, 255, 0.1);
    --green-primary: #00ff88;
    --green-glow: rgba(0, 255, 136, 0.3);
    --green-dim: rgba(0, 255, 136, 0.1);
    --text-primary: #e8e8ed;
    --text-secondary: #8888a0;
    --text-muted: #55556a;
    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-glow: rgba(255, 255, 255, 0.12);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    --transition-fast: 0.15s ease;
    --transition-base: 0.3s ease;
    --transition-slow: 0.5s ease;
  }

  /* ===== GLOBAL ===== */
  #village-app {
    position: relative;
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
  }
  #village-app * { box-sizing: border-box; }

  #village-app::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 0;
    pointer-events: none;
  }

  #particle-canvas {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* ===== HEADER ===== */
  .village-header {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 80px 24px 40px;
    background: radial-gradient(ellipse at center top, rgba(107, 53, 255, 0.08) 0%, transparent 60%);
  }

  .village-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
    background: linear-gradient(135deg, var(--cyan-primary), var(--purple-primary), var(--gold-primary));
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 8s ease infinite;
  }

  .village-subtitle {
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    margin: 12px 0 24px;
    font-weight: 400;
  }

  .status-bar {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 24px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .status-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #555;
  }
  .status-dot.active {
    background: #00ff88;
    box-shadow: 0 0 8px rgba(0, 255, 136, 0.5);
    animation: pulse-dot 2s ease infinite;
  }
  .status-separator { color: var(--text-muted); }

  /* ===== SECTION HEADING ===== */
  .section-heading {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 700;
    text-align: center;
    color: var(--text-primary);
    margin-bottom: 40px;
  }

  /* ===== HOW IT WORKS ===== */
  .how-it-works {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 24px 40px;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }

  .step-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    transition: all var(--transition-base);
    position: relative;
  }

  .step-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-glow);
    box-shadow: 0 8px 32px var(--cyan-dim);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--cyan-dim);
    color: var(--cyan-primary);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 800;
    font-size: 0.95rem;
    margin-bottom: 16px;
  }

  .step-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 8px;
  }

  .step-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ===== MAIN TEAM LAYOUT ===== */
  .village-main {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ===== DEPARTMENTS ===== */
  .department {
    padding: 32px 0;
  }

  .department-label {
    text-align: center;
    margin-bottom: 24px;
  }

  .dept-icon {
    font-size: 1.4rem;
    display: block;
    margin-bottom: 6px;
  }

  .department-label h2 {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
  }

  .dept-tagline {
    display: block;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* ===== AGENTS GRID ===== */
  .agents-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }

  @media (min-width: 768px) {
    .agents-grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 20px;
    }
  }

  /* ===== ROLE CARD ===== */
  .role-card {
    position: relative;
    padding: 24px 20px 20px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
    overflow: hidden;
  }

  .role-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    transition: all var(--transition-base);
  }

  .role-card:hover {
    transform: translateY(-4px);
    background: var(--bg-card-hover);
    border-color: var(--border-glow);
  }

  /* Department color accents */
  #dept-command .role-card::before { background: linear-gradient(90deg, transparent, var(--gold-primary), transparent); }
  #dept-command .role-card:hover { box-shadow: 0 8px 32px var(--gold-glow), 0 0 0 1px var(--gold-dim); }

  #dept-intelligence .role-card::before { background: linear-gradient(90deg, transparent, var(--cyan-primary), transparent); }
  #dept-intelligence .role-card:hover { box-shadow: 0 8px 32px var(--cyan-glow), 0 0 0 1px var(--cyan-dim); }

  #dept-content .role-card::before { background: linear-gradient(90deg, transparent, var(--purple-primary), transparent); }
  #dept-content .role-card:hover { box-shadow: 0 8px 32px var(--purple-glow), 0 0 0 1px var(--purple-dim); }

  #dept-operations .role-card::before { background: linear-gradient(90deg, transparent, var(--green-primary), transparent); }
  #dept-operations .role-card:hover { box-shadow: 0 8px 32px var(--green-glow), 0 0 0 1px var(--green-dim); }

  #dept-communications .role-card::before { background: linear-gradient(90deg, transparent, var(--cyan-primary), transparent); }
  #dept-communications .role-card:hover { box-shadow: 0 8px 32px var(--cyan-glow), 0 0 0 1px var(--cyan-dim); }

  #dept-engineering .role-card::before { background: linear-gradient(90deg, transparent, var(--gold-primary), transparent); }
  #dept-engineering .role-card:hover { box-shadow: 0 8px 32px var(--gold-glow), 0 0 0 1px var(--gold-dim); }

  #dept-compliance .role-card::before { background: linear-gradient(90deg, transparent, var(--purple-primary), transparent); }
  #dept-compliance .role-card:hover { box-shadow: 0 8px 32px var(--purple-glow), 0 0 0 1px var(--purple-dim); }

  .role-card:hover::before { height: 3px; }

  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .card-emoji {
    font-size: 1.8rem;
    filter: drop-shadow(0 0 6px rgba(255,255,255,0.15));
    transition: filter var(--transition-base);
  }

  .role-card:hover .card-emoji {
    filter: drop-shadow(0 0 12px rgba(255,255,255,0.35));
    animation: emoji-float 2s ease infinite;
  }

  .card-names {
    flex: 1;
    min-width: 0;
  }

  .card-greek {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .card-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .card-portrait {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.4);
    transition: transform var(--transition-base);
  }

  .role-card:hover .card-portrait {
    transform: scale(1.05);
  }

  .card-quote {
    font-size: 0.75rem;
    font-style: italic;
    color: var(--text-muted);
    margin: 8px 0 0;
    line-height: 1.4;
    opacity: 0.8;
    transition: opacity var(--transition-base);
  }

  .role-card:hover .card-quote {
    opacity: 1;
  }

  /* ===== PROOF SECTION ===== */
  .proof-section {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 60px auto 0;
    padding: 60px 24px 40px;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }

  .proof-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    text-align: center;
    transition: all var(--transition-base);
  }

  .proof-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-glow);
    box-shadow: 0 8px 32px var(--green-dim);
  }

  .proof-icon {
    font-size: 2.2rem;
    display: block;
    margin-bottom: 12px;
  }

  .proof-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 8px;
  }

  .proof-card p {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ===== FOOTER ===== */
  .village-footer {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 60px 24px 80px;
    background: radial-gradient(ellipse at center bottom, var(--cyan-dim) 0%, transparent 60%);
  }

  .motto {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(0.9rem, 2vw, 1.3rem);
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
    margin: 0 0 12px;
  }

  .motto-highlight {
    background: linear-gradient(135deg, var(--cyan-primary), var(--purple-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ===== ANIMATIONS ===== */
  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @keyframes emoji-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 600px) {
    .village-header { padding: 60px 16px 24px; }
    .department { padding: 20px 0; }
    .agents-grid { gap: 12px; }
    .role-card { padding: 18px 14px 16px; }
    .card-emoji { font-size: 1.4rem; }
    .card-title { font-size: 0.85rem; }
    .card-desc { font-size: 0.75rem; }
    .how-it-works { padding: 40px 16px 24px; }
    .steps-grid { gap: 12px; }
    .step-card { padding: 20px 16px; }
    .proof-section { padding: 40px 16px 24px; }
    .status-bar { font-size: 0.75rem; padding: 8px 16px; gap: 8px; }
  }
</style>

<script>
  // ===== TEAM DATA (grouped by department) =====
  const departments = [
    {
      id: 'dept-command',
      members: [
        { greek: 'Atlas 🌍', title: 'Systems Coordinator', emoji: '🌍', photo: '/images/authors/atlas.png', desc: 'Carries the weight — coordinates every system, connection, and workflow across the team.', quote: 'I calculated the load. It holds.' },
