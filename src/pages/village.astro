    { name: 'Cody', emoji: '💬', role: 'Customer Support', identity: 'Every customer deserves a human-like response — instantly. That\'s me.', status: 'active' },
    { name: 'Onboard', emoji: '🎯', role: 'Client Onboarding', identity: 'First impressions last. I make onboarding seamless, fast, and impressive.', status: 'active' },
    { name: 'Rev', emoji: '⭐', role: 'Reviews Monitoring', identity: 'Reputation is everything. I track, respond, and protect — every review matters.', status: 'idle' },
    { name: 'Kathryn', emoji: '🤝', role: 'Lead Handler & Onboarding', identity: 'The human touch in an AI world. I bridge leads to clients with care.', status: 'active' },
