---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CC3PO Village — The AI Ecosystem Live Dashboard">
  <div id="village-app">
    <!-- Canvas for particles -->
    <canvas id="particle-canvas"></canvas>

    <!-- Header -->
    <header class="village-header">
      <div class="header-content">
        <h1 class="village-title">The Village</h1>
        <p class="village-subtitle">26 AI Agents. 2 Villages. 1 Ecosystem.</p>
        <div class="status-bar">
          <span class="status-dot active"></span>
          <span class="status-text">All Systems Operational</span>
          <span class="status-separator">|</span>
          <span class="status-count"><span id="active-count">26</span> Agents Active</span>
        </div>
      </div>
    </header>

    <!-- Main Village Scene -->
    <main class="village-main">
      <!-- Mac Mini Village -->
      <section class="village-cluster mac-mini-village" id="mac-village">
        <div class="village-label">
          <span class="village-icon">🖥️</span>
          <h2>Mac Mini Village</h2>
          <span class="village-tagline">The Foundation</span>
        </div>
        <div class="agents-grid" id="mac-agents"></div>
      </section>

      <!-- Bridge -->
      <section class="village-bridge" id="bridge-section">
        <div class="bridge-glow"></div>
        <div class="bridge-line"></div>
        <div class="bridge-particles" id="bridge-particles"></div>
        <div class="bridge-label">
          <span class="bridge-icon">⟷</span>
          <span>Neural Link</span>
        </div>
      </section>

      <!-- Droplet Village -->
      <section class="village-cluster droplet-village" id="droplet-village">
        <div class="village-label">
          <span class="village-icon">☁️</span>
          <h2>Droplet Village</h2>
          <span class="village-tagline">The Edge</span>
        </div>
        <div class="agents-grid" id="droplet-agents"></div>
      </section>
    </main>

    <!-- Activity Feed -->
    <section class="activity-section" id="activity-section">
      <h3 class="section-title">Live Activity</h3>
      <div class="activity-feed" id="activity-feed"></div>
    </section>

    <!-- Motto -->
    <footer class="village-footer">
      <p class="motto">BUILD ONCE. RUN FOREVER. <span class="motto-highlight">EVOLVE CONTINUOUSLY.</span></p>
      <p class="footer-sub">The CC3PO Village — Autonomous AI Ecosystem</p>
    </footer>

    <!-- Agent Modal -->
    <div class="agent-modal" id="agent-modal">
      <div class="modal-backdrop" id="modal-backdrop"></div>
      <div class="modal-content" id="modal-content"></div>
    </div>
  </div>
</Layout>

<style>
  /* ===== CSS VARIABLES ===== */
  :root {
    --bg-primary: #0a0a0b;
    --bg-secondary: #111114;
    --bg-card: #16161a;
    --bg-card-hover: #1c1c22;
    --purple-primary: #6b35ff;
    --purple-glow: rgba(107, 53, 255, 0.4);
    --purple-dim: rgba(107, 53, 255, 0.15);
    --gold-primary: #FFD700;
    --gold-glow: rgba(255, 215, 0, 0.4);
    --gold-dim: rgba(255, 215, 0, 0.15);
    --cyan-primary: #00d2ff;
    --cyan-glow: rgba(0, 210, 255, 0.3);
    --cyan-dim: rgba(0, 210, 255, 0.1);
    --text-primary: #e8e8ed;
    --text-secondary: #8888a0;
    --text-muted: #55556a;
    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-glow: rgba(255, 255, 255, 0.12);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    --transition-fast: 0.15s ease;
    --transition-base: 0.3s ease;
    --transition-slow: 0.5s ease;
  }

  /* ===== GLOBAL RESET FOR VILLAGE ===== */
  #village-app {
    position: relative;
    min-height: 100vh;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
  }

  #village-app * {
    box-sizing: border-box;
  }

  /* ===== PARTICLE CANVAS ===== */
  #particle-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* ===== HEADER ===== */
  .village-header {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 80px 24px 40px;
    background: radial-gradient(ellipse at center top, rgba(107, 53, 255, 0.08) 0%, transparent 60%);
  }

  .village-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
    background: linear-gradient(135deg, var(--cyan-primary), var(--purple-primary), var(--gold-primary));
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 8s ease infinite;
  }

  .village-subtitle {
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    margin: 12px 0 24px;
    font-weight: 400;
  }

  .status-bar {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 24px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #555;
  }
  .status-dot.active {
    background: #00ff88;
    box-shadow: 0 0 8px rgba(0, 255, 136, 0.5);
    animation: pulse-dot 2s ease infinite;
  }

  .status-separator {
    color: var(--text-muted);
  }

  /* ===== MAIN LAYOUT ===== */
  .village-main {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ===== VILLAGE CLUSTERS ===== */
  .village-cluster {
    padding: 40px 0;
  }

  .village-label {
    text-align: center;
    margin-bottom: 32px;
  }

  .village-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 8px;
  }

  .village-label h2 {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 700;
    margin: 0;
  }

  .mac-mini-village .village-label h2 {
    color: var(--purple-primary);
    text-shadow: 0 0 30px var(--purple-glow);
  }

  .droplet-village .village-label h2 {
    color: var(--gold-primary);
    text-shadow: 0 0 30px var(--gold-glow);
  }

  .village-tagline {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  /* ===== AGENTS GRID ===== */
  .agents-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
    justify-items: center;
  }

  @media (min-width: 768px) {
    .agents-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 20px;
    }
  }

  /* ===== AGENT NODE ===== */
  .agent-node {
    position: relative;
    width: 100%;
    max-width: 180px;
    padding: 20px 12px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-align: center;
    cursor: pointer;
    transition: all var(--transition-base);
    overflow: hidden;
  }

  .agent-node::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    transition: all var(--transition-base);
  }

  .mac-mini-village .agent-node::before {
    background: linear-gradient(90deg, transparent, var(--purple-primary), transparent);
  }

  .droplet-village .agent-node::before {
    background: linear-gradient(90deg, transparent, var(--gold-primary), transparent);
  }

  .agent-node:hover {
    transform: translateY(-4px);
    background: var(--bg-card-hover);
    border-color: var(--border-glow);
  }

  .mac-mini-village .agent-node:hover {
    box-shadow: 0 8px 32px var(--purple-glow), 0 0 0 1px var(--purple-dim);
  }

  .droplet-village .agent-node:hover {
    box-shadow: 0 8px 32px var(--gold-glow), 0 0 0 1px var(--gold-dim);
  }

  .agent-node:hover::before {
    height: 3px;
  }

  .agent-emoji {
    font-size: 2rem;
    display: block;
    margin-bottom: 8px;
    filter: drop-shadow(0 0 6px rgba(255,255,255,0.2));
    transition: filter var(--transition-base);
  }

  .agent-node:hover .agent-emoji {
    filter: drop-shadow(0 0 12px rgba(255,255,255,0.4));
    animation: emoji-float 2s ease infinite;
  }

  .agent-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .agent-role {
    font-size: 0.7rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .agent-status {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00ff88;
    box-shadow: 0 0 6px rgba(0, 255, 136, 0.5);
    animation: pulse-dot 3s ease infinite;
  }

  .agent-status.idle {
    background: var(--text-muted);
    box-shadow: none;
    animation: none;
  }

  /* ===== BRIDGE ===== */
  .village-bridge {
    position: relative;
    padding: 40px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 120px;
  }

  .bridge-glow {
    position: absolute;
    width: 80%;
    max-width: 400px;
    height: 100%;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, var(--cyan-glow) 0%, transparent 70%);
    filter: blur(20px);
    animation: bridge-breathe 4s ease infinite;
  }

  .bridge-line {
    position: relative;
    width: 60%;
    max-width: 300px;
    height: 2px;
    background: linear-gradient(90deg, var(--purple-primary), var(--cyan-primary), var(--gold-primary));
    border-radius: 2px;
    box-shadow: 0 0 12px var(--cyan-glow), 0 0 40px var(--cyan-dim);
    z-index: 1;
  }

  .bridge-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 1;
    pointer-events: none;
  }

  .bridge-particle {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--cyan-primary);
    box-shadow: 0 0 6px var(--cyan-glow);
    animation: flow-particle 3s linear infinite;
  }

  .bridge-label {
    position: relative;
    z-index: 2;
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--cyan-primary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.8;
  }

  .bridge-icon {
    font-size: 1.2rem;
  }

  /* ===== ACTIVITY SECTION ===== */
  .activity-section {
    position: relative;
    z-index: 2;
    max-width: 800px;
    margin: 40px auto;
    padding: 0 24px;
  }

  .section-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 16px;
    text-align: center;
  }

  .activity-feed {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 300px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--text-muted) transparent;
  }

  .activity-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    animation: slideIn 0.3s ease;
  }

  .activity-emoji {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .activity-text {
    color: var(--text-secondary);
    flex: 1;
  }

  .activity-text strong {
    color: var(--text-primary);
  }

  .activity-time {
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    flex-shrink: 0;
  }

  /* ===== FOOTER ===== */
  .village-footer {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 60px 24px 80px;
    background: radial-gradient(ellipse at center bottom, var(--cyan-dim) 0%, transparent 60%);
  }

  .motto {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(0.9rem, 2vw, 1.3rem);
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
    margin: 0 0 12px;
  }

  .motto-highlight {
    background: linear-gradient(135deg, var(--cyan-primary), var(--purple-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ===== AGENT MODAL ===== */
  .agent-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .agent-modal.active {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
  }

  .modal-content {
    position: relative;
    width: 100%;
    max-width: 420px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-glow);
    border-radius: var(--radius-xl);
    padding: 32px 28px;
    animation: modalIn 0.3s ease;
  }

  .modal-emoji {
    font-size: 3.5rem;
    text-align: center;
    margin-bottom: 16px;
  }

  .modal-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.5rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 4px;
  }

  .modal-role {
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 20px;
  }

  .modal-village-badge {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 4px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }

  .modal-village-badge.mac {
    background: var(--purple-dim);
    color: var(--purple-primary);
    border: 1px solid rgba(107, 53, 255, 0.3);
  }

  .modal-village-badge.droplet {
    background: var(--gold-dim);
    color: var(--gold-primary);
    border: 1px solid rgba(255, 215, 0, 0.3);
  }

  .modal-divider {
    width: 60%;
    height: 1px;
    background: var(--border-subtle);
    margin: 0 auto 20px;
  }

  .modal-identity {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-secondary);
    text-align: center;
    font-style: italic;
    margin-bottom: 24px;
  }

  .modal-status-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .modal-status-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #00ff88;
    box-shadow: 0 0 8px rgba(0, 255, 136, 0.5);
    animation: pulse-dot 2s ease infinite;
  }

  .modal-status-indicator.idle {
    background: var(--text-muted);
    box-shadow: none;
    animation: none;
  }

  .modal-close {
    display: block;
    width: 100%;
    padding: 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .modal-close:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border-glow);
    color: var(--text-primary);
  }

  /* ===== ANIMATIONS ===== */
  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @keyframes emoji-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  @keyframes bridge-breathe {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  @keyframes flow-particle {
    0% { transform: translateX(-150px); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateX(150px); opacity: 0; }
  }

  @keyframes slideIn {
    from { transform: translateY(-10px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @keyframes modalIn {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  /* ===== GRID PATTERN BG ===== */
  #village-app::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    z-index: 0;
    pointer-events: none;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 600px) {
    .village-header { padding: 60px 16px 24px; }
    .village-cluster { padding: 24px 0; }
    .agents-grid { gap: 10px; }
    .agent-node { padding: 14px 8px 12px; }
    .agent-emoji { font-size: 1.6rem; }
    .agent-name { font-size: 0.75rem; }
    .agent-role { font-size: 0.6rem; }
    .village-bridge { padding: 24px 0; min-height: 80px; }
    .bridge-line { width: 80%; }
    .activity-section { margin: 20px auto; }
    .modal-content { padding: 24px 20px; }
    .status-bar { font-size: 0.75rem; padding: 8px 16px; gap: 8px; }
  }

  /* ===== SCROLLBAR ===== */
  .activity-feed::-webkit-scrollbar {
    width: 4px;
  }
  .activity-feed::-webkit-scrollbar-track {
    background: transparent;
  }
  .activity-feed::-webkit-scrollbar-thumb {
    background: var(--text-muted);
    border-radius: 4px;
  }
</style>

<script>
  // ===== AGENT DATA =====
  const macMiniAgents = [
