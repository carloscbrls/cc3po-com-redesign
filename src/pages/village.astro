    { name: 'Relay', emoji: '🔧', role: 'Infrastructure', identity: 'The pipes, the wires, the backbone. I keep everything running — always.', status: 'active' },
    { name: 'Archivist', emoji: '📚', role: 'Documentation', identity: 'If it\'s not documented, it didn\'t happen. I preserve knowledge for tomorrow.', status: 'active' },
  ];

  // ===== RENDER AGENTS =====
  function renderAgents(agents, containerId, villageType) {
    const container = document.getElementById(containerId);
    if (!container) return;

    agents.forEach((agent, i) => {
      const node = document.createElement('div');
      node.className = 'agent-node';
      node.style.animationDelay = `${i * 50}ms`;
      node.innerHTML = `
        <span class="agent-status ${agent.status === 'idle' ? 'idle' : ''}"></span>
        <span class="agent-emoji">${agent.emoji}</span>
        <div class="agent-name">${agent.name}</div>
        <div class="agent-role">${agent.role}</div>
      `;
      node.addEventListener('click', () => openModal(agent, villageType));
      container.appendChild(node);
    });
  }

  // ===== MODAL =====
  function openModal(agent, villageType) {
    const modal = document.getElementById('agent-modal');
    const content = document.getElementById('modal-content');

    const villageBadge = villageType === 'mac'
      ? '<span class="modal-village-badge mac">🖥️ Mac Mini Village</span>'
      : '<span class="modal-village-badge droplet">☁️ Droplet Village</span>';

    const nameColor = villageType === 'mac' ? 'var(--purple-primary)' : 'var(--gold-primary)';

    content.innerHTML = `
      <div class="modal-emoji">${agent.emoji}</div>
      <div class="modal-name" style="color: ${nameColor}">${agent.name}</div>
      <div class="modal-role">${agent.role}</div>
      <div style="text-align:center">${villageBadge}</div>
      <div class="modal-divider"></div>
      <div class="modal-identity">"${agent.identity}"</div>
      <div class="modal-status-row">
        <span class="modal-status-indicator ${agent.status === 'idle' ? 'idle' : ''}"></span>
        <span>${agent.status === 'active' ? 'Active' : 'Idle'}</span>
      </div>
      <button class="modal-close" id="modal-close-btn">Close</button>
    `;

    modal.classList.add('active');
    document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);
  }

  function closeModal() {
    document.getElementById('agent-modal').classList.remove('active');
  }

  document.getElementById('modal-backdrop')?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // ===== ACTIVITY FEED =====
  const activities = [
    { emoji: '🌍', text: '<strong>Atlas</strong> coordinated village-wide sync', time: 'Just now' },
    { emoji: '⚡', text: '<strong>Hermes</strong> completed deep research cycle', time: '2m ago' },
    { emoji: '🔭', text: '<strong>Apollo</strong> discovered 3 new integration points', time: '5m ago' },
    { emoji: '⚒️', text: '<strong>Forge</strong> deployed automation pipeline v2.4', time: '8m ago' },
    { emoji: '🔍', text: '<strong>Auditor</strong> completed HIPAA scan for dental client', time: '12m ago' },
    { emoji: '📱', text: '<strong>Sam</strong> published 2 scheduled posts', time: '15m ago' },
    { emoji: '🧠', text: '<strong>Athena</strong> indexed 47 new documents', time: '18m ago' },
    { emoji: '📞', text: '<strong>Callie</strong> handled 12 inbound calls', time: '22m ago' },
    { emoji: '🎯', text: '<strong>Onboard</strong> completed client setup', time: '25m ago' },
    { emoji: '⚖️', text: '<strong>Rico</strong> flagged 2 compliance issues', time: '30m ago' },
    { emoji: '🕵️', text: '<strong>Scout</strong> generated 8 qualified leads', time: '35m ago' },
    { emoji: '📊', text: '<strong>Pulse</strong> updated weekly analytics report', time: '40m ago' },
  ];

  function renderActivityFeed() {
    const feed = document.getElementById('activity-feed');
    if (!feed) return;
    activities.forEach(a => {
      const item = document.createElement('div');
      item.className = 'activity-item';
      item.innerHTML = `
        <span class="activity-emoji">${a.emoji}</span>
        <span class="activity-text">${a.text}</span>
        <span class="activity-time">${a.time}</span>
      `;
      feed.appendChild(item);
    });
  }

  // ===== BRIDGE PARTICLES =====
  function createBridgeParticles() {
    const container = document.getElementById('bridge-particles');
    if (!container) return;
    for (let i = 0; i < 8; i++) {
      const p = document.createElement('div');
      p.className = 'bridge-particle';
      p.style.top = `${40 + Math.random() * 20}%`;
      p.style.left = `${20 + Math.random() * 60}%`;
      p.style.animationDelay = `${i * 0.4}s`;
      p.style.animationDuration = `${2 + Math.random() * 2}s`;
      container.appendChild(p);
    }
  }

  // ===== BACKGROUND PARTICLE CANVAS =====
  function initParticles() {
    const canvas = document.getElementById('particle-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let w, h;
    const particles = [];
    const PARTICLE_COUNT = 60;

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }

    class Particle {
      constructor() {
        this.reset();
      }
      reset() {
        this.x = Math.random() * w;
        this.y = Math.random() * h;
        this.vx = (Math.random() - 0.5) * 0.3;
        this.vy = (Math.random() - 0.5) * 0.3;
        this.r = Math.random() * 1.5 + 0.5;
        this.alpha = Math.random() * 0.3 + 0.1;
        // Randomly purple, cyan, or gold
        const colors = [
          [107, 53, 255],  // purple
          [0, 210, 255],   // cyan
          [255, 215, 0],   // gold
        ];
        this.color = colors[Math.floor(Math.random() * colors.length)];
      }
      update() {
        this.x += this.vx;
        this.y += this.vy;
        if (this.x < 0 || this.x > w) this.vx *= -1;
        if (this.y < 0 || this.y > h) this.vy *= -1;
      }
      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${this.color[0]},${this.color[1]},${this.color[2]},${this.alpha})`;
        ctx.fill();
      }
    }

    resize();
    window.addEventListener('resize', resize);

    for (let i = 0; i < PARTICLE_COUNT; i++) {
      particles.push(new Particle());
    }

    function drawLines() {
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 150) {
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(0, 210, 255, ${0.06 * (1 - dist / 150)})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }
    }

    function animate() {
      ctx.clearRect(0, 0, w, h);
      particles.forEach(p => {
        p.update();
        p.draw();
      });
      drawLines();
      requestAnimationFrame(animate);
    }

    animate();
  }

  // ===== INIT =====
  document.addEventListener('DOMContentLoaded', () => {
    renderAgents(macMiniAgents, 'mac-agents', 'mac');
    renderAgents(dropletAgents, 'droplet-agents', 'droplet');
    renderActivityFeed();
    createBridgeParticles();
    initParticles();

    // Update active count
    const allAgents = [...macMiniAgents, ...dropletAgents];
    const activeCount = allAgents.filter(a => a.status === 'active').length;
    const countEl = document.getElementById('active-count');
    if (countEl) countEl.textContent = activeCount;
  });
</script>
