---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "CC3PO Partner Program — Resell, Refer & Earn",
  "description": "Join the CC3PO Partner Program. Earn 20% recurring commission on every referral. Free to join, no minimums, full support. CA Certified Small Business.",
  "provider": {
    "@type": "Organization",
    "name": "CC3PO",
    "url": "https://cc3po.com"
  },
  "areaServed": {
    "@type": "State",
    "name": "California"
  },
  "serviceType": "Partner Program"
};
---

<Layout title="Partner Program — Resell, Refer & Earn with CC3PO" description="Join the CC3PO Partner Program. Earn 20% recurring commission on every referral. Free to join, no minimums, full support. CA Certified Small Business.">

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <style>
    .partners-hero { padding: 100px 0 60px; text-align: center; position: relative; overflow: hidden; }
    .partners-hero-glow { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 0%,rgba(139,92,246,0.12) 0%,transparent 60%); pointer-events: none; }
    .partners-icon-wrap { margin: 0 auto 24px; width: 72px; height: 72px; border-radius: 18px; background: rgba(139,92,246,0.12); border: 1px solid rgba(139,92,246,0.25); display: flex; align-items: center; justify-content: center; }
    .partners-label { color: #a78bfa; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px; }
    .partners-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 20px; }
    .partners-subtitle { font-size: clamp(1rem, 2.5vw, 1.15rem); color: var(--text-secondary); max-width: 600px; margin: 0 auto 20px; line-height: 1.6; }
    .partners-detail { font-size: clamp(0.85rem, 2vw, 0.95rem); color: var(--text-muted); max-width: 560px; margin: 0 auto 36px; }
    .partners-cta { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px; text-align: center; }
    .stat-card { background: rgba(139,92,246,0.06); border: 1px solid rgba(139,92,246,0.15); border-radius: 16px; padding: 24px 16px; }
    .stat-number { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; color: #8b5cf6; }
    .stat-label { font-size: clamp(0.75rem, 2vw, 0.9rem); color: var(--text-secondary); margin-top: 4px; }

    .section-label { color: #a78bfa; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 12px; text-align: center; }
    .section-title { font-size: clamp(1.6rem, 4vw, 2.5rem); font-weight: 800; letter-spacing: -0.02em; text-align: center; }

    .steps-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
    .step-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; padding: 28px 20px; text-align: center; }
    .step-num { width: 56px; height: 56px; border-radius: 50%; background: rgba(139,92,246,0.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 1.5rem; font-weight: 800; color: #8b5cf6; }
    .step-card h3 { font-size: 1.15rem; font-weight: 700; margin-bottom: 10px; }
    .step-card p { color: var(--text-secondary); line-height: 1.6; font-size: 0.92rem; }

    .products-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
    .product-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; padding: 24px; }
    .product-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
    .product-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 6px; }
    .product-card p { color: var(--text-secondary); font-size: 0.88rem; line-height: 1.5; }

    .audience-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
    .audience-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; padding: 24px; text-align: center; }
    .audience-emoji { font-size: 2rem; margin-bottom: 10px; }
    .audience-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 6px; }
    .audience-card p { color: var(--text-secondary); font-size: 0.85rem; }

    .commission-box { background: linear-gradient(135deg,rgba(139,92,246,0.08),rgba(139,92,246,0.02)); border: 1px solid rgba(139,92,246,0.2); border-radius: 20px; padding: clamp(24px, 5vw, 40px); }
    .commission-main { display: grid; grid-template-columns: 1fr; gap: 20px; text-align: center; margin-bottom: 28px; }
    .commission-arrow { font-size: 1.5rem; color: #8b5cf6; font-weight: 700; }
    .commission-amount { font-size: clamp(1.8rem, 5vw, 2.2rem); font-weight: 800; color: #8b5cf6; }
    .commission-label { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
    .tiers-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; }
    .tier-card { background: rgba(139,92,246,0.06); border-radius: 12px; padding: 14px 10px; text-align: center; }
    .tier-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .tier-amount { font-size: clamp(1.1rem, 3vw, 1.4rem); font-weight: 800; color: #8b5cf6; }

    .benefits-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
    .benefit-card { display: flex; gap: 14px; padding: 20px; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; }
    .benefit-icon { flex-shrink: 0; width: 40px; height: 40px; border-radius: 10px; background: rgba(16,185,129,0.1); display: flex; align-items: center; justify-content: center; }
    .benefit-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 6px; }
    .benefit-card p { color: var(--text-secondary); font-size: 0.88rem; line-height: 1.5; }

    .certs-bar { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; align-items: center; }
    .cert-badge { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; color: var(--text-secondary); background: rgba(139,92,246,0.06); padding: 6px 12px; border-radius: 8px; white-space: nowrap; }

    .trust-items { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }
    .trust-item { display: flex; align-items: center; gap: 6px; font-size: 0.85rem; color: var(--text-muted); }

    .section-alt { background: rgba(139,92,246,0.03); }
    .section-pad { padding: clamp(48px, 8vw, 80px) 0; }

    @media (min-width: 640px) {
      .commission-main { grid-template-columns: 1fr auto 1fr; text-align: left; }
      .commission-main .commission-earn { text-align: right; }
    }

    @media (max-width: 480px) {
      .partners-hero { padding: 80px 0 40px; }
      .stat-card { padding: 16px 12px; }
      .benefits-grid { grid-template-columns: 1fr; }
    }
  </style>

  <!-- Hero -->
  <section class="partners-hero">
    <div class="partners-hero-glow"></div>
    <div class="container" style="position:relative;">
      <div class="partners-icon-wrap">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <p class="partners-label">Partner Program</p>
      <h1 class="partners-title">Resell. Refer. Earn.</h1>
      <p class="partners-subtitle">You know businesses that need compliance, websites, and IT. We build the product. You bring the clients. Everyone wins.</p>
      <p class="partners-detail">20% recurring commission · Free to join · No minimums · Full support</p>
      <div class="partners-cta">
        <a href="#how-it-works" class="btn btn-primary btn-glow" style="background:linear-gradient(135deg,#8b5cf6,#6d28d9);border-color:#8b5cf6;">See How It Works →</a>
        <a href="https://cc3po.io/strategy-call" class="btn btn-secondary" target="_blank" rel="noopener">📞 Talk to Carlos</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section-pad" style="padding-top:24px;padding-bottom:60px;">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">20%</div>
          <div class="stat-label">Recurring Commission</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">100+</div>
          <div class="stat-label">Businesses Scanned</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">$0</div>
          <div class="stat-label">Cost to Join</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">24/7</div>
          <div class="stat-label">Partner Support</div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how-it-works" class="section-pad section-alt">
    <div class="container">
      <p class="section-label">How It Works</p>
      <h2 class="section-title" style="margin-bottom:40px;">Three Steps. Zero Hassle.</h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Refer a Business</h3>
          <p>Send us a business that needs compliance scanning, website management, or IT support. We'll handle the rest.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>We Close & Deliver</h3>
          <p>Our team handles the sales call, onboarding, and 24/7 service. You never have to manage the account.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Get Paid Monthly</h3>
          <p>Earn 20% recurring commission for as long as the client stays. The more you refer, the more you earn.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What You Can Sell -->
  <section class="section-pad">
    <div class="container">
      <p class="section-label">What You Can Sell</p>
      <h2 class="section-title" style="margin-bottom:40px;">Our Full Product Lineup</h2>
      <div class="products-grid">
        <div class="product-card">
          <div class="product-icon" style="background:rgba(16,185,129,0.1);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Compliance Shield</h3>
          <p>ADA/WCAG compliance scanning and monitoring. $99–$499/mo.</p>
        </div>
        <div class="product-card">
          <div class="product-icon" style="background:rgba(59,130,246,0.1);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h3>Website Management</h3>
          <p>Design, hosting, updates, and 24/7 monitoring. From $297/mo.</p>
        </div>
        <div class="product-card">
          <div class="product-icon" style="background:rgba(139,92,246,0.1);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3>AI Voice Agents</h3>
          <p>Callie — your AI receptionist that never misses a call. From $199/mo.</p>
        </div>
        <div class="product-card">
          <div class="product-icon" style="background:rgba(245,158,11,0.1);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3>Grant Writing</h3>
          <p>Find, write, and win grants for nonprofits and small businesses. $497/mo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who This Is For -->
  <section class="section-pad section-alt">
    <div class="container">
      <p class="section-label">Who This Is For</p>
      <h2 class="section-title" style="margin-bottom:40px;">Built for Connectors</h2>
      <div class="audience-grid">
        <div class="audience-card">
          <div class="audience-emoji">🏛️</div>
          <h3>IT Consultants</h3>
          <p>You already manage websites and tech. Add compliance as a service.</p>
        </div>
        <div class="audience-card">
          <div class="audience-emoji">🤝</div>
          <h3>Business Coaches</h3>
          <p>Your clients need compliance. You get paid for the introduction.</p>
        </div>
        <div class="audience-card">
          <div class="audience-emoji">📱</div>
          <h3>Marketing Agencies</h3>
          <p>Bundle compliance with your web design and SEO packages.</p>
        </div>
        <div class="audience-card">
          <div class="audience-emoji">⚖️</div>
          <h3>Attorneys</h3>
          <p>Refer ADA non-compliance clients for remediation. Earn on every referral.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Commission Example -->
  <section class="section-pad">
    <div class="container" style="max-width:800px;text-align:center;">
      <p class="section-label">Commission Example</p>
      <h2 class="section-title" style="margin-bottom:28px;">See What You Could Earn</h2>
      <div class="commission-box">
        <div class="commission-main">
          <div>
            <div class="commission-label">You refer</div>
            <div style="font-size:clamp(1.4rem,4vw,1.8rem);font-weight:800;">5 clients</div>
            <div style="font-size:0.85rem;color:var(--text-secondary);">on Compliance Shield @ $299/mo</div>
          </div>
          <div class="commission-arrow" aria-hidden="true">→</div>
          <div class="commission-earn">
            <div class="commission-label">You earn</div>
            <div class="commission-amount">$299/mo</div>
            <div style="font-size:0.85rem;color:var(--text-secondary);">$3,588/year · recurring</div>
          </div>
        </div>
        <div class="tiers-grid">
          <div class="tier-card">
            <div class="tier-label">10 clients</div>
            <div class="tier-amount">$598/mo</div>
          </div>
          <div class="tier-card">
            <div class="tier-label">25 clients</div>
            <div class="tier-amount">$1,495/mo</div>
          </div>
          <div class="tier-card">
            <div class="tier-label">50 clients</div>
            <div class="tier-amount">$2,990/mo</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Partner With Us -->
  <section class="section-pad section-alt">
    <div class="container">
      <p class="section-label">Why CC3PO</p>
      <h2 class="section-title" style="margin-bottom:40px;">Not Another Affiliate Program</h2>
      <div class="benefits-grid">
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <h3>Recurring, Not One-Time</h3>
            <p>20% every month the client stays active. Build once, earn forever.</p>
          </div>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <h3>We Close the Deals</h3>
            <p>You refer, we sell. No sales training or product demos needed from you.</p>
          </div>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <h3>No Minimums, Ever</h3>
            <p>Refer 1 or 100. Same commission rate. Same support. No quotas.</p>
          </div>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <h3>CA Certified Small Business</h3>
            <p>SB #2052063. Latino-owned. DVBE option. Government contracts count.</p>
          </div>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <h3>Real Product, Real Demand</h3>
            <p>ADA lawsuits up 62% in CA. Every business needs compliance. This sells itself.</p>
          </div>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <h3>Dedicated Partner Support</h3>
            <p>Direct line to our team. Co-branded materials. Real-time referral tracking.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-pad" style="text-align:center;">
    <div class="container" style="max-width:700px;">
      <p class="section-label">Get Started</p>
      <h2 class="section-title" style="margin-bottom:16px;">Ready to Earn?</h2>
      <p style="font-size:clamp(0.95rem,2vw,1.1rem);color:var(--text-secondary);line-height:1.6;margin-bottom:32px;">Join the CC3PO Partner Program. Free to sign up. No obligations. Start earning on your first referral.</p>
      <div class="partners-cta">
        <a href="https://cc3po.io/strategy-call" class="btn btn-primary btn-glow" style="background:linear-gradient(135deg,#8b5cf6,#6d28d9);border-color:#8b5cf6;font-size:clamp(0.95rem,2vw,1.05rem);padding:14px 28px;">Become a Partner →</a>
        <a href="mailto:partners@cc3po.com" class="btn btn-secondary" style="font-size:clamp(0.95rem,2vw,1.05rem);padding:14px 28px;">✉️ partners@cc3po.com</a>
      </div>
      <div class="trust-items">
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Free to join
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          No minimums
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          20% recurring
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications bar -->
  <section style="padding:32px 0;border-top:1px solid var(--border-color);">
    <div class="container" style="text-align:center;">
      <div class="certs-bar">
        <div class="cert-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          CA Certified Small Business — SB #2052063
        </div>
        <div class="cert-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Latino-Owned Business
        </div>
        <div class="cert-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          SB/DVBE Option Eligible
        </div>
      </div>
    </div>
  </section>

</Layout>