---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "CC3PO Partner Program — Resell, Refer & Earn",
  "description": "Join the CC3PO Partner Program. Earn 20% recurring commission on every referral. Free to join, no minimums, full support. CA Certified Small Business.",
  "provider": {
    "@type": "Organization",
    "name": "CC3PO",
    "url": "https://cc3po.com"
  },
  "areaServed": {
    "@type": "State",
    "name": "California"
  },
  "serviceType": "Partner Program"
};
---

<Layout title="Partner Program — Resell, Refer & Earn with CC3PO" description="Join the CC3PO Partner Program. Earn 20% recurring commission on every referral. Free to join, no minimums, full support. CA Certified Small Business.">

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section style="padding:120px 0 80px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(139,92,246,0.12) 0%,transparent 60%);pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <div style="margin:0 auto 24px;width:72px;height:72px;border-radius:18px;background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.25);display:flex;align-items:center;justify-content:center;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <p style="color:#a78bfa;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:12px;">Partner Program</p>
      <h1 style="font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;letter-spacing:-0.02em;line-height:1.1;margin-bottom:20px;">Resell. Refer. Earn.</h1>
      <p style="font-size:1.15rem;color:var(--text-secondary);max-width:600px;margin:0 auto 20px;line-height:1.6;">You know businesses that need compliance, websites, and IT. We build the product. You bring the clients. Everyone wins.</p>
      <p style="font-size:0.95rem;color:var(--text-muted);max-width:560px;margin:0 auto 36px;">20% recurring commission · Free to join · No minimums · Full support</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="#how-it-works" class="btn btn-primary btn-glow" style="background:linear-gradient(135deg,#8b5cf6,#6d28d9);border-color:#8b5cf6;">See How It Works →</a>
        <a href="https://cc3po.io/strategy-call" class="btn btn-secondary" target="_blank" rel="noopener">📞 Talk to Carlos</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section style="padding:40px 0 80px;">
    <div class="container">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px;text-align:center;">
        <div style="background:rgba(139,92,246,0.06);border:1px solid rgba(139,92,246,0.15);border-radius:16px;padding:32px 24px;">
          <div style="font-size:2.5rem;font-weight:800;color:#8b5cf6;">20%</div>
          <div style="font-size:0.9rem;color:var(--text-secondary);margin-top:4px;">Recurring Commission</div>
        </div>
        <div style="background:rgba(139,92,246,0.06);border:1px solid rgba(139,92,246,0.15);border-radius:16px;padding:32px 24px;">
