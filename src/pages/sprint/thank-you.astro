---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Thank You — Site & Search Health Sprint | CC3PO" description="Your audit is being processed. We'll deliver your 1-page PDF + 30-min Loom within 48 hours.">

  <section class="hero" id="main-content">
    <div class="container" style="text-align: center; max-width: 700px; margin: 0 auto;">
      <div style="font-size: 64px; margin-bottom: 20px;">🎉</div>
      <h1>You're In the Sprint</h1>
      <p class="hero-sub" style="font-size: 20px; margin-bottom: 30px;">
        Your <strong>Site & Search Health Sprint</strong> has been queued.
      </p>
      <div style="background: rgba(233,69,96,0.08); border: 1px solid rgba(233,69,96,0.2); border-radius: 12px; padding: 30px; margin: 30px 0; text-align: left;">
        <h3 style="margin-top: 0;">What Happens Next</h3>
        <div style="display: flex; gap: 16px; margin: 16px 0; align-items: flex-start;">
          <div style="background: var(--accent); color: #fff; border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; font-weight: 700;">1</div>
          <div>
            <strong>We scan your site</strong> — ADA compliance, SEO, performance, security. Takes ~30 min.
          </div>
        </div>
        <div style="display: flex; gap: 16px; margin: 16px 0; align-items: flex-start;">
          <div style="background: var(--accent); color: #fff; border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; font-weight: 700;">2</div>
          <div>
            <strong>We generate your PDF</strong> — 1-page executive summary with findings, scores, and quick wins.
          </div>
        </div>
        <div style="display: flex; gap: 16px; margin: 16px 0; align-items: flex-start;">
          <div style="background: var(--accent); color: #fff; border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; font-weight: 700;">3</div>
          <div>
            <strong>Carlos records your Loom</strong> — 30-min walkthrough of findings and recommended fixes.
          </div>
        </div>
        <div style="display: flex; gap: 16px; margin: 16px 0; align-items: flex-start;">
          <div style="background: var(--accent); color: #fff; border-radius: 50%; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; font-weight: 700;">4</div>
          <div>
            <strong>Delivered to your inbox</strong> — PDF + Loom link within 48 hours.
          </div>
        </div>
      </div>
      <p style="color: var(--text-secondary); font-size: 14px;">
        Questions? Email <a href="mailto:legal@cc3po.com" style="color: var(--accent);">legal@cc3po.com</a>
      </p>
    </div>
  </section>

</Layout>
