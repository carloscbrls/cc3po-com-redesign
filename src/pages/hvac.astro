---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Marketing & Lead Generation for HVAC Companies | CC3PO" description="AI agents that respond to leads 24/7, manage reviews, boost local SEO, and fill your schedule — while you're on the roof. Starting at $497/mo. Based in Lathrop, CA.">

  <!-- ====== HERO ====== -->
  <section class="hero hvac-hero" id="main-content">
    <canvas id="hero-canvas"></canvas>
    <div class="hero-content">
      <a href="/" class="back-link reveal">← Back to Services</a>
      <div class="hero-badge reveal">
        <span class="pulse-dot"></span>
        Built for HVAC companies
      </div>

      <h1 class="hero-title reveal">
        AI Marketing & Lead Generation for HVAC Companies
      </h1>

      <p class="hero-sub reveal">
        Every missed call is a lost job. <strong>67% of customers</strong> hire the first company that responds. When you're on a rooftop, who's answering your phone? We are. 24/7.
      </p>

      <div class="hero-stats reveal">
        <div class="stat-item">
          <span class="stat-number">67%</span>
          <span class="stat-label">Hire first responder</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">$300+</span>
          <span class="stat-label">Avg lost per missed call</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">5 min</span>
          <span class="stat-label">Lead response time</span>
        </div>
      </div>

      <p class="hero-note reveal">You're on rooftops, not at desks. Let our AI team handle the phones, reviews, and marketing — so you can focus on the work that pays.</p>

      <div class="hero-ctas reveal">
        <a href="/#cta" class="btn btn-primary btn-glow">Free Website Audit — See Where You're Losing Leads →</a>
        <a href="https://cc3po.io/strategy-call" class="btn btn-secondary" target="_blank" rel="noopener">📞 Strategy Call</a>
      </div>
    </div>
  </section>

  <!-- ====== TRUST BAR ====== -->
  <section class="trust-bar" style="background: var(--bg-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 16px 0;">
    <div class="container" style="display: flex; align-items: center; justify-content: center; gap: 32px; flex-wrap: wrap; text-align: center;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #ffd700; font-size: 18px;">🏛️</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">CA Certified Small Business</span>
        <span style="color: var(--text-muted); font-size: 12px;">SB #2052063</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #e94560; font-size: 18px;">🌎</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">Latino-Owned Business</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #4fc3f7; font-size: 18px;">🛡️</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">SB/DVBE Option Eligible</span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="color: #00e676; font-size: 18px;">🌐</span>
        <span style="color: var(--text-secondary); font-size: 14px; font-weight: 600;">Se habla español</span>
      </div>
    </div>
  </section>

  <!-- ====== WHAT WE HANDLE ====== -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">What Your Village Handles</div>
        <h2 class="section-title">Everything your HVAC business needs. Running while you work.</h2>
        <p class="section-desc">You're on rooftops and in attics. We're answering your calls, responding to reviews, and filling your schedule.</p>
      </div>

      <div class="services-grid reveal">
        <div class="service-card">
          <div class="service-icon">📞</div>
          <h3>24/7 Lead Response</h3>
          <p>Every call answered. Every form submission followed up within 5 minutes. Even at 2 AM. Even on Sundays. Even during peak season when you can't pick up.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">⭐</div>
          <h3>Review Management</h3>
          <p>Google and Yelp reviews responded to professionally within 30 minutes. We turn angry customers into 5-star reviews and happy customers into referrals.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📍</div>
          <h3>Local SEO (Fresno, Bakersfield, Stockton, Modesto)</h3>
          <p>Your business shows up when people search "HVAC near me" in your service area. We optimize your Google Business Profile, local citations, and landing pages.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">⚡</div>
          <h3>Website Speed & Mobile Optimization</h3>
          <p>Your customers are searching from their phones. We make sure your site loads fast, looks great on mobile, and converts visitors into calls.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">📅</div>
          <h3>Seasonal Content Scheduling</h3>
          <p>AC season? Heating season? We schedule your social posts, blog content, and promotions to match the season — automatically, every year.</p>
        </div>
        <div class="service-card">
          <div class="service-icon">🛡️</div>
          <h3>Compliance & Accessibility</h3>
          <p>ADA/WCAG compliance for your website. Contractor license display. CSLB advertising requirements. We keep you legal so you can focus on service calls.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== BEFORE / AFTER ====== -->
  <section class="section" id="before-after" style="background: var(--bg-secondary);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">The Difference</div>
        <h2 class="section-title">Your busy season. With and without CC3PO.</h2>
      </div>

      <div class="before-after-split reveal">
        <div class="ba-column ba-without">
          <div class="ba-column-title">⚠️ Without CC3PO</div>
          <div class="ba-column-items">
            <div class="ba-line-item">
              <span class="ba-line-icon">📱</span>
              <span>Missed call at 7 PM — that lead called the next company</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">😠</span>
              <span>1-star review on Google — no response for a week</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">📉</span>
              <span>Website takes 5 seconds to load on mobile — visitors leave</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">🤷</span>
              <span>Competitor shows up first in "HVAC near me" search</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">😰</span>
              <span>June hits and you have zero seasonal marketing ready</span>
            </div>
          </div>
        </div>
        <div class="ba-column ba-with">
          <div class="ba-column-title">✅ With CC3PO</div>
          <div class="ba-column-items">
            <div class="ba-line-item">
              <span class="ba-line-icon">📞</span>
              <span>Every call answered — lead captured in 30 seconds</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">⭐</span>
              <span>Review responded to professionally within 30 minutes</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">⚡</span>
              <span>Website loads in under 2 seconds on any device</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">📍</span>
              <span>Your business ranks #1 for local HVAC searches</span>
            </div>
            <div class="ba-line-item">
              <span class="ba-line-icon">☀️</span>
              <span>Seasonal promotions scheduled and running automatically</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== COMPARISON TABLE ====== -->
  <section class="section" id="comparison">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">The Math</div>
        <h2 class="section-title">What it costs to hire separately vs. CC3PO.</h2>
      </div>

      <div class="comparison-table-wrap reveal">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Hire Separately</th>
              <th>Cost/mo</th>
              <th>CC3PO</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Receptionist / phone answerer</td>
              <td class="cost-cell">$3,500</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Marketing agency</td>
              <td class="cost-cell">$3,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>SEO specialist</td>
              <td class="cost-cell">$2,500</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Review management service</td>
              <td class="cost-cell">$1,500</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Web developer</td>
              <td class="cost-cell">$4,000</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr>
              <td>Social media manager</td>
              <td class="cost-cell">$2,800</td>
              <td class="included-cell">Included</td>
            </tr>
            <tr class="total-row">
              <td><strong>Total</strong></td>
              <td class="cost-cell"><strong>$17,300/mo</strong></td>
              <td class="included-cell"><strong>Starting at $497/mo</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ====== TESTIMONIALS ====== -->
  <section class="section" id="proof">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Proof</div>
        <h2 class="section-title">Real businesses. Real results.</h2>
      </div>
      <div class="testimonials-grid reveal">
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"I used to spend 3 hours a day managing reviews and social media. Now I wake up and it's all done. My Business Health Score went from 52 to 87 in two months."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Dr. Alan Lee</div>
            <div class="testimonial-role">Sunrise Dental, Stockton CA</div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"The compliance scanning alone is worth it. We had 14 ADA violations we didn't know about. Sentinel found them, fixed them, and now we're clean. That would've been a $4,000 fine per violation."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Matt Safdari</div>
            <div class="testimonial-role">Top Class Fitness, Modesto CA</div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">★★★★★</div>
          <p class="testimonial-text">"I was skeptical about AI running my business. Then I got my first morning report and realized — they actually did everything while I slept. My Google reviews went from 3.2 to 4.7 stars."</p>
          <div class="testimonial-author">
            <div class="testimonial-name">Julius Jones</div>
            <div class="testimonial-role">Central Valley Auto, Lathrop CA</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== CTA ====== -->
  <section class="cta-section" id="cta">
    <div class="container cta-content">
      <div class="reveal">
        <h2>See where you're losing leads. Free.</h2>
        <p>Get a full audit of your website, reviews, local SEO, and lead response — free, in 30 seconds.</p>
        <div class="cta-trust" style="margin-top:24px;">
          <span>✓ No credit card</span>
          <span>✓ Mobile speed check</span>
          <span>✓ Local SEO audit</span>
          <span>✓ Review gap analysis</span>
        </div>
        <div class="hero-ctas" style="margin-top:32px;">
          <a href="/#cta" class="btn btn-primary btn-glow">Free Website Audit — See Where You're Losing Leads →</a>
          <a href="https://cc3po.io/strategy-call" class="btn btn-secondary" target="_blank" rel="noopener">📞 Strategy Call</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div style="font-size:17px;font-weight:800;margin-bottom:8px;">CC3PO</div>
          <p>Your whole business team. One price. 24/7.</p>
          <p class="footer-tagline" style="margin-top:12px;font-size:0.75rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,0.4);">Build once. Run forever. Evolve continuously.</p>
          <div style="margin-top:16px;font-size:0.75rem;color:rgba(255,255,255,0.35);line-height:1.5;"><strong style="color:rgba(255,255,255,0.5);">Certifications:</strong> CA Certified Small Business — SB #2052063 · Latino-Owned Business · Se habla español · SB/DVBE Option · <a href="/certifications" style="color:var(--accent);">View All →</a></div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Services</div>
          <div class="footer-col-links">
            <a href="/dental">Dental Practices</a>
            <a href="/hvac">HVAC Companies</a>
            <a href="/gym">Gyms & Fitness</a>
            <a href="/nonprofit">Nonprofits</a>
            <a href="/#comparison">Pricing →</a>
          </div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Company</div>
          <div class="footer-col-links">
            <a href="/about/">About</a>
            <a href="/how-it-works/">How It Works</a>
            <a href="/privacy/">Privacy Policy</a>
            <a href="/terms/">Terms of Service</a>
            <a href="/certifications">Certifications</a>
            <a href="/accessibility">Accessibility</a>
          </div>
        </div>
        <div class="footer-col">
          <div class="footer-col-title">Our Sites</div>
          <div class="footer-col-links">
            <a href="https://offers.cc3po.com">Services & Pricing</a>
            <a href="https://insights.cc3po.com">Blog & Insights</a>
            <a href="https://audit.cc3po.com">Free Website Audit</a>
            <a href="/morning-report/">Morning Report</a>
            <a href="/village/">The Village</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-copy">© 2026 CC3PO LLC. All rights reserved. · 16299 Adobe Way, Lathrop, CA 95330</div>
        <div class="footer-legal">
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </div>
      </div>
    </div>
  </footer>

  <style is:inline>
    .hvac-hero {
      background: linear-gradient(135deg, #0a0a12 0%, #0a1628 50%, #1a0a14 100%);
    }

    .back-link {
      display: inline-block;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
      margin-bottom: 16px;
      transition: color 0.2s;
    }
    .back-link:hover { color: var(--accent); }

    .hero-stats {
      display: flex;
      gap: 32px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 24px;
    }
    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .stat-number {
      font-size: 2rem;
      font-weight: 800;
      color: var(--accent);
    }
    .stat-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .hero-note {
      font-size: 0.9rem;
      color: var(--text-muted);
      text-align: center;
      max-width: 500px;
      margin: 16px auto 0;
      font-style: italic;
    }

    .hero-ctas {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 32px;
    }

    /* Services Grid */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      margin-top: 40px;
    }
    .service-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      transition: transform 0.2s, border-color 0.2s;
    }
    .service-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
    }
    .service-icon {
      font-size: 2rem;
      margin-bottom: 12px;
    }
    .service-card h3 {
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 8px;
    }
    .service-card p {
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    /* Before/After */
    .before-after-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      max-width: 900px;
      margin: 0 auto;
    }
    @media (max-width: 768px) {
      .before-after-split { grid-template-columns: 1fr; }
    }
    .ba-column {
      border-radius: 12px;
      padding: 28px;
    }
    .ba-without {
      background: rgba(233, 69, 96, 0.08);
      border: 1px solid rgba(233, 69, 96, 0.25);
    }
    .ba-with {
      background: rgba(0, 230, 118, 0.08);
      border: 1px solid rgba(0, 230, 118, 0.25);
    }
    .ba-column-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 18px;
    }
    .ba-without .ba-column-title { color: #e94560; }
    .ba-with .ba-column-title { color: #00e676; }
    .ba-column-items {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .ba-line-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }
    .ba-line-icon {
      flex-shrink: 0;
      font-size: 1rem;
    }

    /* Comparison Table */
    .comparison-table-wrap {
      max-width: 700px;
      margin: 0 auto;
      overflow-x: auto;
    }
    .comparison-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .comparison-table thead th {
      background: var(--bg-secondary);
      padding: 14px 20px;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-muted);
      text-align: left;
      font-weight: 600;
    }
    .comparison-table tbody td {
      padding: 14px 20px;
      border-top: 1px solid var(--border);
      font-size: 0.95rem;
      color: var(--text-secondary);
    }
    .cost-cell { color: #e94560; font-weight: 600; text-align: center; }
    .included-cell { color: #00e676; font-weight: 600; text-align: center; }
    .total-row td { background: var(--bg-secondary); font-size: 1rem; }

    /* Testimonials */
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
      margin-top: 40px;
    }
    .testimonial-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      transition: transform 0.2s, border-color 0.2s;
    }
    .testimonial-card:hover { transform: translateY(-4px); border-color: rgba(107,53,255,0.3); }
    .testimonial-stars { color: #fbbf24; font-size: 1rem; margin-bottom: 12px; letter-spacing: 2px; }
    .testimonial-text { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 16px; font-style: italic; }
    .testimonial-author { display: flex; flex-direction: column; }
    .testimonial-name { font-weight: 700; color: #fff; font-size: 0.9rem; }
    .testimonial-role { color: var(--text-muted); font-size: 0.8rem; }

    @media (max-width: 768px) {
      .hero-stats { gap: 16px; }
      .stat-number { font-size: 1.5rem; }
      .hero-ctas { flex-direction: column; align-items: center; }
    }
  </style>

  <script is:inline>
    // Mobile drawer handled by Layout.astro