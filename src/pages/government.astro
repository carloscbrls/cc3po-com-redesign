---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Government & Public Sector — CC3PO" description="California Certified Small Business (SB #2052063) providing AI automation, accessibility compliance, and IT infrastructure services to government agencies. SB/DVBE Option eligible.">

  <!-- Navigation -->
  <nav class="nav" id="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <img src="/images/cc3po-crypto-enhanced.png" alt="CC3PO" class="nav-logo-img nav-logo-full">
        <img src="/images/cc3po-crypto-56px.png" alt="CC3PO" class="nav-logo-img nav-logo-icon" width="56" height="56" loading="eager">
        <span>CC3PO</span>
      </a>
      <ul class="nav-links">
        <li><a href="/services">Services</a></li>
        <li><a href="/government">Government</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
        <li><a href="/ai-compliance">AI Compliance</a></li>
        <li><a href="/certifications">Certifications</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <a href="/contact" class="nav-cta">Request Capability Statement</a>
      <button class="mobile-toggle" aria-label="Menu" aria-expanded="false" id="mobile-menu-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </nav>

  <!-- ====== HERO ====== -->
  <section class="hero" id="main-content" id="hero" style="min-height:70vh;">
    <div class="hero-content">
      <div class="hero-badge reveal">
        <span class="pulse-dot"></span>
        CA Certified Small Business
      </div>
      <h1 class="hero-title reveal">
        Government IT & AI<br>
        <span class="typed-gradient">Automation for California Agencies</span>
      </h1>
      <p class="hero-sub reveal">
        SB/DVBE Option eligible. Serving all 58 California counties.<br>
        Website services, AI governance, accessibility compliance, and IT infrastructure — built for government.
      </p>
      <div class="hero-buttons reveal">
        <a href="/contact" class="btn btn-primary btn-glow">
          <span class="btn-icon">📋</span> Request Capability Statement
        </a>
        <a href="#certifications" class="btn btn-secondary">
          <span class="btn-icon">✅</span> View Certifications
        </a>
      </div>
    </div>
  </section>

  <!-- ====== TRUST BAR ====== -->
  <section class="section" style="padding:var(--space-2xl) 0;background:var(--bg-secondary);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="container">
      <div class="trust-bar-grid reveal" style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-lg);text-align:center;">
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--accent);margin-bottom:var(--space-2xs);">SB #2052063</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">CA Certified Small Business</div>
        </div>
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--success);margin-bottom:var(--space-2xs);">Latino-Owned</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">Minority Business Enterprise</div>
        </div>
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--blue);margin-bottom:var(--space-2xs);">SB/DVBE Option</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">Eligible for Direct Awards</div>
        </div>
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--warning);margin-bottom:var(--space-2xs);">58 Counties</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">Serving All of California</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== HOW TO BUY ====== -->
  <section class="section" id="how-to-buy">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Procurement</div>
        <h2 class="section-title">How to Buy from CC3PO</h2>
        <p class="section-desc">Three pathways to engage our services — no lengthy competitive bidding required for SB/DVBE Option contracts.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(3,1fr);">
        <div class="product-card reveal" style="--accent-color:#e94560;">
          <div class="product-icon-wrap"><span>⚡</span></div>
          <div class="product-name">SB/DVBE Option</div>
          <div class="product-price">$5K – $249,999</div>
          <div class="product-desc">Direct award for certified small businesses and DVBEs. No competitive bidding required. Fastest path to engagement — contracts under $250K can be awarded directly.</div>
          <div class="product-badge">No bid required</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#4fc3f7;">
          <div class="product-icon-wrap"><span>📑</span></div>
          <div class="product-name">CMAS / MSA</div>
          <div class="product-price">Pre-negotiated Rates</div>
          <div class="product-desc">California Multiple Award Schedule and Master Service Agreement contracts. Pre-approved pricing, simplified procurement. We are pursuing CMAS certification now.</div>
          <div class="product-badge">Pursuing</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:60%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#00e676;">
          <div class="product-icon-wrap"><span>📝</span></div>
          <div class="product-name">Custom SOW</div>
          <div class="product-price">Tailored Engagement</div>
          <div class="product-desc">For larger or specialized projects, we work with your procurement team to develop a custom Statement of Work. Flexible pricing, clear deliverables, milestone-based billing.</div>
          <div class="product-badge">Flexible scope</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:85%;"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== CORE COMPETENCIES ====== -->
  <section class="section" id="competencies" style="background:var(--bg-secondary);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Core Competencies</div>
        <h2 class="section-title">What We Deliver for Government</h2>
        <p class="section-desc">Four pillars of service — each with the compliance, reporting, and audit readiness that government demands.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(2,1fr);">
        <div class="product-card reveal" style="--accent-color:#e94560;">
          <div class="product-icon-wrap"><span>🌐</span></div>
          <div class="product-name">Website & Digital Services</div>
          <div class="product-desc">Modern, accessible government websites built on Astro + Netlify. Fast, secure, WCAG 2.1 AA compliant by default. AB 434 certification-ready. Includes hosting, SSL, monitoring, and ongoing maintenance.</div>
          <div class="product-badge">AB 434 Ready</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#4fc3f7;">
          <div class="product-icon-wrap"><span>🤖</span></div>
          <div class="product-name">AI Automation & Governance</div>
          <div class="product-desc">AI-powered workflow automation with human oversight. EO N-5-26 readiness assessments, AI governance framework builds, and fractional AI compliance officer services. Every AI action logged and auditable.</div>
          <div class="product-badge">EO N-5-26 Ready</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:95%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#00e676;">
          <div class="product-icon-wrap"><span>♿</span></div>
          <div class="product-name">Accessibility & WCAG Compliance</div>
          <div class="product-desc">Full WCAG 2.1/2.2 AA audits, remediation guidance, VPAT/ACR completion, and ongoing monitoring. ADA Title II, Section 508, and California AB 434 compliance — before regulators find the gaps.</div>
          <div class="product-badge">ADA + Section 508</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#ffd700;">
          <div class="product-icon-wrap"><span>🔒</span></div>
          <div class="product-name">IT Infrastructure & Security</div>
          <div class="product-desc">Network security, patch management, system monitoring, and compliance-ready infrastructure. Automated security scans with human-approved deployments. Full audit trail for every change.</div>
          <div class="product-badge">Audit-ready logging</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:98%;"></div></div>
        </div>
      </div>
    </div>
  </section>

