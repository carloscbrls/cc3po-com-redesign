          <div class="product-bar"><div class="product-bar-fill" style="--fill:75%;"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== PROCUREMENT CTA ====== -->
  <section class="cta-section" id="procurement-cta">
    <div class="container cta-content">
      <div class="reveal">
        <h2>Ready to Engage?</h2>
        <p>Download our capability statement or contact us directly for RFP/RFQ responses. We respond within 24 hours.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-primary btn-glow">
