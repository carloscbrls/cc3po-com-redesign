---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Government & Public Sector — CC3PO" description="California Certified Small Business (SB #2052063) providing AI automation, accessibility compliance, and IT infrastructure services to government agencies. SB/DVBE Option eligible.">
  <!-- ====== HERO ====== -->
  <section class="hero" id="main-content" id="hero" style="min-height:70vh;">
    <div class="hero-content">
      <div class="hero-badge reveal">
        <span class="pulse-dot"></span>
        CA Certified Small Business
      </div>
      <h1 class="hero-title reveal">
        Government IT & AI<br>
        <span class="typed-gradient">Automation for California Agencies</span>
      </h1>
      <p class="hero-sub reveal">
        SB/DVBE Option eligible. Serving all 58 California counties.<br>
        Website services, AI governance, accessibility compliance, and IT infrastructure — built for government.
      </p>
      <div class="hero-buttons reveal">
        <a href="/contact" class="btn btn-primary btn-glow">
          <span class="btn-icon">📋</span> Request Capability Statement
        </a>
        <a href="#certifications" class="btn btn-secondary">
          <span class="btn-icon">✅</span> View Certifications
        </a>
      </div>
    </div>
  </section>

  <!-- ====== TRUST BAR ====== -->
  <section class="section" style="padding:var(--space-2xl) 0;background:var(--bg-secondary);border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
    <div class="container">
      <div class="trust-bar-grid reveal" style="display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-lg);text-align:center;">
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--accent);margin-bottom:var(--space-2xs);">SB #2052063</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">CA Certified Small Business</div>
        </div>
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--success);margin-bottom:var(--space-2xs);">Latino-Owned</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">Minority Business Enterprise</div>
        </div>
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--blue);margin-bottom:var(--space-2xs);">SB/DVBE Option</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">Eligible for Direct Awards</div>
        </div>
        <div>
          <div style="font-size:var(--text-2xl);font-weight:800;color:var(--warning);margin-bottom:var(--space-2xs);">58 Counties</div>
          <div style="font-size:var(--text-caption);color:var(--text-muted);">Serving All of California</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== HOW TO BUY ====== -->
  <section class="section" id="how-to-buy">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Procurement</div>
        <h2 class="section-title">How to Buy from CC3PO</h2>
        <p class="section-desc">Three pathways to engage our services — no lengthy competitive bidding required for SB/DVBE Option contracts.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(3,1fr);">
        <div class="product-card reveal" style="--accent-color:var(--accent);">
          <div class="product-icon-wrap"><span>⚡</span></div>
          <div class="product-name">SB/DVBE Option</div>
          <div class="product-price">$5K – $249,999</div>
          <div class="product-desc">Direct award for certified small businesses and DVBEs. No competitive bidding required. Fastest path to engagement — contracts under $250K can be awarded directly.</div>
          <div class="product-badge">No bid required</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#4fc3f7;">
          <div class="product-icon-wrap"><span>📑</span></div>
          <div class="product-name">CMAS / MSA</div>
          <div class="product-price">Pre-negotiated Rates</div>
          <div class="product-desc">California Multiple Award Schedule and Master Service Agreement contracts. Pre-approved pricing, simplified procurement. We are pursuing CMAS certification now.</div>
          <div class="product-badge">Pursuing</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:60%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#00e676;">
          <div class="product-icon-wrap"><span>📝</span></div>
          <div class="product-name">Custom SOW</div>
          <div class="product-price">Tailored Engagement</div>
          <div class="product-desc">For larger or specialized projects, we work with your procurement team to develop a custom Statement of Work. Flexible pricing, clear deliverables, milestone-based billing.</div>
          <div class="product-badge">Flexible scope</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:85%;"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== CORE COMPETENCIES ====== -->
  <section class="section" id="competencies" style="background:var(--bg-secondary);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Core Competencies</div>
        <h2 class="section-title">What We Deliver for Government</h2>
        <p class="section-desc">Four pillars of service — each with the compliance, reporting, and audit readiness that government demands.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(2,1fr);">
        <div class="product-card reveal" style="--accent-color:var(--accent);">
          <div class="product-icon-wrap"><span>🌐</span></div>
          <div class="product-name">Website & Digital Services</div>
          <div class="product-desc">Modern, accessible government websites built on Astro + Netlify. Fast, secure, WCAG 2.1 AA compliant by default. AB 434 certification-ready. Includes hosting, SSL, monitoring, and ongoing maintenance.</div>
          <div class="product-badge">AB 434 Ready</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#4fc3f7;">
          <div class="product-icon-wrap"><span>🤖</span></div>
          <div class="product-name">AI Automation & Governance</div>
          <div class="product-desc">AI-powered workflow automation with human oversight. EO N-5-26 readiness assessments, AI governance framework builds, and fractional AI compliance officer services. Every AI action logged and auditable.</div>
          <div class="product-badge">EO N-5-26 Ready</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:95%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#00e676;">
          <div class="product-icon-wrap"><span>♿</span></div>
          <div class="product-name">Accessibility & WCAG Compliance</div>
          <div class="product-desc">Full WCAG 2.1/2.2 AA audits, remediation guidance, VPAT/ACR completion, and ongoing monitoring. ADA Title II, Section 508, and California AB 434 compliance — before regulators find the gaps.</div>
          <div class="product-badge">ADA + Section 508</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#ffd700;">
          <div class="product-icon-wrap"><span>🔒</span></div>
          <div class="product-name">IT Infrastructure & Security</div>
          <div class="product-desc">Network security, patch management, system monitoring, and compliance-ready infrastructure. Automated security scans with human-approved deployments. Full audit trail for every change.</div>
          <div class="product-badge">Audit-ready logging</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:98%;"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== UNSPSC CODES ====== -->
  <section class="section" id="unspsc">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">UNSPSC Codes</div>
        <h2 class="section-title">Commodity Classifications</h2>
        <p class="section-desc">Our services map to the following UNSPSC codes for procurement systems.</p>
      </div>
      <div class="reveal" style="display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-sm);max-width:800px;margin:0 auto;">
        <div class="unspsc-row" style="display:flex;justify-content:space-between;align-items:center;padding:var(--space-sm) var(--space-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
          <code style="font-family:var(--font-mono);font-size:var(--text-caption);color:var(--accent);">81112101</code>
          <span style="font-size:14px;color:var(--text-secondary);">Computer programming services</span>
        </div>
        <div class="unspsc-row" style="display:flex;justify-content:space-between;align-items:center;padding:var(--space-sm) var(--space-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
          <code style="font-family:var(--font-mono);font-size:var(--text-caption);color:var(--accent);">81111504</code>
          <span style="font-size:14px;color:var(--text-secondary);">Web site development services</span>
        </div>
        <div class="unspsc-row" style="display:flex;justify-content:space-between;align-items:center;padding:var(--space-sm) var(--space-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
          <code style="font-family:var(--font-mono);font-size:var(--text-caption);color:var(--accent);">43231501</code>
          <span style="font-size:14px;color:var(--text-secondary);">Software security suite</span>
        </div>
        <div class="unspsc-row" style="display:flex;justify-content:space-between;align-items:center;padding:var(--space-sm) var(--space-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
          <code style="font-family:var(--font-mono);font-size:var(--text-caption);color:var(--accent);">81111501</code>
          <span style="font-size:14px;color:var(--text-secondary);">IT consulting services</span>
        </div>
        <div class="unspsc-row" style="display:flex;justify-content:space-between;align-items:center;padding:var(--space-sm) var(--space-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
          <code style="font-family:var(--font-mono);font-size:var(--text-caption);color:var(--accent);">43232300</code>
          <span style="font-size:14px;color:var(--text-secondary);">Network security software</span>
        </div>
        <div class="unspsc-row" style="display:flex;justify-content:space-between;align-items:center;padding:var(--space-sm) var(--space-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
          <code style="font-family:var(--font-mono);font-size:var(--text-caption);color:var(--accent);">81112200</code>
          <span style="font-size:14px;color:var(--text-secondary);">Systems integration services</span>
        </div>
        <div class="unspsc-row" style="display:flex;justify-content:space-between;align-items:center;padding:var(--space-sm) var(--space-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
          <code style="font-family:var(--font-mono);font-size:var(--text-caption);color:var(--accent);">43232500</code>
          <span style="font-size:14px;color:var(--text-secondary);">Compliance software</span>
        </div>
        <div class="unspsc-row" style="display:flex;justify-content:space-between;align-items:center;padding:var(--space-sm) var(--space-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
          <code style="font-family:var(--font-mono);font-size:var(--text-caption);color:var(--accent);">81111502</code>
          <span style="font-size:14px;color:var(--text-secondary);">Application hosting services</span>
        </div>
        <div class="unspsc-row" style="display:flex;justify-content:space-between;align-items:center;padding:var(--space-sm) var(--space-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
          <code style="font-family:var(--font-mono);font-size:var(--text-caption);color:var(--accent);">72012000</code>
          <span style="font-size:14px;color:var(--text-secondary);">IT training services</span>
        </div>
        <div class="unspsc-row" style="display:flex;justify-content:space-between;align-items:center;padding:var(--space-sm) var(--space-md);background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);">
          <code style="font-family:var(--font-mono);font-size:var(--text-caption);color:var(--accent);">81111503</code>
          <span style="font-size:14px;color:var(--text-secondary);">IT infrastructure services</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== PAST PERFORMANCE ====== -->
  <section class="section" id="past-performance" style="background:var(--bg-secondary);">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Past Performance</div>
        <h2 class="section-title">Proven in the Field</h2>
        <p class="section-desc">Real experience in government, healthcare, and enterprise environments.</p>
      </div>
      <div class="testimonials-grid" style="grid-template-columns:repeat(3,1fr);">
        <div class="testimonial-card reveal">
          <div class="testimonial-quote">Government infrastructure deployment for Stanislaus Regional Housing Authority — network security, IT systems, and ongoing support for housing authority operations.</div>
          <div class="testimonial-meta">
            <div class="testimonial-author">Stanislaus Regional Housing Authority</div>
            <div class="testimonial-role">Government Infrastructure</div>
          </div>
          <div class="testimonial-verified">✓ Government</div>
        </div>
        <div class="testimonial-card reveal">
          <div class="testimonial-quote">EHR deployment across 3,500+ computers for Kaiser Permanente. HIPAA compliance implementation, Cerner and Meditech system integration, and healthcare IT support.</div>
          <div class="testimonial-meta">
            <div class="testimonial-author">Kaiser Permanente</div>
            <div class="testimonial-role">Healthcare EHR Deployment</div>
          </div>
          <div class="testimonial-verified">✓ Healthcare</div>
        </div>
        <div class="testimonial-card reveal">
          <div class="testimonial-quote">Cerner deployment for Dignity Health hospital systems. Full EHR rollout with compliance integration, staff training, and infrastructure optimization.</div>
          <div class="testimonial-meta">
            <div class="testimonial-author">Dignity Health</div>
            <div class="testimonial-role">Cerner Deployment</div>
          </div>
          <div class="testimonial-verified">✓ Healthcare</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== CERTIFICATIONS ====== -->
  <section class="section" id="certifications">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">Certifications</div>
        <h2 class="section-title">Certified. Verified. Ready.</h2>
        <p class="section-desc">Current certifications and supplier diversity status.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(2,1fr);">
        <div class="product-card reveal" style="--accent-color:#00e676;">
          <div class="product-icon-wrap"><span>✅</span></div>
          <div class="product-name">CA Small Business</div>
          <div class="product-desc">Certified Small Business — SB #2052063. Auto-approved for SB/DVBE Option direct awards up to $249,999. Active and current.</div>
          <div class="product-badge">SB #2052063 — Active</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:100%;"></div></div>
        </div>
        <div class="product-card reveal" style="--accent-color:#4fc3f7;">
          <div class="product-icon-wrap"><span>🇺🇸</span></div>
          <div class="product-name">Latino-Owned Business</div>
          <div class="product-desc">Latino-owned and operated. Supports supplier diversity goals and MBE requirements. NMSDC MBE application in progress.</div>
          <div class="product-badge">MBE — Applying</div>
          <div class="product-bar"><div class="product-bar-fill" style="--fill:75%;"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== PROCUREMENT CTA ====== -->
  <section class="cta-section" id="procurement-cta">
    <div class="container cta-content">
      <div class="reveal">
        <h2>Ready to Engage?</h2>
        <p>Download our capability statement or contact us directly for RFP/RFQ responses. We respond within 24 hours.</p>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-primary btn-glow">
            <span class="btn-icon">📋</span> Download Capability Statement
          </a>
          <a href="/contact" class="btn btn-secondary">
            <span class="btn-icon">📧</span> Contact for RFP/RFQ
          </a>
        </div>
        <div class="cta-trust" style="margin-top:24px;">
          <span>✓ SB #2052063</span>
          <span>✓ SB/DVBE Option eligible</span>
          <span>✓ 24hr response</span>
          <span>✓ Se habla español</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "GovernmentService",
    "name": "CC3PO Government IT & AI Automation Services",
    "description": "AI automation, accessibility compliance, and IT infrastructure services for California government agencies. CA Certified Small Business SB #2052063.",
    "provider": {
      "@type": "Organization",
      "name": "CC3PO LLC",
      "url": "https://cc3po.com",
      "identifier": "SB #2052063"
    },
    "areaServed": {
      "@type": "State",
      "name": "California"
    },
    "serviceType": [
      "Website Development",
      "AI Governance",
      "WCAG Compliance Auditing",
      "IT Infrastructure"
    ]
  })} />

  <script is:inline>
    // Mobile Drawer
    // Mobile drawer handled by Layout.astro