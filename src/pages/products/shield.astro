---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "CC3PO Shield — Compliance Monitoring",
  "description": "Continuous ADA/WCAG compliance monitoring with instant violation alerts, weekly PDF reports, and lawsuit protection for small businesses.",
  "brand": { "@type": "Brand", "name": "CC3PO" },
  "offers": {
    "@type": "Offer",
    "price": "97",
    "priceCurrency": "USD",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": "https://cc3po.com/products/shield/"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "47"
  }
};
---

<Layout title="Shield — Always-On Compliance Monitoring | CC3PO" description="Continuous ADA/WCAG compliance monitoring, automated violation alerts, and weekly reports. Protect your business from $4K+ compliance lawsuits starting at $97/mo.">

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section style="padding:120px 0 80px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(59,130,246,0.15) 0%,transparent 60%);pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <div style="margin:0 auto 24px;width:72px;height:72px;border-radius:18px;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.25);display:flex;align-items:center;justify-content:center;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
      </div>
      <p style="color:#3b82f6;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:12px;">Compliance Monitoring</p>
      <h1 style="font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;letter-spacing:-0.02em;line-height:1.1;margin-bottom:20px;">Shield</h1>
      <p style="font-size:1.15rem;color:var(--text-secondary);max-width:560px;margin:0 auto 36px;line-height:1.6;">Always-on ADA/WCAG compliance monitoring. Get instant alerts when violations appear, weekly reports, and peace of mind — starting at <strong style="color:#fff;">$97/mo</strong>.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="https://buy.stripe.com/6oUdR88o6cbtgu00hK1B60W" class="cta-shield-trial" style="background:#3b82f6;color:#fff;padding:14px 32px;border-radius:10px;font-weight:700;font-size:1rem;text-decoration:none;box-shadow:0 4px 20px rgba(59,130,246,0.3);transition:all 0.2s;">Start Free Trial</a>
        <a href="/audit/" class="cta-shield-scan" style="background:transparent;color:#3b82f6;padding:14px 32px;border-radius:10px;font-weight:600;font-size:1rem;text-decoration:none;border:1px solid rgba(59,130,246,0.3);">Get Free Scan</a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section style="padding:80px 0;" id="features">
    <div class="container">
      <p style="color:#3b82f6;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;text-align:center;margin-bottom:8px;">What You Get</p>
      <h2 style="font-size:2rem;font-weight:800;text-align:center;margin-bottom:48px;">Compliance on Autopilot</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🔍</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Continuous Scanning</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Automated weekly scans of your entire website against WCAG 2.2 AA, ADA, and EAA standards.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🚨</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Instant Alerts</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Get notified immediately when a new compliance violation is detected. No surprises.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">📊</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Weekly Reports</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Detailed PDF reports delivered to your inbox every week. Track progress and prove compliance.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">⚖️</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Lawsuit Protection</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Documented compliance efforts are your best defense. Average ADA lawsuit settlement: $4K+. Shield costs $97/mo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section style="padding:80px 0;background:var(--bg-secondary);" id="pricing">
    <div class="container" style="text-align:center;">
      <p style="color:#3b82f6;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px;">Pricing</p>
      <h2 style="font-size:2rem;font-weight:800;margin-bottom:12px;">Shield</h2>
      <p style="color:var(--text-secondary);margin-bottom:40px;">Essential compliance monitoring for small businesses.</p>
      <div style="background:var(--bg-card);border:2px solid rgba(59,130,246,0.3);border-radius:var(--radius);padding:40px;max-width:420px;margin:0 auto;">
        <p style="font-size:3rem;font-weight:800;margin-bottom:4px;">$97<span style="font-size:1rem;color:var(--text-muted);font-weight:400;">/mo</span></p>
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:24px;">Per website · Cancel anytime</p>
        <div style="text-align:left;margin-bottom:28px;">
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Weekly compliance scans</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Instant violation alerts</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Weekly PDF reports</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ WCAG 2.2 AA + EAA standards</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;">✓ Email + Slack notifications</p>
        </div>
        <a href="https://buy.stripe.com/6oUdR88o6cbtgu00hK1B60W" class="cta-shield-checkout" style="display:block;background:#3b82f6;color:#fff;padding:14px;border-radius:10px;font-weight:700;text-decoration:none;text-align:center;box-shadow:0 4px 20px rgba(59,130,246,0.3);">Start Free Trial</a>
      </div>
    </div>
  </section>

  <!-- Compare -->
  <section style="padding:80px 0;" id="compare">
    <div class="container" style="text-align:center;">
      <h2 style="font-size:1.5rem;font-weight:700;margin-bottom:32px;">Compare Plans</h2>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/products/shield/" style="background:rgba(59,130,246,0.1);border:2px solid #3b82f6;color:#3b82f6;padding:16px 24px;border-radius:10px;font-weight:600;text-decoration:none;">Shield $97/mo</a>
        <a href="/products/fortress/" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary);padding:16px 24px;border-radius:10px;font-weight:500;text-decoration:none;">Fortress $247/mo</a>
        <a href="/products/citadel/" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary);padding:16px 24px;border-radius:10px;font-weight:500;text-decoration:none;">Citadel $497/mo</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="padding:80px 0;background:var(--bg-secondary);" id="faq">
    <div class="container" style="max-width:720px;">
      <h2 style="font-size:1.5rem;font-weight:800;text-align:center;margin-bottom:32px;">Frequently Asked Questions</h2>
      <div style="border-top:1px solid var(--border);">
        <div style="padding:20px 0;border-bottom:1px solid var(--border);">
          <h3 style="font-size:1rem;font-weight:600;margin-bottom:8px;">What compliance standards does Shield check?</h3>
          <p style="color:var(--text-secondary);font-size:0.9rem;line-height:1.6;">Shield checks your website against WCAG 2.2 Level AA standards, which covers the vast majority of ADA and EU EAA compliance requirements for websites.</p>
        </div>
        <div style="padding:20px 0;border-bottom:1px solid var(--border);">
          <h3 style="font-size:1rem;font-weight:600;margin-bottom:8px;">How quickly will I get alerts?</h3>
          <p style="color:var(--text-secondary);font-size:0.9rem;line-height:1.6;">Instantly. When a new violation is detected, you'll receive an alert within minutes via email or Slack.</p>
        </div>
        <div style="padding:20px 0;border-bottom:1px solid var(--border);">
          <h3 style="font-size:1rem;font-weight:600;margin-bottom:8px;">Can I cancel anytime?</h3>
          <p style="color:var(--text-secondary);font-size:0.9rem;line-height:1.6;">Yes. No contracts, no commitment. Cancel anytime from your dashboard.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Plausible event tracking -->
  <script is:inline>
    document.querySelectorAll('.cta-shield-trial, .cta-shield-checkout').forEach(function(el) {
      el.addEventListener('click', function() { plausible('cta_click', { props: { page: 'shield', type: 'checkout' } }); });
    });
    document.querySelectorAll('.cta-shield-scan').forEach(function(el) {
      el.addEventListener('click', function() { plausible('cta_click', { props: { page: 'shield', type: 'free_scan' } }); });
    });
  </script>

</Layout>