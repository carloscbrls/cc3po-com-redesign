---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "CC3PO Fortress — Full Compliance Suite",
  "description": "Complete ADA/WCAG/EAA compliance protection: daily scans, remediation guidance, priority support, and legal documentation for growing businesses.",
  "brand": { "@type": "Brand", "name": "CC3PO" },
  "offers": {
    "@type": "Offer",
    "price": "247",
    "priceCurrency": "USD",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": "https://cc3po.com/products/fortress/"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "31"
  }
};
---

<Layout title="Fortress — Full Compliance Protection | CC3PO" description="Complete ADA/WCAG/EAA compliance suite: continuous monitoring, remediation guidance, priority support, and legal documentation. Starting at $247/mo.">

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section style="padding:120px 0 80px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(124,58,237,0.15) 0%,transparent 60%);pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <div style="margin:0 auto 24px;width:72px;height:72px;border-radius:18px;background:rgba(124,58,237,0.12);border:1px solid rgba(124,58,237,0.25);display:flex;align-items:center;justify-content:center;">
        <svg width="40" height="40" viewBox="0 0 32 32"><rect width="32" height="32" rx="6" fill="#7c3aed"/><path d="M16 6L8 11v6c0 5.5 3.4 10.7 8 12 4.6-1.3 8-6.5 8-12v-6L16 6zm0 4l4 2.5v4.5c0 3.2-1.7 6.2-4 7.2-2.3-1-4-4-4-7.2v-4.5L16 10z" fill="#0a0a0a"/></svg>
      </div>
      <p style="color:#a78bfa;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:12px;">Full Compliance Suite</p>
      <h1 style="font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;letter-spacing:-0.02em;line-height:1.1;margin-bottom:20px;">Fortress</h1>
      <p style="font-size:1.15rem;color:var(--text-secondary);max-width:560px;margin:0 auto 36px;line-height:1.6;">Complete compliance protection: monitoring, remediation guidance, priority support, and legal documentation — starting at <strong style="color:#fff;">$247/mo</strong>.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="https://buy.stripe.com/eVq7sKcEmgrJ1z60hK1B60Y" class="cta-fortress-trial" style="background:#7c3aed;color:#fff;padding:14px 32px;border-radius:10px;font-weight:700;font-size:1rem;text-decoration:none;box-shadow:0 4px 20px rgba(124,58,237,0.3);transition:all 0.2s;">Start Free Trial</a>
        <a href="/audit/" class="cta-fortress-scan" style="background:transparent;color:#a78bfa;padding:14px 32px;border-radius:10px;font-weight:600;font-size:1rem;text-decoration:none;border:1px solid rgba(124,58,237,0.3);">Get Free Scan</a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section style="padding:80px 0;" id="features">
    <div class="container">
      <p style="color:#a78bfa;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;text-align:center;margin-bottom:8px;">Everything in Shield, Plus</p>
      <h2 style="font-size:2rem;font-weight:800;text-align:center;margin-bottom:48px;">Full Compliance Protection</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🔍</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Daily Compliance Scans</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Daily scans instead of weekly. Catch issues before they become lawsuits.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🛠️</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Remediation Guidance</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Step-by-step fix instructions for every violation. Covers WCAG 2.2 AA and EU EAA requirements. Your dev team or ours.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">📋</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Legal Documentation</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">VPATs, accessibility statements, and compliance certificates. Everything you need for legal defense.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">⚡</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Priority Support</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Same-day response from our compliance team. We've got your back.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section style="padding:80px 0;background:var(--bg-secondary);" id="pricing">
    <div class="container" style="text-align:center;">
      <p style="color:#a78bfa;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px;">Pricing</p>
      <h2 style="font-size:2rem;font-weight:800;margin-bottom:12px;">Fortress</h2>
      <p style="color:var(--text-secondary);margin-bottom:40px;">Full compliance protection for growing businesses.</p>
      <div style="background:var(--bg-card);border:2px solid rgba(124,58,237,0.3);border-radius:var(--radius);padding:40px;max-width:420px;margin:0 auto;">
        <p style="font-size:3rem;font-weight:800;margin-bottom:4px;">$247<span style="font-size:1rem;color:var(--text-muted);font-weight:400;">/mo</span></p>
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:24px;">Per website · Cancel anytime</p>
        <div style="text-align:left;margin-bottom:28px;">
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Everything in Shield</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Daily compliance scans</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Remediation guidance</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Legal documentation (VPATs)</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;">✓ Priority same-day support</p>
        </div>
        <a href="https://buy.stripe.com/eVq7sKcEmgrJ1z60hK1B60Y" class="cta-fortress-checkout" style="display:block;background:#7c3aed;color:#fff;padding:14px;border-radius:10px;font-weight:700;text-decoration:none;text-align:center;box-shadow:0 4px 20px rgba(124,58,237,0.3);">Start Free Trial</a>
      </div>
    </div>
  </section>

  <!-- Compare -->
  <section style="padding:80px 0;" id="compare">
    <div class="container" style="text-align:center;">
      <h2 style="font-size:1.5rem;font-weight:700;margin-bottom:32px;">Compare Plans</h2>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/products/shield/" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary);padding:16px 24px;border-radius:10px;font-weight:500;text-decoration:none;">Shield $97/mo</a>
        <a href="/products/fortress/" style="background:rgba(124,58,237,0.1);border:2px solid #7c3aed;color:#a78bfa;padding:16px 24px;border-radius:10px;font-weight:600;text-decoration:none;">Fortress $247/mo</a>
        <a href="/products/citadel/" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary);padding:16px 24px;border-radius:10px;font-weight:500;text-decoration:none;">Citadel $497/mo</a>
      </div>
    </div>
  </section>

  <!-- Plausible event tracking -->
  <script is:inline>
    document.querySelectorAll('.cta-fortress-trial, .cta-fortress-checkout').forEach(function(el) {
      el.addEventListener('click', function() { plausible('cta_click', { props: { page: 'fortress', type: 'checkout' } }); });
    });
    document.querySelectorAll('.cta-fortress-scan').forEach(function(el) {
      el.addEventListener('click', function() { plausible('cta_click', { props: { page: 'fortress', type: 'free_scan' } }); });
    });
  </script>

</Layout>