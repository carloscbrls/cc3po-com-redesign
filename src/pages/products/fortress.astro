---
import Layout from '../../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "CC3PO Fortress — Monitoring + Active Fixes",
  "description": "Monitoring plus active fixes: daily scans, hands-on remediation, priority support, and audit-ready documentation for growing businesses — $247/mo.",
  "brand": { "@type": "Brand", "name": "CC3PO" },
  "offers": {
    "@type": "Offer",
    "price": "247",
    "priceCurrency": "USD",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": "https://cc3po.com/products/fortress/"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "31"
  }
};
---

<Layout title="Fortress — Monitoring + Active Fixes | CC3PO" description="Monitoring plus active fixes: daily scans, hands-on remediation, priority support, and audit-ready documentation — $247/mo.">

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section style="padding:120px 0 80px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(124,58,237,0.15) 0%,transparent 60%);pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <div style="margin:0 auto 24px;width:72px;height:72px;border-radius:18px;background:rgba(124,58,237,0.12);border:1px solid rgba(124,58,237,0.25);display:flex;align-items:center;justify-content:center;">
        <svg width="40" height="40" viewBox="0 0 32 32"><rect width="32" height="32" rx="6" fill="#7c3aed"/><path d="M16 6L8 11v6c0 5.5 3.4 10.7 8 12 4.6-1.3 8-6.5 8-12v-6L16 6zm0 4l4 2.5v4.5c0 3.2-1.7 6.2-4 7.2-2.3-1-4-4-4-7.2v-4.5L16 10z" fill="#0a0a0a"/></svg>
      </div>
      <p style="color:#a78bfa;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:12px;">Monitoring + Active Fixes</p>
      <h1 style="font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;letter-spacing:-0.02em;line-height:1.1;margin-bottom:20px;">Fortress</h1>
      <p style="font-size:1.15rem;color:var(--text-secondary);max-width:560px;margin:0 auto 36px;line-height:1.6;">Monitoring plus active fixes: daily scans, hands-on remediation, priority support, and audit-ready documentation — <strong style="color:#fff;">$247/mo</strong>.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="https://scanner.cc3po.com/" class="cta-fortress-scan" style="background:#7c3aed;color:#fff;padding:14px 32px;border-radius:10px;font-weight:700;font-size:1rem;text-decoration:none;box-shadow:0 4px 20px rgba(124,58,237,0.3);transition:all 0.2s;">Get a free scan</a>
        <a href="https://buy.stripe.com/6oU4gyb6PgvR5kr0OzdjO04" class="cta-fortress-checkout" style="background:transparent;color:#a78bfa;padding:14px 32px;border-radius:10px;font-weight:600;font-size:1rem;text-decoration:none;border:1px solid rgba(124,58,237,0.3);">Start Fortress — $247/mo</a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section style="padding:80px 0;" id="features">
    <div class="container">
      <p style="color:#a78bfa;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;text-align:center;margin-bottom:8px;">Everything in Shield, Plus</p>
      <h2 style="font-size:2rem;font-weight:800;text-align:center;margin-bottom:48px;">Monitoring That Fixes Things</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🔍</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Daily Compliance Scans</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Daily scans instead of monthly, so new issues get caught and fixed sooner.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🛠️</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Active Fixes</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">We fix the issues we find (formerly Shield Pro), with step-by-step notes for anything your own dev team prefers to handle. Built around WCAG 2.2 AA and EU EAA requirements.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">📋</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Audit-Ready Documentation</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">VPATs, accessibility statements, and dated scan and fix records to share with your attorney or partners.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">⚡</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Priority Support</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Same-day response from our compliance team.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section style="padding:80px 0;background:var(--bg-secondary);" id="pricing">
    <div class="container" style="text-align:center;">
      <p style="color:#a78bfa;font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px;">Pricing</p>
      <h2 style="font-size:2rem;font-weight:800;margin-bottom:12px;">Fortress</h2>
      <p style="color:var(--text-secondary);margin-bottom:40px;">Monitoring plus active fixes for growing businesses.</p>
      <div style="background:var(--bg-card);border:2px solid rgba(124,58,237,0.3);border-radius:var(--radius);padding:40px;max-width:420px;margin:0 auto;">
        <p style="font-size:3rem;font-weight:800;margin-bottom:4px;">$247<span style="font-size:1rem;color:var(--text-muted);font-weight:400;">/mo</span></p>
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:24px;">Per website · Cancel anytime</p>
        <div style="text-align:left;margin-bottom:28px;">
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Everything in Shield</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Daily compliance scans</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Active fixes for issues found (formerly Shield Pro)</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Monthly compliance reports</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Accessibility documentation (VPATs)</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;">✓ Priority same-day support</p>
        </div>
        <a href="https://buy.stripe.com/6oU4gyb6PgvR5kr0OzdjO04" class="cta-fortress-checkout" style="display:block;background:#7c3aed;color:#fff;padding:14px;border-radius:10px;font-weight:700;text-decoration:none;text-align:center;box-shadow:0 4px 20px rgba(124,58,237,0.3);">Start Fortress — $247/mo</a>
        <a href="https://scanner.cc3po.com/" class="cta-fortress-scan" style="display:block;margin-top:12px;text-align:center;color:#a78bfa;padding:12px;border-radius:10px;font-weight:600;text-decoration:none;border:1px solid var(--border);">Or get a free scan first</a>
      </div>
    </div>
  </section>

  <!-- Compare -->
  <section style="padding:80px 0;" id="compare">
    <div class="container" style="text-align:center;">
      <h2 style="font-size:1.5rem;font-weight:700;margin-bottom:32px;">Compare Plans</h2>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/products/shield/" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary);padding:16px 24px;border-radius:10px;font-weight:500;text-decoration:none;">Shield $97/mo</a>
        <a href="/products/fortress/" style="background:rgba(124,58,237,0.1);border:2px solid #7c3aed;color:#a78bfa;padding:16px 24px;border-radius:10px;font-weight:600;text-decoration:none;">Fortress $247/mo</a>
        <a href="/products/citadel/" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary);padding:16px 24px;border-radius:10px;font-weight:500;text-decoration:none;">Citadel custom, from $597</a>
      </div>
    </div>
  </section>

  <section style="padding:0 0 64px;">
    <div class="container">
      <div class="legal-note" role="note" style="max-width:720px;margin:0 auto 32px;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:12px;padding:16px 20px;font-size:0.85rem;line-height:1.6;color:var(--text-secondary);">
        <p style="margin:0 0 8px;"><strong>Not legal advice.</strong> CC3PO is not a law firm and does not provide legal advice. Our monitoring, fixes, and reports help reduce accessibility and privacy risk, but no service can guarantee compliance or prevent a claim. If you've received a demand letter, talk to a licensed attorney.</p>
        <p lang="es" style="margin:0;"><strong>No es asesoría legal.</strong> CC3PO no es un bufete de abogados y no ofrece asesoría legal. Nuestro monitoreo, correcciones e informes ayudan a reducir riesgos, pero ningún servicio puede garantizar el cumplimiento ni evitar un reclamo. Si recibió una carta de demanda, consulte a un abogado.</p>
      </div>
    </div>
  </section>

  <!-- Plausible event tracking -->
  <script is:inline>
    document.querySelectorAll('.cta-fortress-trial, .cta-fortress-checkout').forEach(function(el) {
      el.addEventListener('click', function() { plausible('cta_click', { props: { page: 'fortress', type: 'checkout' } }); });
    });
    document.querySelectorAll('.cta-fortress-scan').forEach(function(el) {
      el.addEventListener('click', function() { plausible('cta_click', { props: { page: 'fortress', type: 'free_scan' } }); });
    });
  </script>

</Layout>