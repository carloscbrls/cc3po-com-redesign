---
import Layout from '../../layouts/Layout.astro';
import { catalogHelpers } from '../../lib/catalog';

// JSON-LD Product offer minPrice renders from the pricing catalog so
// structured data can never drift from the catalog (merge map step 4).
const { ladderTier } = await catalogHelpers();
const citadelTier = ladderTier('citadel');

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "CC3PO Citadel — Enterprise Compliance Command Center",
  "description": "Enterprise-grade compliance: dedicated account manager, custom policies, multi-site management, and audit-ready documentation including EU EAA, for regulated and multi-location organizations. Custom pricing, from $897/mo.",
  "brand": { "@type": "Brand", "name": "CC3PO" },
  "offers": {
    "@type": "Offer",
    "priceSpecification": { "@type": "PriceSpecification", "minPrice": String(citadelTier.monthlyPrice), "priceCurrency": "USD" },
    "priceCurrency": "USD",
    "priceValidUntil": "2027-12-31",
    "availability": "https://schema.org/InStock",
    "url": "https://cc3po.com/products/citadel/"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "12"
  }
};
---

<Layout title="Citadel — Enterprise Compliance Command Center | CC3PO" description="Enterprise-grade compliance: dedicated account manager, custom policies, multi-site management, and audit-ready documentation. Custom pricing, from $897/mo.">

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Hero -->
  <section style="padding:120px 0 80px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,color-mix(in srgb, var(--brand-gold) 15%, transparent) 0%,transparent 60%);pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <div style="margin:0 auto 24px;width:72px;height:72px;border-radius:18px;background:color-mix(in srgb, var(--brand-gold) 12%, transparent);border:1px solid color-mix(in srgb, var(--brand-gold) 25%, transparent);display:flex;align-items:center;justify-content:center;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--brand-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7v10l10 5 10-5V7L12 2z"/><path d="M12 22V12"/><path d="M22 7L12 12 2 7"/></svg>
      </div>
      <p style="color:var(--brand-gold);font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:12px;">Enterprise Compliance</p>
      <h1 style="font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;letter-spacing:-0.02em;line-height:1.1;margin-bottom:20px;">Citadel</h1>
      <p style="font-size:1.15rem;color:var(--text-secondary);max-width:560px;margin:0 auto 36px;line-height:1.6;">Enterprise-grade compliance command center: dedicated account manager, custom policies, multi-site management, and audit-ready documentation — custom pricing, from <strong style="color:var(--brand-paper);">$897/mo</strong>.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="https://scanner.cc3po.com/" class="cta-citadel-scan" style="background:var(--brand-gold);color:var(--brand-night);padding:14px 32px;border-radius:10px;font-weight:700;font-size:1rem;text-decoration:none;box-shadow:0 4px 20px color-mix(in srgb, var(--brand-gold) 30%, transparent);">Get a free scan</a>
        <a href="https://scheduler.zoom.us/carlos-cabrales-iii/compliance-consultation" class="cta-citadel-checkout" style="background:transparent;color:var(--brand-gold);padding:14px 32px;border-radius:10px;font-weight:600;font-size:1rem;text-decoration:none;border:1px solid color-mix(in srgb, var(--brand-gold) 30%, transparent);">Get a quote — book a call</a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section style="padding:80px 0;" id="features">
    <div class="container">
      <p style="color:var(--brand-gold);font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;text-align:center;margin-bottom:8px;">Everything in Fortress, Plus</p>
      <h2 style="font-size:2rem;font-weight:800;text-align:center;margin-bottom:48px;">Enterprise Command Center</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">👤</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Dedicated Account Manager</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">A named compliance expert who knows your business. Direct line, same-hour response.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🏢</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Multi-Site Management</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Monitor all your properties from one dashboard. Perfect for franchises and multi-location businesses.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">📜</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Custom Compliance Policies</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Tailored policies for your industry — healthcare, government, retail, or any regulated vertical.</p>
        </div>
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:32px;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🛡️</div>
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:8px;">Documentation &amp; Attorney Support</h3>
          <p style="color:var(--text-secondary);font-size:0.95rem;line-height:1.6;">Comprehensive accessibility documentation and records, plus technical support for your attorney if you receive an ADA or EAA demand letter.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section style="padding:80px 0;background:var(--bg-secondary);" id="pricing">
    <div class="container" style="text-align:center;">
      <p style="color:var(--brand-gold);font-size:0.85rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px;">Pricing</p>
      <h2 style="font-size:2rem;font-weight:800;margin-bottom:12px;">Citadel</h2>
      <p style="color:var(--text-secondary);margin-bottom:40px;">Enterprise compliance for regulated and multi-location businesses.</p>
      <div style="background:var(--bg-card);border:2px solid color-mix(in srgb, var(--brand-gold) 30%, transparent);border-radius:var(--radius);padding:40px;max-width:420px;margin:0 auto;">
        <p style="font-size:3rem;font-weight:800;margin-bottom:4px;"><span style="font-size:1rem;color:var(--text-muted);font-weight:400;">from </span>$897<span style="font-size:1rem;color:var(--text-muted);font-weight:400;">/mo</span></p>
        <p style="color:var(--text-muted);font-size:0.85rem;margin-bottom:8px;">Custom pricing · quoted after a call</p>
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:24px;">Per organization · Cancel anytime</p>
        <div style="text-align:left;margin-bottom:28px;">
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Everything in Fortress</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Dedicated account manager</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Multi-site management</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;margin-bottom:8px;">✓ Custom compliance policies</p>
          <p style="color:var(--text-secondary);font-size:0.95rem;">✓ Full accessibility documentation</p>
        </div>
        <a href="https://scheduler.zoom.us/carlos-cabrales-iii/compliance-consultation" class="cta-citadel-checkout" style="display:block;background:var(--brand-gold);color:var(--brand-night);padding:14px;border-radius:10px;font-weight:700;text-decoration:none;text-align:center;box-shadow:0 4px 20px color-mix(in srgb, var(--brand-gold) 30%, transparent);">Get a quote — book a call</a>
        <a href="https://scanner.cc3po.com/" class="cta-citadel-scan" style="display:block;margin-top:12px;text-align:center;color:var(--brand-gold);padding:12px;border-radius:10px;font-weight:600;text-decoration:none;border:1px solid var(--border);">Or get a free scan first</a>
      </div>
    </div>
  </section>

  <!-- Compare -->
  <section style="padding:80px 0;" id="compare">
    <div class="container" style="text-align:center;">
      <h2 style="font-size:1.5rem;font-weight:700;margin-bottom:32px;">Compare Plans</h2>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/products/shield/" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary);padding:16px 24px;border-radius:10px;font-weight:500;text-decoration:none;">Shield $297/mo</a>
        <a href="/products/fortress/" style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary);padding:16px 24px;border-radius:10px;font-weight:500;text-decoration:none;">Fortress $447/mo</a>
        <a href="/products/citadel/" style="background:color-mix(in srgb, var(--brand-gold) 10%, transparent);border:2px solid var(--brand-gold);color:var(--brand-gold);padding:16px 24px;border-radius:10px;font-weight:600;text-decoration:none;">Citadel custom, from $897</a>
      </div>
    </div>
  </section>

  <section style="padding:0 0 64px;">
    <div class="container">
      <div class="legal-note" role="note" style="max-width:720px;margin:0 auto 32px;background:color-mix(in srgb, var(--brand-paper) 3%, transparent);border:1px solid var(--border);border-radius:12px;padding:16px 20px;font-size:0.85rem;line-height:1.6;color:var(--text-secondary);">
        <p style="margin:0 0 8px;"><strong>Not legal advice.</strong> CC3PO is not a law firm and does not provide legal advice. Our monitoring, fixes, and reports help reduce accessibility and privacy risk, but no service can guarantee compliance or prevent a claim. If you've received a demand letter, talk to a licensed attorney.</p>
        <p lang="es" style="margin:0;"><strong>No es asesoría legal.</strong> CC3PO no es un bufete de abogados y no ofrece asesoría legal. Nuestro monitoreo, correcciones e informes ayudan a reducir riesgos, pero ningún servicio puede garantizar el cumplimiento ni evitar un reclamo. Si recibió una carta de demanda, consulte a un abogado.</p>
      </div>
    </div>
  </section>


</Layout>