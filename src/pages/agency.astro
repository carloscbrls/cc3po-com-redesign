    <script>
      // Domain search — pass user input to SiteGround
      const domainInput = document.getElementById('domain-search-input');
      const domainBtn = document.getElementById('domain-search-btn');
      if (domainInput && domainBtn) {
        domainInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            const query = domainInput.value.trim();
            if (query) {
              window.open('https://www.siteground.com/domains/search/' + encodeURIComponent(query) + '?afcode=a3sob40itj', '_blank');
            } else {
              window.open('https://www.siteground.com/go/a3sob40itj', '_blank');
            }
          }
        });
        domainBtn.addEventListener('click', function(e) {
          const query = domainInput ? domainInput.value.trim() : '';
          if (query) {
            e.preventDefault();
            window.open('https://www.siteground.com/domains/search/' + encodeURIComponent(query) + '?afcode=a3sob40itj', '_blank');
          }
        });
      }

      // Lead form submission
      document.getElementById('agency-lead-form')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const form = e.target;
        const data = {
          name: form.name.value,
          business: form.business.value,
          phone: form.phone.value,
          email: form.email.value,
          industry: form.industry.value,
          needs: form.needs.value,
          source: 'agency-page',
          timestamp: new Date().toISOString()
        };
        try {
          const resp = await fetch('https://cc3po.com/api/agency-lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          if (resp.ok) {
            form.style.display = 'none';
            document.getElementById('form-success').style.display = 'block';
          }
        } catch(e) {
          form.style.display = 'none';
          document.getElementById('form-success').style.display = 'block';
        }
      });
    </script>

