---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CC3PO Agency — Professional Websites Built Fast | Starting at $97/mo" description="Get a professional website built with AI in 48 hours. Domain, hosting, SSL, and white-label portal included. Plans starting at $97/mo. No hidden fees.">
  <!-- Hero -->
  <section class="relative min-h-[80vh] flex items-center justify-center text-center px-4 sm:px-6 pt-24 pb-16 overflow-hidden" style="background: #0a0a12;">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 0%, rgba(16,185,129,0.08) 0%, transparent 60%), radial-gradient(ellipse at 80% 100%, rgba(16,185,129,0.04) 0%, transparent 50%);"></div>
    <div class="relative z-10" style="max-width: 800px;">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold tracking-wide mb-6" style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.25); color: #34d399;">
        <span class="badge-dot"></span>
        Built with AI — Delivered in 48 hours
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold leading-[1.1] tracking-tighter mb-5" style="color: #fff; font-family: var(--lux-serif); font-weight: 700; letter-spacing: -1.5px;">
        Professional Websites,<br>
        <span style="background: linear-gradient(135deg, #ffffff 0%, #d4af37 40%, #10b981 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Built Fast</span>
      </h1>
      <p class="text-base sm:text-lg mb-8" style="color: rgba(255,255,255,0.78); max-width: 640px; margin-left: auto; margin-right: auto; line-height: 1.7;">
        One place to buy your domain, build your site, and manage everything.
        No tech skills needed. No multiple vendors. No hidden fees.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="#pricing" class="btn-primary">See Plans</a>
        <a href="tel:+12092321265" class="btn-secondary">Call (209) 232-1265</a>
        <a href="#domain" class="btn-secondary" style="font-size: 14px;">Buy a Domain</a>
      </div>
    </div>
  </section>

  <section style="max-width: 1200px; margin: 0 auto; padding: 0 16px 64px;">
    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-number">48<span class="stat-unit">hr</span></div>
        <div class="stat-label">Average build time</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">12+</div>
        <div class="stat-label">Sites hosted</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">9</div>
        <div class="stat-label">Active clients</div>
      </div>
      <div class="stat-card">
        <div class="stat-number">100<span class="stat-unit">%</span></div>
        <div class="stat-label">White-label delivery</div>
      </div>
    </div>

    <!-- How It Works -->
    <div class="section">
      <h2 class="section-title">How It Works</h2>
      <p class="section-desc">Four simple steps from idea to live website.</p>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          </div>
          <div class="step-number">STEP 1</div>
          <h3 class="step-title">Buy Your Domain</h3>
          <p class="step-desc">Search and register your domain through our link. Or bring your own.</p>
        </div>
        <div class="step-card">
          <div class="step-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <div class="step-number">STEP 2</div>
          <h3 class="step-title">Choose Your Path</h3>
          <p class="step-desc">We build it for you, or you tell us what you want and our AI village builds it.</p>
        </div>
        <div class="step-card">
          <div class="step-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
          </div>
          <div class="step-number">STEP 3</div>
          <h3 class="step-title">Get Your Portal</h3>
          <p class="step-desc">White-label dashboard to manage your site, email, and billing.</p>
        </div>
        <div class="step-card">
          <div class="step-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 13l4 4L19 7"/></svg>
          </div>
          <div class="step-number">STEP 4</div>
          <h3 class="step-title">Go Live</h3>
          <p class="step-desc">Site deployed with SSL, CDN, backups, and monitoring — on SiteGround (WordPress) or Netlify (Astro &amp; other stacks).</p>
        </div>
      </div>
    </div>

    <!-- Domain Search -->
    <div id="domain" class="domain-card">
      <div class="domain-header">
        <div>
          <h2 class="section-title" style="text-align: left;">Step 1: Get Your Domain</h2>
          <p class="section-desc" style="text-align: left; margin: 4px 0 0;">Search for available domains. We use SiteGround for registration — you get a great price, we get a small commission. Hosting is matched to your stack: <strong>SiteGround for WordPress</strong>, <strong>Netlify for Astro &amp; other modern languages</strong>.</p>
        </div>
        <div class="price-badge">
          <p class="price-badge-label">Domains starting at</p>
          <p class="price-badge-amount">$10<span class="price-badge-unit">/yr</span></p>
        </div>
      </div>
      <div class="domain-search-row">
        <div class="search-input-wrap">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" id="domain-search-input" placeholder="yourbusiness.com" class="search-input" />
        </div>
        <a id="domain-search-btn" href="https://www.siteground.com/go/a3sob40itj" target="_blank" rel="noopener" class="btn-primary" style="white-space: nowrap;">Search on SiteGround →</a>
      </div>
      <div class="domain-features">
        <div class="domain-feature">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0; margin-top: 2px;"><path d="M5 13l4 4L19 7"/></svg>
          <span><strong>$10-15/year</strong> for .com through SiteGround. No markup.</span>
        </div>
        <div class="domain-feature">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0; margin-top: 2px;"><path d="M5 13l4 4L19 7"/></svg>
          <span><strong>Already have a domain?</strong> We'll point it to your new site.</span>
        </div>
        <div class="domain-feature">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0; margin-top: 2px;"><path d="M5 13l4 4L19 7"/></svg>
          <span><strong>Buy through our link</strong> and we earn a commission that keeps prices low.</span>
        </div>
      </div>
    </div>

    <!-- Step 2: Choose Your Path -->
    <div class="section">
      <h2 class="section-title">Step 2: Choose Your Path</h2>
      <p class="section-desc">Two ways to get your site built. Pick the one that fits you best.</p>
      <div class="paths-grid">
        <!-- We Build -->
        <div class="path-card path-card-highlight">
          <div class="popular-badge">MOST POPULAR</div>
          <div class="path-header">
            <div class="path-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h3 class="path-name">We Build It For You</h3>
              <p class="path-sub">Sit back, we handle everything</p>
            </div>
          </div>
          <p class="path-desc">Tell us what you need. We use AI to build your site fast. You review, we refine, you go live.</p>
          <ul class="path-features">
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Built in <strong>24-48 hours</strong></li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>You review and request changes</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>We handle domain setup, SSL, everything</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Ongoing support and edits</li>
          </ul>
          <a href="#pricing" class="btn-primary" style="display: block; text-align: center; width: 100%;">See Plans →</a>
        </div>
        <!-- Build Yourself -->
        <div class="path-card">
          <div class="path-header">
            <div class="path-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="path-name">You Tell Us, We Build It</h3>
              <p class="path-sub">Powered by the CC3PO AI Village — we do the work</p>
            </div>
          </div>
          <p class="path-desc">You tell us what you need — your business type, what pages you want, your colors, your logo. Our AI village takes that info and builds your entire site on a modern, hand-crafted stack. You just review and approve.</p>
          <ul class="path-features">
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>You give us <strong>basic info</strong> — business name, what you do, your preferences</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Our AI village builds it — <strong>you don't touch the tool</strong></li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>You review, we refine — <strong>done in 24-48 hours</strong></li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>We handle <strong>everything</strong> — domain, hosting, deployment</li>
          </ul>
          <a href="#pricing" class="btn-primary" style="display: block; text-align: center; width: 100%;">Get Started →</a>
        </div>
      </div>
    </div>

    <!-- Pricing -->
    <div id="pricing" class="section">
      <h2 class="section-title">Step 3: Pick a Plan</h2>
      <p class="section-desc">All plans include hosting, free SSL, CDN, daily backups, and your own white-label client portal. WordPress sites run on SiteGround; Astro &amp; other modern stacks run on Netlify.</p>
      <div class="pricing-grid">
        <!-- Spark -->
        <div class="price-card">
          <h3 class="price-name">Spark</h3>
          <p class="price-desc">Perfect for getting started</p>
          <div class="price-amount">$97<span>/mo</span></div>
          <p class="price-note">Domain not included (~$10-15/yr)</p>
          <ul class="price-features">
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>1-page professional website</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Free SSL &amp; CDN</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Daily backups</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Email account setup</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>1 monthly edit</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>White-label client portal</li>
          </ul>
          <a href="https://checkout.cc3po.com/b/9B600i1ZI3EXelS5C41B61z" class="btn-primary" style="display: block; text-align: center; width: 100%;">Get Spark</a>
        </div>
        <!-- Engine (Popular) -->
        <div class="price-card price-card-highlight">
          <div class="popular-badge">POPULAR</div>
          <h3 class="price-name">Engine</h3>
          <p class="price-desc">For growing businesses</p>
          <div class="price-amount">$297<span>/mo</span></div>
          <p class="price-note">Domain not included (~$10-15/yr)</p>
          <ul class="price-features">
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Multi-page website (up to 5 pages)</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Blog setup</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>SEO optimization</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Free SSL &amp; CDN</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Daily backups</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>3 monthly edits</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Domain setup + migration</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>White-label client portal</li>
          </ul>
          <a href="https://checkout.cc3po.com/b/00w14mgUC1wPa5Ce8A1B61A" class="btn-primary" style="display: block; text-align: center; width: 100%;">Get Engine</a>
        </div>
        <!-- Command -->
        <div class="price-card">
          <h3 class="price-name">Command</h3>
          <p class="price-desc">Full power for serious businesses</p>
          <div class="price-amount">$497<span>/mo</span></div>
          <p class="price-note">Domain not included (~$10-15/yr)</p>
          <ul class="price-features">
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Full custom website (unlimited pages)</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Ecommerce ready</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Advanced SEO + analytics</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Free SSL &amp; CDN</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Daily backups</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Priority support</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>Unlimited edits</li>
            <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: #10b981; flex-shrink: 0;"><path d="M5 13l4 4L19 7"/></svg>White-label client portal</li>
          </ul>
          <a href="https://checkout.cc3po.com/b/28E9AS9sa0sLgu08Og1B61B" class="btn-primary" style="display: block; text-align: center; width: 100%;">Get Command</a>
        </div>
      </div>
    </div>

    <!-- Built by the CC3PO Village -->
    <div class="bolt-card">
      <div class="bolt-header">
        <div class="bolt-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l2.4 7.2H22l-6 4.6 2.3 7.2-6.3-4.5-6.3 4.5L8 13.8 2 9.2h7.6z"/></svg>
        </div>
        <h2 class="bolt-title">Built by the CC3PO AI Village</h2>
      </div>
      <p class="bolt-desc">Every site we build is crafted by our own <strong>AI village</strong> — a coordinated team of specialized agents running on a modern, hand-crafted stack (Astro, Netlify, Cloudflare). No third-party drag-and-drop builder. Here's why that matters for your business:</p>
      <div class="bolt-features">
        <div class="bolt-feature-card">
          <div class="bolt-feature-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="bolt-feature-title">Built in Hours, Not Weeks</h3>
          <p class="bolt-feature-desc">Traditional agencies take 4-6 weeks. Our AI village builds in 24-48 hours. You get your site faster, and we pass the speed on to you.</p>
        </div>
        <div class="bolt-feature-card">
          <div class="bolt-feature-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          </div>
          <h3 class="bolt-feature-title">Easy Updates</h3>
          <p class="bolt-feature-desc">Need a change? Just tell us. We update your site and deploy instantly. No waiting, no complex CMS training.</p>
        </div>
        <div class="bolt-feature-card">
          <div class="bolt-feature-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="bolt-feature-title">Full Customization</h3>
          <p class="bolt-feature-desc">Unlike drag-and-drop builders, we write real, clean code. Your site isn't locked into a template — it's fully customizable and can grow with your business.</p>
        </div>
