---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CC3PO Agency — Websites, Domains & Automation">
  <style>
    .agency-iframe {
      width: 100%;
      border: none;
      display: block;
    }
  </style>

  <iframe src="https://insights.cc3po.com/agency/" class="agency-iframe" id="agency-frame" title="CC3PO Agency Services" loading="eager"></iframe>

  <script>
    // Auto-resize iframe to fit content
    function resizeIframe() {
      const frame = document.getElementById('agency-frame');
      if (!frame) return;
      
      try {
        // Try to get the iframe's content height
        const height = frame.contentWindow.document.documentElement.scrollHeight;
        frame.style.height = height + 'px';
      } catch(e) {
        // Cross-origin restrictions - use a fixed large height as fallback
        frame.style.height = '6000px';
      }
    }

    // Try to resize after load
    frame.addEventListener('load', () => {
      setTimeout(resizeIframe, 1000);
    });

    // Fallback: set a large height immediately
    frame.style.height = '6000px';
  </script>
</Layout>
