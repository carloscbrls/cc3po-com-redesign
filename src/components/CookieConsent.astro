---
// Cookie Consent Banner — GDPR/ePrivacy/CCPA compliant
// Self-hosted, no third-party scripts, privacy-first
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie consent" aria-describedby="cookie-desc" style="display:none;">
  <div class="cookie-content">
    <div class="cookie-text">
      <p id="cookie-desc">We use essential cookies to keep our site running and optional analytics cookies to improve your experience. We <strong>do not sell</strong> your data. <a href="/privacy/">Privacy Policy</a> · <a href="/cookie-policy/">Cookie Policy</a></p>
    </div>
    <div class="cookie-actions">
      <button id="cookie-accept" class="cookie-btn cookie-btn-accept" type="button">Accept All</button>
      <button id="cookie-reject" class="cookie-btn cookie-btn-reject" type="button">Essential Only</button>
      <button id="cookie-settings" class="cookie-btn cookie-btn-settings" type="button" aria-expanded="false" aria-controls="cookie-settings-panel">Customize</button>
    </div>
  </div>
  <div id="cookie-settings-panel" class="cookie-settings" style="display:none;" role="region" aria-label="Cookie settings">
    <div class="cookie-setting-row">
      <div>
        <strong>Essential</strong>
        <p>Necessary for the site to function. Cannot be disabled.</p>
      </div>
      <label class="cookie-toggle"><input type="checkbox" checked disabled aria-label="Essential cookies always on" /><span class="cookie-slider"></span></label>
    </div>
    <div class="cookie-setting-row">
      <div>
        <strong>Analytics</strong>
        <p>Help us understand how visitors use our site. Data is anonymized.</p>
      </div>
      <label class="cookie-toggle"><input type="checkbox" id="cookie-analytics" aria-label="Analytics cookies" /><span class="cookie-slider"></span></label>
    </div>
    <div class="cookie-setting-row">
      <div>
        <strong>Marketing</strong>
        <p>Used to deliver relevant ads and track campaign performance.</p>
      </div>
      <label class="cookie-toggle"><input type="checkbox" id="cookie-marketing" aria-label="Marketing cookies" /><span class="cookie-slider"></span></label>
    </div>
    <div class="cookie-setting-row cookie-actions-save">
      <button id="cookie-save" class="cookie-btn cookie-btn-accept" type="button">Save Preferences</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #0f0f1a;
    border-top: 2px solid var(--accent, #e8506b);
    z-index: 9999;
    padding: 20px 24px;
    box-shadow: 0 -4px 24px rgba(0,0,0,0.5);
    font-family: 'Inter', system-ui, sans-serif;
  }
  .cookie-content {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cookie-text {
    flex: 1;
    min-width: 280px;
  }
  .cookie-text p {
    font-size: 14px;
    color: #a1a1aa;
    line-height: 1.6;
    margin: 0;
  }
  .cookie-text a {
    color: #e8506b;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cookie-text a:hover {
    color: #f0617a;
  }
  .cookie-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cookie-btn {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }
  .cookie-btn-accept {
    background: #e8506b;
    color: #fff;
  }
  .cookie-btn-accept:hover {
    background: #f0617a;
  }
  .cookie-btn-reject {
    background: rgba(255,255,255,0.08);
    color: #a1a1aa;
    border: 1px solid rgba(255,255,255,0.12);
  }
  .cookie-btn-reject:hover {
    background: rgba(255,255,255,0.14);
    color: #fff;
  }
  .cookie-btn-settings {
    background: transparent;
    color: #a1a1aa;
    border: 1px solid rgba(255,255,255,0.12);
  }
  .cookie-btn-settings:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.3);
  }
  .cookie-settings {
    max-width: 1100px;
    margin: 16px auto 0;
    padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .cookie-setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .cookie-setting-row strong {
    color: #fff;
    font-size: 14px;
  }
  .cookie-setting-row p {
    color: #71717a;
    font-size: 12px;
    margin: 4px 0 0;
  }
  .cookie-actions-save {
    justify-content: flex-end;
    border-bottom: none;
    padding-top: 16px;
  }
  .cookie-toggle {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
  }
  .cookie-toggle input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .cookie-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(255,255,255,0.1);
    border-radius: 24px;
    transition: 0.3s;
  }
  .cookie-slider::before {
    content: "";
    position: absolute;
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background: #fff;
    border-radius: 50%;
    transition: 0.3s;
  }
  .cookie-toggle input:checked + .cookie-slider {
    background: #e8506b;
  }
  .cookie-toggle input:checked + .cookie-slider::before {
    transform: translateX(20px);
  }
  .cookie-toggle input:focus + .cookie-slider {
    box-shadow: 0 0 0 2px rgba(232,80,107,0.3);
  }
  @media (max-width: 640px) {
    .cookie-content {
      flex-direction: column;
      text-align: center;
    }
    .cookie-actions {
      justify-content: center;
      width: 100%;
    }
  }
</style>

<script is:inline>
(function() {
  var banner = document.getElementById('cookie-banner');
  var settingsPanel = document.getElementById('cookie-settings-panel');
  var settingsBtn = document.getElementById('cookie-settings');
  var acceptBtn = document.getElementById('cookie-accept');
  var rejectBtn = document.getElementById('cookie-reject');
  var saveBtn = document.getElementById('cookie-save');
  var analyticsCheck = document.getElementById('cookie-analytics');
  var marketingCheck = document.getElementById('cookie-marketing');

  function getConsent() {
    try { return JSON.parse(localStorage.getItem('cc3po_cookie_consent')); } catch(e) { return null; }
  }

  function setConsent(preferences) {
    var consent = { preferences: preferences, timestamp: Date.now() };
    localStorage.setItem('cc3po_cookie_consent', JSON.stringify(consent));
    applyConsent(preferences);
    banner.style.display = 'none';
  }

  function applyConsent(preferences) {
    // Analytics (Plausible) — self-hosted, privacy-friendly, but still respect consent
    if (preferences.analytics && window.plausible) {
      // Plausible is already loaded; just note consent
    } else if (!preferences.analytics) {
      // Remove Plausible tracking
      var scripts = document.querySelectorAll('script[src*="plausible"]');
      scripts.forEach(function(s) { s.remove(); });
    }
    // Marketing — we don't load any third-party marketing scripts yet
  }

  var consent = getConsent();
  if (!consent) {
    banner.style.display = 'block';
  } else {
    applyConsent(consent.preferences);
  }

  acceptBtn.addEventListener('click', function() {
    setConsent({ essential: true, analytics: true, marketing: true });
  });

  rejectBtn.addEventListener('click', function() {
    setConsent({ essential: true, analytics: false, marketing: false });
  });

  settingsBtn.addEventListener('click', function() {
    var visible = settingsPanel.style.display !== 'none';
    settingsPanel.style.display = visible ? 'none' : 'block';
    settingsBtn.setAttribute('aria-expanded', String(!visible));
  });

  saveBtn.addEventListener('click', function() {
    setConsent({
      essential: true,
      analytics: analyticsCheck.checked,
      marketing: marketingCheck.checked
    });
  });
})();
</script>