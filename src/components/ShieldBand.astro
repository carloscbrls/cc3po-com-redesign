---
/**
 * ShieldBand — the Compliance Shield band: danger-surface panel with a
 * rose edge bar and a mono label. Universal template pattern (Direction A).
 * Copy is passed in verbatim by the page; actions arrive via the slot.
 */
interface Props { badge: string; title: string; body: string }
const { badge, title, body } = Astro.props;
---

<section class="shield-band" id="shield-cta">
  <div class="container">
    <div class="shield-card">
      <div class="shield-body">
        <div class="shield-badge">{badge}</div>
        <h2>{title}</h2>
        <p>{body}</p>
      </div>
      <div class="shield-actions">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .shield-band { padding: var(--spacing-xl) 0; background: var(--brand-night); }
  .shield-card {
    position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--spacing-lg); flex-wrap: wrap;
    background: var(--semantic-danger-surface);
    border: 1px solid color-mix(in srgb, var(--brand-accent) 25%, transparent);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg) var(--spacing-xl);
  }
  .shield-card::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 6px; background: var(--brand-accent);
  }
  .shield-body { flex: 1; min-width: 280px; }
  .shield-badge {
    font-family: var(--font-mono); font-size: var(--type-caption); font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase; color: var(--semantic-danger-tint);
    margin-bottom: var(--spacing-xs);
  }
  .shield-card h2 {
    margin: 0 0 6px; color: var(--brand-paper);
    font-size: var(--type-3xl); font-weight: 800; letter-spacing: -0.5px; line-height: 1.2;
  }
  .shield-card p { margin: 0; color: var(--text-secondary); font-size: var(--type-body); line-height: 1.6; max-width: 640px; }
  .shield-actions { display: flex; gap: var(--spacing-sm); flex-wrap: wrap; }
  .shield-actions :global(.btn-secondary) {
    background: var(--brand-navy); border-color: transparent; color: var(--brand-paper);
  }
  .shield-actions :global(.btn-secondary:hover) {
    background: color-mix(in srgb, var(--brand-navy) 80%, var(--brand-paper)); color: var(--brand-paper);
  }
  @media (max-width: 768px) {
    .shield-card { flex-direction: column; align-items: flex-start; padding: var(--spacing-lg); }
  }
</style>
