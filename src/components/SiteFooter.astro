<style>
  .footer {
    background: #0a0a0f;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 60px 0 24px;
    margin-top: 80px;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }
  .footer-brand p {
    font-size: 14px;
    color: #a1a1aa;
    line-height: 1.6;
  }
  .footer-col-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #fff;
    margin-bottom: 16px;
  }
  .footer-col-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer-col-links a {
    font-size: 14px;
    color: #a1a1aa;
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-col-links a:hover {
    color: #4fc3f7;
  }
  .footer-social {
    display: flex;
    gap: 16px;
    padding: 24px 0;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    margin-bottom: 24px;
  }
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255,255,255,0.05);
    color: #a1a1aa;
    transition: all 0.2s;
  }
  .social-link:hover {
    background: rgba(107,53,255,0.15);
    color: #fff;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: #a1a1aa;
  }
  .footer-legal {
    display: flex;
    gap: 16px;
  }
  .footer-legal a {
    color: #a1a1aa;
    text-decoration: none;
  }
  .footer-legal a:hover {
    color: #e0e0e0;
  }
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>