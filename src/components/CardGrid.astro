---
/**
 * CardGrid — panel-grammar card grid (Command Center template pattern).
 * Two variants: "panel" (kicker + title + body, e.g. How It Works steps
 * and stat cards) and "quote" (testimonials). Copy arrives verbatim.
 */
export interface PanelItem { kicker?: string; icon?: string; title: string; body: string }
export interface QuoteItem { stars: string; text: string; name: string; role: string }
interface Props {
  label?: string;
  title?: string;
  desc?: string;
  variant?: 'panel' | 'quote';
  items: PanelItem[] | QuoteItem[];
  alt?: boolean;
}
const { label, title, desc, variant = 'panel', items, alt = false } = Astro.props as Props;
const isQuote = variant === 'quote';
---

<section class:list={['card-grid-section', alt && 'card-grid-alt']}>
  <div class="container">
    {(label || title || desc) && (
      <div class="cc-section-header reveal">
        {label && <div class="cc-label">{label}</div>}
        {title && <h2 class="cc-title">{title}</h2>}
        {desc && <p class="cc-desc">{desc}</p>}
      </div>
    )}
    <div class:list={['card-grid', isQuote && 'card-grid-quotes', 'reveal']}>
      {isQuote
        ? (items as QuoteItem[]).map((item) => (
            <figure class="cc-card quote-card">
              <div class="quote-stars" aria-label="5 out of 5 stars">{item.stars}</div>
              <blockquote class="quote-text">{item.text}</blockquote>
              <figcaption class="quote-author">
                <div class="quote-name">{item.name}</div>
                <div class="quote-role">{item.role}</div>
              </figcaption>
            </figure>
          ))
        : (items as PanelItem[]).map((item) => (
            <article class="cc-card panel-card">
              {item.kicker && <div class="panel-kicker">{item.kicker}</div>}
              {item.icon && <div class="panel-icon" aria-hidden="true">{item.icon}</div>}
              <h3 class="panel-title">{item.title}</h3>
              <p class="panel-body">{item.body}</p>
            </article>
          ))}
    </div>
    <slot />
  </div>
</section>

<style>
  .card-grid-section { padding: var(--spacing-4xl) 0; background: var(--brand-night); }
  .card-grid-alt { background: var(--brand-surface-dark); }
  .cc-section-header { text-align: center; max-width: 640px; margin: 0 auto var(--spacing-2xl); }
  .cc-label {
    font-family: var(--font-mono); font-size: var(--type-caption); font-weight: 700;
    letter-spacing: 3px; text-transform: uppercase; color: var(--brand-gold);
    margin-bottom: var(--spacing-md);
  }
  .cc-title {
    font-size: clamp(var(--type-3xl), 4vw, var(--type-5xl));
    font-weight: 800; line-height: 1.1; letter-spacing: -1.5px; color: var(--brand-paper);
    margin-bottom: var(--spacing-md);
  }
  .cc-desc { font-size: var(--type-lg); color: var(--text-secondary); line-height: 1.65; }
  .card-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-lg);
  }
  .cc-card {
    background: linear-gradient(170deg, color-mix(in srgb, var(--brand-navy) 14%, var(--brand-night)), var(--brand-night));
    border: 1px solid var(--border); border-radius: var(--radius-md);
    padding: var(--spacing-xl);
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
    margin: 0;
  }
  .card-grid-alt .cc-card {
    background: linear-gradient(170deg, color-mix(in srgb, var(--brand-navy) 14%, var(--brand-surface-dark)), var(--brand-surface-dark));
  }
  .cc-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--brand-gold) 35%, transparent);
    box-shadow: var(--shadow-card-hover);
  }
  .panel-kicker {
    font-family: var(--font-mono); font-size: var(--type-caption); font-weight: 700;
    letter-spacing: 2px; color: var(--semantic-danger-tint); margin-bottom: var(--spacing-md);
  }
  .panel-icon { font-size: 36px; margin-bottom: var(--spacing-md); display: block; }
  .panel-title { font-size: var(--type-lg); font-weight: 700; color: var(--brand-paper); margin-bottom: var(--spacing-xs); }
  .panel-body { font-size: var(--type-body); color: var(--text-secondary); line-height: 1.6; }
  .quote-card { display: flex; flex-direction: column; }
  .quote-stars { color: var(--brand-gold); font-size: var(--type-lg); letter-spacing: 2px; margin-bottom: var(--spacing-md); }
  .quote-text {
    font-size: var(--type-body); color: var(--text-secondary); line-height: 1.7;
    font-style: italic; flex: 1; margin: 0 0 var(--spacing-lg);
  }
  .quote-name { font-size: var(--type-base); font-weight: 700; color: var(--brand-paper); }
  .quote-role { font-size: var(--type-caption); color: var(--text-muted); margin-top: 2px; }
  @media (max-width: 768px) {
    .card-grid { grid-template-columns: 1fr; }
    .card-grid-section { padding: var(--spacing-3xl) 0; }
  }
</style>
