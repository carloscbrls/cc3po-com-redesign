---
/**
 * HeroOps — the Command Center hero: headline + lead form on the left,
 * the OpsPanel (named slot "panel") on the right. Universal template
 * pattern (Direction A, 2026-11-24). One message, one primary action:
 * the scan form is the action; the panel is the proof beside it.
 * Slotted form markup keeps its existing classes/IDs — this component
 * styles it via :global() so form handlers stay untouched.
 */
interface Props {
  eyebrow: string;
  titleLead: string;
  titleAccent: string;
  sub: string;
  location: string;
}
const { eyebrow, titleLead, titleAccent, sub, location } = Astro.props;
---

<section class="cc-hero" id="main-content">
  <video class="hero-video" autoplay loop muted playsinline aria-label="Animated network visualization background">
    <source src="/videos/hero-network.webm" type="video/webm">
    <source src="/videos/hero-network.mp4" type="video/mp4">
  </video>
  <button class="video-pause-btn" id="video-pause-btn" aria-label="Pause background video" title="Pause video">⏸</button>
  <canvas id="hero-canvas"></canvas>
  <div class="container cc-hero-grid">
    <div class="cc-hero-copy">
      <div class="cc-eyebrow reveal">
        <span class="pulse-dot"></span>
        {eyebrow}
      </div>
      <h1 class="cc-hero-title reveal">
        {titleLead}<br /><span class="cc-gold">{titleAccent}</span>
      </h1>
      <p class="cc-hero-sub reveal">{sub}</p>
      <div class="cc-hero-mobile reveal">
        <slot name="mobile-cta" />
      </div>
      <slot />
      <p class="cc-hero-location hide-mobile reveal">{location}</p>
    </div>
    <div class="cc-hero-panel reveal">
      <slot name="panel" />
    </div>
  </div>
</section>

<style>
  .cc-hero {
    position: relative; overflow: hidden;
    padding: calc(var(--nav-height) + var(--spacing-2xl)) 0 var(--spacing-3xl);
    background: linear-gradient(180deg, var(--brand-night) 0%, var(--brand-surface-dark) 100%);
  }
  .cc-hero::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 60% 50% at 50% 0%, color-mix(in srgb, var(--semantic-success) 8%, transparent), transparent 70%);
  }
  .video-pause-btn {
    position: absolute; top: 12px; right: 12px; z-index: 10;
    width: 44px; height: 44px; border-radius: 50%; border: none; cursor: pointer;
    background: color-mix(in srgb, var(--brand-ink) 50%, transparent);
    color: var(--brand-paper); font-size: 14px; opacity: 0.6; transition: opacity 0.2s;
  }
  .video-pause-btn:hover { opacity: 1; }
  .cc-hero-grid {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: 1.02fr 0.98fr;
    gap: var(--spacing-2xl); align-items: start;
  }
  .cc-eyebrow {
    display: inline-flex; align-items: center; gap: var(--spacing-xs);
    font-family: var(--font-mono); font-size: var(--type-caption); font-weight: 700;
    letter-spacing: 3px; text-transform: uppercase; color: var(--brand-gold);
    margin-bottom: var(--spacing-lg);
  }
  .cc-hero-title {
    font-size: clamp(var(--type-5xl), 5.2vw, var(--type-6xl));
    font-weight: 800; line-height: 1.04; letter-spacing: -2px;
    color: var(--brand-paper); margin-bottom: var(--spacing-lg);
  }
  .cc-gold { color: var(--brand-gold); }
  .cc-hero-sub {
    font-size: clamp(var(--type-base), 1.6vw, var(--type-lg));
    color: var(--text-secondary); line-height: 1.7; max-width: 560px;
    margin-bottom: var(--spacing-md);
  }
  .cc-hero-location { color: var(--text-muted); font-size: var(--type-caption); margin-top: var(--spacing-lg); }
  .cc-hero-mobile { display: none; }

  /* Slotted lead form — panel chrome (Command Center grammar).
     Markup, IDs and handlers are the page's own and stay untouched. */
  .cc-hero :global(.lux-form-wrap) {
    max-width: 560px; margin-top: var(--spacing-xl); text-align: left;
    background: linear-gradient(160deg, color-mix(in srgb, var(--brand-navy) 18%, var(--brand-surface-dark)), var(--brand-surface-dark));
    border: 1px solid color-mix(in srgb, var(--brand-navy) 70%, var(--brand-silver));
    border-radius: var(--radius-md); padding: var(--spacing-xl);
    box-shadow: var(--shadow);
  }
  .cc-hero :global(.lux-form-head) { text-align: center; margin-bottom: var(--spacing-lg); }
  .cc-hero :global(.lux-form-badge) {
    display: inline-block; font-family: var(--font-mono); font-size: 11px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase; color: var(--brand-gold);
    border: 1px solid color-mix(in srgb, var(--brand-gold) 35%, transparent);
    background: color-mix(in srgb, var(--brand-gold) 10%, transparent);
    border-radius: 100px; padding: var(--spacing-2xs) var(--spacing-sm); margin-bottom: 10px;
  }
  .cc-hero :global(.lux-form-title) { font-size: var(--type-2xl); font-weight: 800; letter-spacing: -0.5px; color: var(--brand-paper); }
  .cc-hero :global(.lux-form-sub) { color: var(--text-muted); font-size: var(--type-caption); margin-top: var(--spacing-2xs); }

  @media (max-width: 1024px) {
    .cc-hero-grid { grid-template-columns: 1fr; }
    .cc-hero-sub { max-width: 680px; }
  }
  @media (max-width: 768px) {
    .cc-hero { padding: calc(var(--nav-height) + var(--spacing-lg)) 0 var(--spacing-xl); }
    .cc-hero-title { font-size: var(--type-4xl); letter-spacing: -1px; }
    .cc-hero-mobile { display: block; margin-top: var(--spacing-lg); }
    .cc-hero :global(.lux-form-wrap) { padding: var(--spacing-lg); }
    .cc-hero :global(.lead-form input),
    .cc-hero :global(.lead-form select),
    .cc-hero :global(.lead-form textarea) { font-size: 16px; }
  }
</style>
