---
export interface Plan {
  name: string;
  price: string;
  href: string;
  active?: boolean;
}

export interface Props {
  plans: Plan[];
}

const { plans } = Astro.props;
---

<div class="compare-grid">
  {plans.map((p) => (
    <a href={p.href} class={`compare-link ${p.active ? 'active' : ''}`}>{p.name} {p.price}</a>
  ))}
</div>
