---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'CC3PO — AI Agents That Work Within Your Rules. HIPAA compliance scanning, automated IT, and voice agents with full human oversight.' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://cc3po.com/images/og-image.png" />
    <meta property="og:site_name" content="CC3PO" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cc3po.com/images/og-image.png" />
    <meta name="twitter:site" content="@cc3po" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "CC3PO LLC",
      "url": "https://cc3po.com",
      "logo": "https://cc3po.com/images/cc3po-crypto-enhanced.png",
      "description": "The AI Village That Runs Your Business — automated lead generation, HIPAA compliance, and AI-powered operations.",
      "foundingDate": "2024",
      "founder": {
        "@type": "Person",
        "name": "Carlos Cabrales III"
      },
      "sameAs": [],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "AI Business Solutions",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "HIPAA Health Scanner",
              "description": "Automated HIPAA compliance scanning for healthcare websites"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Callie Voice Agent",
              "description": "AI-powered voice agent for business phone operations"
            }
          }
        ]
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "CC3PO LLC",
      "url": "https://cc3po.com",
      "image": "https://cc3po.com/images/og-image.png",
      "description": "AI Agents That Work Within Your Rules. HIPAA compliance scanning, automated IT, and voice agents with full human oversight.",
      "address": {
        "@type": "PostalAddress",
        "addressRegion": "CA",
        "addressCountry": "US"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "serviceType": [
        "HIPAA Compliance Scanning",
        "AI Voice Agents",
        "Dental IT Services",
        "Automated Patch Management",
        "SMS Marketing",
        "Website Hosting"
      ],
      "priceRange": "$" 
    })} />
  </head>
  <body>
    <!-- Mobile Drawer Overlay -->
    <div class="mobile-drawer-overlay" id="drawer-overlay"></div>
    <!-- Mobile Drawer -->
    <div class="mobile-drawer" id="mobile-drawer">
      <nav class="mobile-drawer-nav">
        <a href="#how-it-works">How It Works</a>
        <a href="#products">Products</a>
        <a href="#proof">Proof</a>
        <a href="#founder">Founder</a>
      </nav>
      <a href="#cta" class="mobile-drawer-cta">Free HIPAA Scan</a>
    </div>
    <slot />
    <!-- Talk to Hermes Chat Widget Placeholder -->
    <div id="hermes-chat-widget" aria-label="Talk to Hermes AI Agent">
      <button id="hermes-chat-toggle" aria-label="Open chat with Hermes">
        <span class="chat-icon">⚡</span>
      </button>
      <div id="hermes-chat-panel" class="hidden" role="dialog" aria-label="Chat with Hermes">
        <div class="chat-header">
          <span>Hermes ⚡</span>
          <button id="hermes-chat-close" aria-label="Close chat">✕</button>
        </div>
        <div class="chat-body">
          <p>Hi! I'm Hermes, CC3PO's research agent. Ask me anything about our AI village.</p>
          <p class="chat-placeholder">Chat integration loading…</p>
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  #hermes-chat-widget {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
  }
  #hermes-chat-toggle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e94560, #0f3460);
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 24px rgba(233, 69, 96, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  #hermes-chat-toggle:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 32px rgba(233, 69, 96, 0.6);
  }
  .chat-icon {
    font-size: 28px;
    filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.6));
  }
  #hermes-chat-panel {
    position: absolute;
    bottom: 72px;
    right: 0;
    width: 360px;
    max-height: 480px;
    background: #16213e;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0,0,0,0.5);
    display: flex;
    flex-direction: column;
  }
  #hermes-chat-panel.hidden { display: none; }
  .chat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: #0f3460;
    color: #fff;
    font-weight: 600;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  #hermes-chat-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 18px;
    cursor: pointer;
  }
  .chat-body {
    padding: 20px;
    color: rgba(255,255,255,0.8);
    font-size: 14px;
    line-height: 1.6;
  }
  .chat-placeholder {
    color: rgba(255,255,255,0.4);
    font-style: italic;
    margin-top: 12px;
  }
  @media (max-width: 480px) {
    #hermes-chat-panel {
      width: calc(100vw - 48px);
      right: -12px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('hermes-chat-toggle');
  const panel = document.getElementById('hermes-chat-panel');
  const close = document.getElementById('hermes-chat-close');
  if (toggle && panel && close) {
    toggle.addEventListener('click', () => panel.classList.toggle('hidden'));
    close.addEventListener('click', () => panel.classList.add('hidden'));
  }
</script>