---
export interface Props {
  title: string;
  description?: string;
}

import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';

const { title, description = 'CC3PO — AI Agents That Work Within Your Rules. HIPAA compliance scanning, automated IT, and voice agents with full human oversight.' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <!-- Analytics (Privacy-friendly, self-hosted Plausible) -->
    <script async src="https://analytics.cc3po.com/js/pa-L75wLLqFAXpJaokSPBmj6.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://cc3po.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="CC3PO" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cc3po.com/og-image.png" />
    <meta name="twitter:site" content="@IiiCabrales" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "CC3PO LLC",
      "url": "https://cc3po.com",
      "logo": "https://cc3po.com/images/cc3po-crypto-enhanced.png",
      "description": "The AI Village That Runs Your Business — automated lead generation, HIPAA compliance, and AI-powered operations.",
      "foundingDate": "2024",
      "founder": {
        "@type": "Person",
        "name": "Carlos Cabrales III"
      },
      "sameAs": ["https://linkedin.com/company/cc3potechnology","https://x.com/IiiCabrales","https://instagram.com/carloscbrls","https://www.facebook.com/profile.php?id=61569885474429","https://www.tiktok.com/@carlos.a.k.ac3","https://www.youtube.com/@carloscbrls"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "AI Business Solutions",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "HIPAA Health Scanner",
              "description": "Automated HIPAA compliance scanning for healthcare websites"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Callie Voice Agent",
              "description": "AI-powered voice agent for business phone operations"
            }
          }
        ]
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "CC3PO LLC",
      "url": "https://cc3po.com",
      "image": "https://cc3po.com/images/og-image.png",
      "description": "AI Agents That Work Within Your Rules. HIPAA compliance scanning, automated IT, and voice agents with full human oversight.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lathrop",
        "addressRegion": "CA",
        "postalCode": "95330",
        "addressCountry": "US"
      },
      "telephone": "+1-209-423-6633",
      "areaServed": [
        {"@type": "State", "name": "California"},
        {"@type": "AdministrativeArea", "name": "San Joaquin County"}
      ],

      "serviceType": [
        "HIPAA Compliance Scanning",
        "AI Voice Agents",
        "Dental IT Services",
        "Automated Patch Management",
        "SMS Marketing",
        "Website Hosting"
      ],
      "priceRange": "$" 
    })} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <!-- Mobile Drawer Overlay -->
    <div class="mobile-drawer-overlay" id="drawer-overlay"></div>
    <!-- Mobile Drawer -->
    <div class="mobile-drawer" id="mobile-drawer">
      <nav class="mobile-drawer-nav">
        <a href="/morning-report/">Morning Report</a>
        <a href="/how-it-works/">How It Works</a>
        <a href="/about/">About</a>
        <a href="/village/">Your Team</a>
        <a href="/contact">Contact</a>
      </nav>
      <a href="https://audit.cc3po.com" class="mobile-drawer-cta">Free Business Scan</a>
    </div>
    <SiteNav />
    <main id="main-content">
    <slot />
    </main>
    <SiteFooter />
    <script>
      // Mobile drawer toggle (works on both initial load and Astro view transitions)
      function initMobileDrawer() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const drawer = document.getElementById('mobile-drawer');
        const overlay = document.getElementById('drawer-overlay');

        if (!menuBtn || !drawer || !overlay) return;

        // Remove existing listener to prevent duplicates on view transitions
        const newBtn = menuBtn.cloneNode(true);
        menuBtn.parentNode.replaceChild(newBtn, menuBtn);

        function openDrawer() {
          drawer.classList.add('active');
          overlay.style.display = 'block';
          requestAnimationFrame(() => { overlay.classList.add('active'); });
          newBtn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          drawer.classList.remove('active');
          overlay.classList.remove('active');
          newBtn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          setTimeout(() => { overlay.style.display = 'none'; }, 300);
        }

        newBtn.addEventListener('click', () => {
          if (drawer.classList.contains('active')) closeDrawer();
          else openDrawer();
        });
        overlay.addEventListener('click', closeDrawer);
        drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));
      }

      // Run on initial page load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMobileDrawer);
      } else {
        initMobileDrawer();
      }
      // Also run on Astro view transitions
      document.addEventListener('astro:page-load', initMobileDrawer);
    </script>
  </body>
</html>